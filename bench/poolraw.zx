// poolraw.zx —— pool.zx 的对照组：同样的环形分配，直接 malloc/free
// （std.heap.page）。裸 malloc 的 free 需要尺寸，所以多一条尺寸环。
const std = @mod("std");

// 环形分配刻意向后延迟 RING 个迭代才 free（tag 账本按「同迭代进出」
// 建模，跨迭代持有必然报 E0516）。这是裸分配器的对照基准，手动管理
// 内存是它的本意——按模块关账本。
tag.close;

const RING: usize = 1024;

const main = fn () u8 {
    let g = std.heap.page;
    var ring = std.stackAlloc(?*u8, RING);
    var sizes = std.stackAlloc(usize, RING);
    var sink: u64 = 0;
    var r: usize = 0;
    var i: usize = 0;
    while (i < 10000000) {
        if (i >= RING) {
            let old = ring[0][r];
            if (old) ob {
                g.free(g.ctx, ob, sizes[0][r]);
            } else { return 1; }
        }
        var size: usize = 16;
        let m = i & 3;
        if (m == 1) { size = 64; } else if (m == 2) { size = 96; } else if (m == 3) { size = 192; }
        let b = g.alloc(g.ctx, size);
        if (b) bv {
            bv.0 = 7;
            sink = sink + (u64)(i64)bv.0;
        } else { return 1; }
        ring[0][r] = b;
        sizes[0][r] = size;
        r = (r + 1) & (RING - 1);
        i = i + 1;
    }
    std.println("raw sink={}", sink);
    return 0;
};
