// bench/mmat.zx —— 内存带宽 + f64 三重循环（矩阵乘 256x256，跑 3 遍）。
// 校验和 = 结果矩阵的 4 个采样点，用来跨后端/跨优化等级比对正确性。
const std = @mod("std");

const N: usize = 256;
const R: usize = 3;

const main = fn () u8 {
    let al = std.heap.page;
    var a = std.heapAlloc(al, f64, N * N);
    var b = std.heapAlloc(al, f64, N * N);
    var c = std.heapAlloc(al, f64, N * N);
    let as = a[0..];
    let bs = b[0..];
    let cs = c[0..];

    for (0..N * N) k {
        as[k] = (f64)(i64)(i32)(k % 7) + 1.0;
        bs[k] = (f64)(i64)(i32)((k * 5) % 11) + 1.0;
    }

    for (0..R) rep {
        for (0..N) i {
            for (0..N) j {
                var s: f64 = 0.0;
                for (0..N) k {
                    s = s + as[i * N + k] * bs[k * N + j];
                }
                cs[i * N + j] = s;
            }
        }
    }

    std.println("mmat c00={} cN1={} cN2={} cNN={}",
                cs[0], cs[N + 1], cs[(N / 2) * N + N / 2], cs[N * N - 1]);
    // 三块缓冲释放（as/bs/cs 只是视图，账都记在同一槽上）
    al.free(al.ctx, (*u8)a, N * N * 8);
    al.free(al.ctx, (*u8)b, N * N * 8);
    al.free(al.ctx, (*u8)c, N * N * 8);
    return 0;
};
