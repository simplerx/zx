// bench/mandel.zx —— 浮点内层循环（f64 乘加、分支预测）。
// 1200x800 网格，逃逸迭代上限 255。校验和 = 全部迭代次数之和。
const std = module("std");

const W: usize = 1200;
const H: usize = 800;

const main = fn () u8 {
    var sum: u64 = 0;
    for (0..H) py {
        let y0 = (f64)(i64)(i32)py / 400.0 - 1.0;
        for (0..W) px {
            let x0 = (f64)(i64)(i32)px / 600.0 - 2.0;
            var zr: f64 = 0.0;
            var zi: f64 = 0.0;
            var n: i32 = 0;
            while (n < 255 && zr * zr + zi * zi <= 4.0) {
                let t = zr * zr - zi * zi + x0;
                zi = 2.0 * zr * zi + y0;
                zr = t;
                n = n + 1;
            }
            sum = sum + (u64)(i64)n;
        }
    }
    std.println("mandel sum={}", sum);
    return 0;
};
