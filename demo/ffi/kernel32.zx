// kernel32.zx —— Win32 绑定模块的最小骨架。
//
// C 库调用的推荐组织方式：**一个绑定模块管一个库**。
// 外部类型（extern struct）、外部函数（extern fn）、外部变量（extern var）
// 和链接指令（@link）都收在这里，应用代码只 import，不见任何 C 细节。
// 没有 bindgen 也能手写——布局由 sema 校验，写错字段类型直接编译失败。

@link("kernel32");

// ---- 类型：逐字段镜像 winbase.h ----

const SystemTime = extern struct {
    wYear: u16, wMonth: u16, wDayOfWeek: u16, wDay: u16,
    wHour: u16, wMinute: u16, wSecond: u16, wMilliseconds: u16,
};

const FileTime = extern struct {
    dwLowDateTime: u32,
    dwHighDateTime: u32,
};

// ---- 函数：签名即 ABI 契约 ----

extern fn GetLocalTime(st: *SystemTime) void;
extern fn SystemTimeToFileTime(st: *const SystemTime, ft: *FileTime) i32;
extern fn GetTickCount64() u64;

// ---- 给应用侧的友好封装（绑定模块也可以带逻辑）----

const now = fn (st: *SystemTime) void {
    GetLocalTime(st);
};

const main = fn () u8 {
    var st: SystemTime = undefined;
    now(&st);

    var ft: FileTime = undefined;
    if (SystemTimeToFileTime(&st, &ft) == 0) { return 1; }

    std.println("{}-{}-{} {}:{}:{}",
                st.wYear, st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond);
    std.println("ticks={}", GetTickCount64());
    return 0;
};

const std = module("std");
