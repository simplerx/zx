# 构建产物
bin/
*.o
*.exe
*.pdb
*.tmp

# 工具链（zig cc，不入库）
.toolchain/
.toolchain-015-bak/

# 语言服务器日志（zxls 写在 exe 同目录）
zxls-lsp.log

# 本地缓存与临时目录
.tmp/
.zc-cache/
out/

# Zed 扩展的 cargo 产物（wasm 本身入库，target 不入库）
editor/zed/target/

# 用例自己产生的临时文件（正常跑完会被 test.sh 清掉，这里是兜底）
io_fmt.tmp
fs_t_dir*/

# 一次性探测文件
err_probe.zx

# zxls 影子文件（诊断用临时副本，异常退出时可能残留）
.zxls-*.zx

# Python 工具脚本缓存
__pycache__/
*.pyc

# 本地 AI 工作区记忆（不入库）
.workbuddy/

# 纯文档与本地工作区配置（不入库，本地保留）
docs/
spec/
.zed/
