tag.enable;
// expect: use after free
// expect-code: E0512
// §173：跨函数合法（形参借出、所有权留在调用方槽上），但释放后使用仍然拦截。
const std = @mod("std");
const take = fn (_p: *i32) void {
    _ = _p;
};
const main = fn () u8 {
    var p = tag.buf : std.heapAlloc(std.heap.page, i32, 4);
    take(p);
    std.heap.page.free(std.heap.page.ctx, (*u8)p, 16);
    return (u8)p[0];
};
