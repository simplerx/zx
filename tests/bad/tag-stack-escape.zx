tag.enable;
// expect: cannot return a pointer into the current function's stack frame
// expect-code: E0503
// expect-count: 2
// §173/§188：stackAlloc 指针逃逸出函数体（返回值）——栈指针携带栈标签，
// 返回逃逸检查（tag 驱动）在 return 处直接拦：栈存储随帧消亡，不能流出。
const std = @mod("std");

const alloc = fn () *u8 {
    let p = (*u8)std.stackAlloc(i32, 10);
    return p;
};

const main = fn () void {
    let p = alloc();
    std.heap.page.free(std.heap.page.ctx, (*u8)p, 10);
};
