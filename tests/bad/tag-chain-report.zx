tag.enable;
// expect: is never freed
// expect: called via main
// expect-code: E0513
// \xc2\xa7176\xef\xbc\x9a\xe6\xb3\x84\xe6\xbc\x8f\xe8\xaf\x8a\xe6\x96\xad\xe5\xb8\xa6\xe8\xb0\x83\xe7\x94\xa8\xe9\x93\xbe\xef\xbc\x88\xe4\xb8\x80\xe7\x9b\xb4\xe5\x9b\x9e\xe6\xba\xaf\xe5\x88\xb0 main\xef\xbc\x89\xef\xbc\x9b
// \xe5\x85\x8b\xe9\x9a\x86\xe4\xbd\x93\xe5\xa4\x8d\xe6\xa3\x80\xe5\xb9\x82\xe7\xad\x89\xe2\x80\x94\xe2\x80\x94\xe5\x90\x8c\xe4\xb8\x80\xe6\xb3\x84\xe6\xbc\x8f\xe5\x8f\xaa\xe6\x8a\xa5\xe4\xb8\x80\xe6\x9d\xa1\xef\xbc\x8c\xe4\xb8\x8d\xe9\x87\x8d\xe5\xa4\x8d\xe5\x85\x8b\xe9\x9a\x86\xe5\xae\x9e\xe4\xbe\x8b\xe6\xa7\xbd\xe3\x80\x82
const std = @mod("std");
const load = fn () *i32 {
    return std.heapAlloc(std.heap.page, i32, 4);
};
const run = fn () void {
    let p = load();
    _ = p;
};
pub const main = fn () i32 {
    run();
    return 0;
};
