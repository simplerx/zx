tag.enable;
// expect: owned by an arena
// expect-code: E0526
// §187：adopt 后手动 free——编译期记释放事件，撞账报 E0526。
const std = @mod("std");
const main = fn () u8 {
    var ar = std.arena.ArenaAllocator.init(std.heap.page);
    if (ar) a {
        let p = std.heapAlloc(std.heap.page, u8, 10).?;
        std.arena.ArenaAllocator.adopt(a, p, 10);
        std.heap.page.free(std.heap.page.ctx, p, 10);
        std.arena.ArenaAllocator.deinit(a);
        return 0;
    }
    return 5;
};
