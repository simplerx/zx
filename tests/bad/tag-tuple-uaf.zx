tag.enable;
// expect: use after free
// expect-code: E0512
// expect-count: 1
// §175：tup.1 = alloc() 后 free(tup.1.child.name) 再解引用——
// 元素赋值重绑的账正常生效，E0512 照常报。
const std = @mod("std");
pub const P2 = struct { name: *u8 };
pub const allocp = fn () *u8 {
    return (*u8)std.heapAlloc(std.heap.page, u8, 10).?;
};
pub const main = fn () i32 {
    var tup = { P2{ .name = (*u8)"a" }, P2{ .name = (*u8)"b" } };
    tup.1.name = allocp();
    std.heap.page.free(std.heap.page.ctx, tup.1.name, 10);
    tup.1.name[0] = 1;
    return 0;
};
