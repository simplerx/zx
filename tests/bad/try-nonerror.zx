// `try` 传播错误（v0.26：`?T` 也行，空抛 error.null）。普通值没有"空/错"
// 可言——`try` 一个 i32 是类型错误；就地处理用普通绑定，别 `try`。
// expect: `try` needs an error union or an optional, found `i32`
// expect-code: E0301
// expect-count: 1
const plain = fn () i32 { return 1; };

const f = fn () !i32 {
    return try plain();
};

const main = fn () i32 {
    return 0;
};
