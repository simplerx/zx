// `try` 只传播错误。`?T` 的"空"不是错误——它没有错误码可以往上带，
// 想给默认值用 `orelse`，想分支用 `if` 捕获。
// expect: `try` needs an error union, found `?i32`
// expect-code: E0301
// expect-count: 1
const maybe = fn () ?i32 { return 1; };

const f = fn () !i32 {
    return try maybe();
};

const main = fn () i32 {
    return 0;
};
