// expect: `while` with an `else` arm needs a `?T` or `!T` condition
// §239：while 的 else 是「条件失败出口」，只认 ?T / !T 条件；bool 条件
// 没有失败载荷，写了 else 是死代码，报 E0405 类诊断。与 for-else 不同——
// for 无条件收 else（那条仍由 for-else.zx 守）。
const std = @mod("std");
const main = fn () u8 {
    var n: u32 = 0;
    while (n < 3) { n = n + 1; } else { n = n + 100; }
    std.println("{}", n);
    return 0;
};
