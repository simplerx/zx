tag.enable;
// expect: manual tag declaration is gone
// expect-code: E0519
// §172：普通声明已自动化，裸 `tag.buf;` 报 E0519（只有 .static 仍需手动声明）。
const std = @mod("std");
tag.buf;
const main = fn () u8 {
    var p = tag.buf : std.heapAlloc(std.heap.page, i32, 4);
    std.heap.page.free(std.heap.page.ctx, (*u8)p, 16);
    return 0;
};
