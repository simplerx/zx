// expect: was stored into `xs[i]` with a runtime index
// expect-code: E0521
// expect-count: 2
// §174：运行期索引混存多个贴标指针——两个槽都断线进 pending，没
// 续链/没终结则终扫逐槽报 E0521（标签绝不静默丢失）。续链写法见
// good/tag-rebind-chain。
const std = @mod("std");
pub const main = fn () i32 {
    var xs = std.stackAlloc(*u8, 4);
    let p = (*u8)std.heapAlloc(std.heap.page, u8, 10);
    let q = (*u8)std.heapAlloc(std.heap.page, u8, 10);
    let i = 0;
    let j = 1;
    xs[i] = p;
    xs[j] = q;
    return 0;
};
