// §134：编译期状态机确定句柄已失效时，`.?` 强制解包必然 trap。
// 这是「确定失效 + 确定性解引用」，不是 side table 的合法性查询，
// 所以报硬错 E0510；检查性使用（if 捕获 / == null）由另一条 good 用例守。
// expect: forced-unwrap on an invalid handle
// expect-code: E0510
// expect-count: 1
const std = module("std");

const Point = struct { x: i32 };
const Table = std.slot.SlotTable(Point, 4);

pub const main = fn () u8 {
    const al = std.heap.page;
    var t = Table.init(al).?;
    let h = t.create().?;              // 直线发行：provenance 完整、未 tainted
    std.println("free {}", t.free(h));  // 直线作废：slot -> RS_FREED
    let p = t.get(h).?;                // E0510：已失效还强制认为非空
    std.println("{}", p.x);
    return 0;
};
