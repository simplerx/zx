tag.enable;
// expect: release in a branch arm must be confirmed
// expect-code: E0528
// expect-count: 1
// §189：分支内 free 必须紧跟 `tag p : null;` 显式确认——没确认的释放
// 合流后当作还没释放（分支本就可能不走），在释放处报 E0528 提示确认。
const std = @mod("std");
var drop: bool = false;

const main = fn () u8 {
    var p = tag.buf : std.heapAlloc(std.heap.page, i32, 4);
    p[0][0] = 9;
    let r = ok: if (drop) {
        std.heap.page.free(std.heap.page.ctx, (*u8)p, 16);
        ok: p;              // free 后传出非空载体：违反"free 臂传 null"约定
    } else {
        ok: p;
    };
    std.println("v={d}", r[0][0]);   // 链式诊断：E0512
    return 0;
};
