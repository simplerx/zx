// expect: cannot be tracked to its free site
// expect-code: E0513
// expect-count: 2
// §173 补丁六：贴标指针存进数组元素，一个数组混多个 tag 无法指认
// 元素——追踪断线，终扫 E0513 指到存入处，提示手动
// `tag.allocN : null;` 回到正常流程。
const std = @mod("std");
pub const main = fn () i32 {
    var xs = std.stackAlloc(*u8, 4);
    let p = (*u8)std.heapAlloc(std.heap.page, u8, 10);
    let q = (*u8)std.heapAlloc(std.heap.page, u8, 10);
    xs[0] = p;
    xs[1] = q;
    std.heap.page.free(std.heap.page.ctx, xs[0], 10);
    return 0;
};
