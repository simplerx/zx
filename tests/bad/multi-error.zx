// expect: has no field 'nope'
// expect-code: E0304 E0403 E0301
// expect-count: 3
//
// 三条互相独立的错必须一次全报出来：成员不存在、给 let 赋值、类型不匹配。
// 早期版本在第一条就停（BAD 直接返回），用户一轮只能修一个。
const P = struct { x: i32 };

fn main() void {
    let p = P{ .x = 1 };
    let a: i32 = p.nope;
    let b: i32 = 1;
    b = 2;
    let c: i32 = "not an int";
}
