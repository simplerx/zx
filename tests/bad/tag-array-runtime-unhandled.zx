tag.enable;
// expect: never freed
// expect-code: E0513
// expect-count: 1
// §185（用户裁定）：运行期索引进数组 = 槽进该数组的标签群（存入即
// 登记，不再 rt_pending 断线拦截）。没注解读取取出、没整容器终结 →
// 槽级泄漏终扫 E0513（群里留着 = 未释放）。注解取出/free(xs) 批量
// 终结的写法见 good/tag-rebind-chain 与新增 tag-arr 用例。
const std = @mod("std");
const mk = fn () *u8 {
    return (*u8)std.heapAlloc(std.heap.page, u8, 10);
};
pub const main = fn () i32 {
    var xs = std.stackAlloc(*u8, 4);
    let i = 1;
    xs[0][i] = mk();
    return 0;
};
