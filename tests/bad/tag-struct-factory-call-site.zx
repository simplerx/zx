// \xe6\xb3\x84\xe6\xbc\x8f\xe6\x8a\xa5\xe5\x9c\xa8\xe8\xb0\x83\xe7\x94\xa8\xe8\xa1\x8c\xef\xbc\x88tup.1 = alloc()\xef\xbc\x89\xef\xbc\x8cnote \xe6\x8c\x87\xe5\x88\x86\xe9\x85\x8d\xe8\xa1\x8c\xef\xbc\x9b\xe6\xaf\x8d\xe6\xa7\xbd\xe7\x94\xb1\xe5\xae\x9e\xe4\xbe\x8b\xe6\x8e\xa5\xe7\xae\xa1\xe3\x80\x82
const std = @mod("std");

const Child = struct {
    pub name: *u8,
};

const Person = struct {
    pub age: *u8,
    pub child: Child,
};

pub const alloc = fn () Person {
    let p = std.heapAlloc(std.heap.page, i32, 10);
    return .{.age = (*u8)p, .child = .{.name = (*u8)"eoo"}};
};

pub const main = fn () !i32 {
    var tup = {
        Person{.age = (*u8)"eo", .child = .{.name = (*u8)"eow"}},
        Person{.age = (*u8)"eo", .child = .{.name = (*u8)"eow"}},
    };
    tup.1 = alloc();
    return 0;
};
