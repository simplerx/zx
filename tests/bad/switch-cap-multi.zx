// 捕获只允许单模式臂：`.a, .b: v {}` 类型对不上
const std = @mod("std");

const Shape = union(enum) {
    circle: f64,
    rect:   { f64, f64 },
};

const f = fn (s: Shape) f64 {
    switch (s) {
        .circle, .rect: v { return 0.0; };
    }
};

const main = fn () u8 {
    return 0;
};

