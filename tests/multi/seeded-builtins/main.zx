// main.zx —— §157 裸名内建调用（限定名/裸名同分派 + 同名用户函数不被劫持）
const std = @mod("std");
const h = @mod("helper.zx");
const s = @mod("shadow.zx");

pub const main = fn () u8 {
    h.probe();
    std.println("shadow={}", s.probe());
    return 0;
};

