// §225：本模块写 tag.enable 才开账——验证 arena 的 init/deinit 容器账配对
// （arena 自身 batch 豁免、经它分配的块不建独立槽，资源账由容器统一清算）。
tag.enable;
const std = @mod("std");
const main = fn () u8 {
    var ar = std.arena.ArenaAllocator.init(std.heap.page);
    if (ar) a {
        let m = a.alloc(a.ctx, 64);
        if (m) mm {
            let p = (*u8)mm;
            p[0] = 7;
        }
        std.arena.ArenaAllocator.deinit(a);
        return 0;
    }
    return 5;
};
