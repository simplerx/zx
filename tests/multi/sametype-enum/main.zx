// §198：类型身份 = 声明身份，不看名字。`const E = m.E` 是别名，与 lib 的 E
// 是同一个 enum，可互相传值。各自声明的同名 enum 是两个不同类型。
const std = @mod("std");
const m = @mod("lib.zx");

const E = m.E;   // 别名 = 同一个类型

const main = fn () u8 {
    let mine: E = E.B;
    if (!m.isB(mine)) { return 1; }
    if (!m.isB(m.E.B)) { return 2; }
    std.println("enum ok");
    return 0;
};

// expect-output
// enum ok
