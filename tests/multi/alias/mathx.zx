// mathx.zx —— 被别的模块引用的普通模块（`pub` 决定哪些名字能出去）
pub const square = fn (n: i32) i32 { return n * n; };
pub const cube = fn (n: i32) i32 { return n * n * n; };
pub const GOLDEN: f64 = 1.618;
pub const Vec2 = struct { x: i32, y: i32 };
pub const dot = fn (a: Vec2, b: Vec2) i32 { return a.x * b.x + a.y * b.y; };

const helper = fn (n: i32) i32 { return n * 10; };     // 私有：外面看不见
