// alloc.zx —— 统一分配 API（decisions §44）：申请的都是数组，返回的都是数组指针
// std.stackAlloc(T, N) 栈帧存储，N 编译期已知；
// std.heapAlloc(alloc, T, N) 走分配器，OOM 直接 abort；
// `var x: *[N]T = undefined` 不再分配存储，只是指针槽不初始化。
const std = @mod("std");

const total = fn (p: *[4]u64) u64 {
    var s: u64 = 0;
    for (0..4) i { s = s + p[0][i]; }
    return s;
};

const main = fn () u8 {
    // ① 栈分配：和普通局部数组一样用
    var sa = std.stackAlloc(u64, 4);
    for (0..4) i { sa[0][i] = i + 1; }
    std.println("stack {d} len={d}", total(sa), sa[0].len);

    // ② 堆分配：显式传分配器
    var ha = std.heapAlloc(std.heap.page, u64, 4);
    for (0..4) i { ha[0][i] = (i + 1) * 10; }
    std.println("heap {d} len={d}", total(ha), ha[0].len);

    // ③ undefined：不分配，指针本身清零；.len 还是编译期常量
    var raw: *[4]u64 = undefined;
    std.println("raw len={d} size={d}", raw[0].len, raw[0].size);

    // ④ 同一块存储可以经局部变量中转（只是不许 return 出去）
    var p: *[4]u64 = ha;
    p = sa;
    std.println("relay {d}", p[0][2]);

    // ⑤ 逃逸检查放行的形态：返回形参所指物里的字段
    var box = Box{ .v = 42 };
    std.println("pick {d}", pick(&box).0);

    return 0;
};

const Box = struct { v: u64 };

const pick = fn (b: *Box) *u64 {
    return &b.v;        // 被指物不在当前栈帧：放行
};

// expect-output
// stack 10 len=4
// heap 100 len=4
// raw len=4 size=32
// relay 3
// pick 42
