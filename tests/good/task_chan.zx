// task_chan.zx —— 命名通道：句柄化，载荷统一 usize。
//   · 多条通道各自独立（故意乱序收发，验证不串味）
//   · 载荷靠 (usize)v / (T)bits 往返：usize、i32 负数、指针都保真
//   · chanTrySend/chanTryRecv 无对手给 would_block；close 封口后给 closed
//   · 命名通道与实例自带默认通道互不影响
// 大类型（[]T 是 16 字节、结构体）cast 不到 usize，编译器直接 E0300。
// expect-output:try:would_block
// expect-output:try-send:would_block
// expect-output:chan:22 11 -7 99
// expect-output:consumer:22
// expect-output:producer:0
// expect-output:after-close:closed
// expect-output:default:would_block
const std = module("std");
const Task = std.task.Task;

var g_a: usize = 0;
var g_b: usize = 0;
var g_i: usize = 0;
var g_p: usize = 0;
var g_t: usize = 0;
var g_slot: usize = 99;

// consumer 先入队、先停靠；producer 按同样顺序发，rendezvous 一一配对。
const consumer = fn (_: usize) !usize {
    let t = Task.fromId(g_t);
    let x = try t.chanRecv(g_b);
    let y = try t.chanRecv(g_a);
    let z = (i32)(try t.chanRecv(g_i));
    let q = (*usize)(try t.chanRecv(g_p));
    std.println("chan:{} {} {} {}", x, y, z, q.0);
    return x;
};

const producer = fn (_: usize) !usize {
    let t = Task.fromId(g_t);
    try t.chanSend(g_b, 22);
    try t.chanSend(g_a, 11);
    try t.chanSend(g_i, (usize)((i32)(-7)));
    try t.chanSend(g_p, (usize)&g_slot);
    return 0;
};

const main = fn () !i32 {
    let t = Task.coro();
    defer t.close();
    g_t = t.id;
    let a = t.chan();
    let b = t.chan();
    let i = t.chan();
    let p = t.chan();
    defer t.chanClose(p);
    defer t.chanClose(i);
    defer t.chanClose(b);
    defer t.chanClose(a);
    g_a = a; g_b = b; g_i = i; g_p = p;

    if (t.chanTryRecv(a)) v { std.println("unexpected:{}", v); } else e {
        std.println("try:{}", std.debug.errName(e));
    }
    if (t.chanTrySend(a, 1)) { std.println("unexpected-send"); } else e {
        std.println("try-send:{}", std.debug.errName(e));
    }

    let hc = t.spawn(consumer, 0).?;
    let hp = t.spawn(producer, 0).?;
    try t.awaitAll();
    if (t.await(hc)) v { std.println("consumer:{}", v); } else e { return e; }
    if (t.await(hp)) v { std.println("producer:{}", v); } else e { return e; }

    t.chanClose(a);
    if (t.chanTrySend(a, 5)) { std.println("unexpected-after-close"); } else e {
        std.println("after-close:{}", std.debug.errName(e));
    }
    if (t.tryRecv()) v { std.println("unexpected-default:{}", v); } else e {
        std.println("default:{}", std.debug.errName(e));
    }
    return 0;
};
