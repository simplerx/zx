// task_modes.zx —— 三种物理形态：coro（不建线程）/ single（1 条专属线程）/
// pool(n)（n 条工作线程）。实例各自隔离，awaitAll 只等自己名下的任务。
// expect-output:coro:50
// expect-output:single:11
// expect-output:pool:140
const std = module("std");
const Task = std.task.Task;

var hits: usize = 0;
const work = fn (x: usize) !usize {
    var i: usize = 0;
    while (i < 10) { _ = std.atomic.atomicAdd(&hits, 1); i = i + 1; }
    return x + 1;
};

const main = fn () !i32 {
    let co = Task.coro();
    var i: usize = 0;
    while (i < 5) { _ = co.spawn(work, i).?; i = i + 1; }
    try co.awaitAll();
    std.println("coro:{}", hits);
    co.close();

    let st = Task.single();
    let h1 = st.spawn(work, 10).?;
    let r1 = try st.await(h1);
    std.println("single:{}", r1);
    st.close();

    let pl = Task.pool(4);
    var j: usize = 0;
    while (j < 8) { _ = pl.spawn(work, j).?; j = j + 1; }
    try pl.awaitAll();
    std.println("pool:{}", hits);
    pl.close();
    return 0;
};
