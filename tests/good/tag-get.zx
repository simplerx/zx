// §178：@tag(p) 取指针携带的标签——进数组等会断链的地方前先取出来存住，
// 之后 tag v : keep = xs[k] 把链续上；不取标签就断链的仍报 E0521。
const std = @mod("std");

const main = fn () !i32 {
    var p = tag.h : std.heapAlloc(std.heap.page, i32, 10);
    p[0][0] = 42;

    var xs = std.heapSlice(std.heap.page, *[10]i32, 8);
    xs[0] = null;

    var k: u64 = 1;
    const keep = @tag(p);
    xs[k] = p;

    tag q : keep = xs[k];
    if (q[0][0] != 42) { return 1; }
    std.heap.page.deinit(q);
    std.heap.page.deinit(xs);
    return 0;
};
