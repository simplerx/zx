// M19：数值语义的基线。整型是按位宽回绕的（不是 UB），
// 移位量按位宽掩码，浮点是 IEEE（除零给 inf），除零在运行时 trap。
//
// expect-output
// i128 max/min: 170141183460469231731687303715884105727 -170141183460469231731687303715884105728
// u128 max/dec: 340282366920938463463374607431768211455 340282366920938463463374607431768211454
// i128 arith: 8 5000000000000
// wrap i8/u8: -128 0
// wrap i32/u64: -2147483648 0
// comptime wrap: -56
// shift mask: 2 0
// f16/f32/f64: 1.5 3.4028235e+38 0.5
// ieee: inf -inf
// MIN/-1: -128 0
// neg shift: -2147483648 -4
// div trunc: -3 -1
// f2i bounds: 3 -3 -128 2147483647 4294967295 -9223372036854775808

const std = module("std");

const main = fn () void {
    // 128 位极值：字面量、打印、取负
    std.println("i128 max/min: {} {}", 170141183460469231731687303715884105727,
               -170141183460469231731687303715884105728);

    let u: u128 = 340282366920938463463374607431768211455;
    std.println("u128 max/dec: {} {}", u, u - 1);

    // 128 位算术
    let a: i128 = 5;
    std.println("i128 arith: {} {}", a + 3, a * 1000000000000);

    // 有符号/无符号回绕：按目标位宽，不是 UB
    let w: i8 = 127;
    let w2: i8 = w + 1;
    let v: u8 = 255;
    let v2: u8 = v + 1;
    std.println("wrap i8/u8: {} {}", w2, v2);

    let i: i32 = 2147483647;
    let i2: i32 = i + 1;
    let m: u64 = 18446744073709551615;
    let m2: u64 = m + 1;
    std.println("wrap i32/u64: {} {}", i2, m2);

    // 编译期折叠与运行时同宽：i8 的 100 * 2 是 -56，不是 200
    let cx: i8 = 100 * 2;
    std.println("comptime wrap: {}", cx);

    // 移位量按位宽掩码（u32：33 & 31 = 1）
    let s: u32 = 33;
    let one: u32 = 1;
    std.println("shift mask: {} {}", one << s, one >> s);

    // 浮点：f16 → f32 精确，f32 最大值，f64 基本算术
    let h: f16 = 1.5;
    let f: f32 = 3.4028235e38;
    let d: f64 = 0.25;
    std.println("f16/f32/f64: {} {} {}", (f32)h, f, d * 2.0);

    // IEEE：浮点除零不是错，给 inf
    var z: f64 = 0.0;
    var p: f64 = 1.0;
    var n: f64 = -1.0;
    std.println("ieee: {} {}", p / z, n / z);

    // iN 的 MIN / -1 回绕成 MIN，不 trap（R10 表格里的特例）
    var m8: i8 = -128;
    std.println("MIN/-1: {} {}", m8 / -1, m8 % -1);

    // 移位量是负数：先按位宽掩码（i32：-1 & 31 = 31 → 1<<31 回绕成 MIN）；
    // 有符号右移按符号位填
    var one32: i32 = 1;
    var neg32: i32 = -1;
    var neg8: i8 = -8;
    std.println("neg shift: {} {}", one32 << neg32, neg8 >> 1);

    // 除法向零截断（不是向下取整）
    std.println("div trunc: {} {}", -7 / 2, -7 % 2);

    // 浮点 → 整数：范围内向零截断；边界值都精确落位
    // （编译期可见的越界在编译期报 E0302，运行时越界 trap——见 tests/bad/float-cast-fit）
    var d2: f64 = 3.7;
    var d3: f64 = -3.7;
    var d4: f64 = -128.0;
    var d5: f64 = 2147483647.0;
    var d6: f64 = 4294967295.0;
    var d7: f64 = -9223372036854775808.0;
    std.println("f2i bounds: {} {} {} {} {} {}", (i32)d2, (i32)d3, (i8)d4,
               (i32)d5, (u32)d6, (i64)d7);
};
