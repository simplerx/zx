// tup[N] 编译期索引：字面量、const 绑定、inline for 循环变量都行；
// 遍历配 inline for（循环变量是编译期绑定）。
const std = @mod("std");
const main = fn () u8 {
    const t = {10, 20, 30};
    const K = 2;
    std.println("{}", t[0]);
    std.println("{}", t[K]);
    var sum: u32 = 0;
    inline for (0..3) i { sum = sum + (u32)t[i]; }
    std.println("{}", sum);
    var w = {1, 2};
    w.0 = 5;
    w[1] = 6;                       // ct 索引也能当赋值目标（与 .N 同一链路）
    std.println("{}", w.0 + w.1);
    return 0;
};
