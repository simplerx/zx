// task_cancel.zx —— 取消复用 !T 传播链：cancel 后任务在下一个 await 门
// 收到 error.cancelled，冒到任务顶层，await 它的人收到同一个错误。
// expect-output:caught:cancelled
// expect-output:after await:done
const std = module("std");
const Task = std.task.Task;

const step = fn (n: usize) !i32 {
    if (n > 100) { return error.overflow; }
    return 0;
};

const worker = fn (_: usize) !usize {
    var i: usize = 0;
    while (i < 1000) {
        if (step(i)) v { i = i + 1; } else e { return e; }
    }
    return 0;
};

const main = fn () !i32 {
    let co = Task.coro();
    let f = co.spawn(worker, co.id).?;
    co.cancel(f);
    if (co.await(f)) v {
        std.println("unexpected:{}", v);
    } else e {
        std.println("caught:{}", std.debug.errName(e));
    }
    std.println("after await:done");
    co.close();
    return 0;
};
