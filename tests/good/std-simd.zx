// std-simd.zx —— std/simd.zx 守门：`@Vec` 的数学层（度量 / 逐分量 /
// 掩码 / 3D / 四元数）。
//
// 断言的是数值语义，不是指令选择：语言只提供 `@Vec` 类型和运算符，这一层
// 全是普通 Zx 函数，-O2 下由下游 C 编译器决定要不要把四次循环展开成
// blend/blendv。dev 档（-O0）不向量化是正常的。
// expect-output
// metric: dot=25 lenSq=25 len=5 dist=5
// norm: 0 0.6 0.8 len=1
// norm zero: 0 nan=false
// minmax: 1,2,3,7 | 4,5,3,8
// clamp: 2 5 6 2
// abs: -0 3 2 negzero=true
// lerp: 1 1 1 1
// sum: 16
// mask: sel=1,2,3,7 any=true all=false
// mask edges: allT=true anyF=false allF=false
// mask: if ok
// cross: 0 0 1 0
// reflect: 0 1 0
// quat id: 0 0 0 1 len=1
// quat rot: true true true len=1 unit=true
// quat mul: x=true y=true z=true w=true
// quat conj: true true true
// quat slerp: true true
// quat slerp edges: true true
const std = @mod("std");

const V4 = @Vec(f32, 4);
const Quat = std.simd.Quat;

// 浮点比较：库函数没有 eps 版本，这里手写一个。
const near = fn (a: f32, b: f32, eps: f32) bool {
    var d = a - b;
    if (d < 0.0) { d = -d; }
    return d <= eps;
};

pub const main = fn () u8 {
    // ---- 度量 ----
    let a = V4{0.0, 3.0, 4.0, 0.0};
    std.println("metric: dot={} lenSq={} len={} dist={}",
                std.simd.dot(a, a), std.simd.lengthSq(a),
                std.simd.length(a), std.simd.distance(a, V4{0.0, 0.0, 0.0, 0.0}));

    let u = std.simd.normalize(a);
    std.println("norm: {} {} {} len={}", u.0, u.1, u.2, std.simd.length(u));
    // 零向量原样返回，不产生 NaN
    let z = std.simd.normalize(V4{0.0, 0.0, 0.0, 0.0});
    std.println("norm zero: {} nan={}", z.0, z.0 != z.0);

    // ---- 逐分量 ----
    let p = V4{1.0, 5.0, 3.0, 7.0};
    let q = V4{4.0, 2.0, 3.0, 8.0};
    let lo = std.simd.min(p, q);
    let hi = std.simd.max(p, q);
    std.println("minmax: {},{},{},{} | {},{},{},{}",
                lo.0, lo.1, lo.2, lo.3, hi.0, hi.1, hi.2, hi.3);

    let c = std.simd.clamp(V4{0.0, 5.0, 10.0, -3.0}, 2.0, 6.0);
    std.println("clamp: {} {} {} {}", c.0, c.1, c.2, c.3);

    // abs 不清 -0.0 的符号位：1.0 / -0.0 仍然是负无穷
    let ab = std.simd.abs(V4{-0.0, -3.0, 2.0, -1.0});
    std.println("abs: {} {} {} negzero={}",
                ab.0, ab.1, ab.2, (1.0 / ab.0) < 0.0);

    let lv = std.simd.lerp(V4{0.0, 0.0, 0.0, 0.0}, V4{4.0, 4.0, 4.0, 4.0}, 0.25);
    std.println("lerp: {} {} {} {}", lv.0, lv.1, lv.2, lv.3);
    std.println("sum: {}", std.simd.sum(p));

    // ---- 掩码 ----
    let m = p < q;                       // 1<4 T, 5<2 F, 3<3 F, 7<8 T
    let sel = std.simd.select(m, p, q);
    std.println("mask: sel={},{},{},{} any={} all={}",
                sel.0, sel.1, sel.2, sel.3, std.simd.any(m), std.simd.all(m));
    // 全真 / 全假两种边
    let fullT = p <= p;
    let fullF = p > p;
    std.println("mask edges: allT={} anyF={} allF={}",
                std.simd.all(fullT), std.simd.any(fullF), std.simd.all(fullF));
    // 掩码能直接进 if
    if (std.simd.any(m) && !std.simd.all(m)) { std.println("mask: if ok"); }

    // ---- 3D ----
    let cx = std.simd.cross(V4{1.0, 0.0, 0.0, 0.0}, V4{0.0, 1.0, 0.0, 0.0});
    std.println("cross: {} {} {} {}", cx.0, cx.1, cx.2, cx.3);

    // 垂直入射到 y=0 平面：法线 (0,1,0,0)，反射后 z 取反
    let r = std.simd.reflect(V4{0.0, -1.0, 0.0, 0.0}, V4{0.0, 1.0, 0.0, 0.0});
    std.println("reflect: {} {} {}", r.0, r.1, r.2);

    // ---- 四元数 ----
    let id = Quat.identity();
    std.println("quat id: {} {} {} {} len={}", id.v.0, id.v.1, id.v.2, id.v.3, id.len());

    // 绕 z 轴 90°：rotate 把 +x 转到 +y
    let h = Quat.fromAxisAngle(V4{0.0, 0.0, 1.0, 0.0}, 1.5707963);
    let rv = h.rotate(V4{1.0, 0.0, 0.0, 0.0});
    std.println("quat rot: {} {} {} len={} unit={}",
                near(rv.0, 0.0, 1e-6), near(rv.1, 1.0, 1e-6), near(rv.2, 0.0, 1e-6),
                h.len(), near(h.len(), 1.0, 1e-6));

    // q * q = 绕同一轴 180°
    let h2 = h.mul(h);
    std.println("quat mul: x={} y={} z={} w={}",
                near(h2.v.0, 0.0, 1e-6), near(h2.v.1, 0.0, 1e-6),
                near(h2.v.2, 1.0, 1e-6), near(h2.v.3, 0.0, 1e-6));
    // 共轭就是反向旋转
    let back = h.conj().rotate(rv);
    std.println("quat conj: {} {} {}", near(back.0, 1.0, 1e-6),
                near(back.1, 0.0, 1e-6), near(back.2, 0.0, 1e-6));

    // slerp 到单位四元数的一半 = 45°：sin(22.5°) / cos(22.5°)
    let mid = h.slerp(id, 0.5);
    std.println("quat slerp: {} {}", near(mid.v.2, 0.38268343, 1e-5),
                near(mid.v.3, 0.92387953, 1e-5));
    // 同向插值的边界：t=0 与 t=1 都落在端点上
    let e0 = h.slerp(id, 0.0);
    let e1 = h.slerp(id, 1.0);
    std.println("quat slerp edges: {} {}", e0.eq(h), e1.eq(id));
    return 0;
};
