// array-pointer-index.zx —— §201：*[N]T 指向整个数组，数组才是元素。
// `p[0]` / `p.0` 取出数组；元素写 `p[0][i]` 或 `p.0[i]`。
// 指针加减 i 的步长是 sizeof([N]T)，不是 sizeof(T)。
// expect-exit: 0
// expect-output
// dot = 2 8
// br = 11 38
// len = 8
// stack = 22 33
const std = @mod("std");

const bumpAt = fn (p: *[8]i32, i: usize) void { p[0][i] = p[0][i] + 1; };

pub const main = fn () i32 {
    let a = std.heap.page;
    var ptr = std.heapAlloc(a, i32, 8).?;
    let i = std.process.args().len + 3;         // 运行期下标

    ptr[0][0] = 1;
    ptr[0][1] = 2;
    ptr[0][7] = 8;
    ptr[0][0] = ptr[0][0] + 10;
    ptr.0[i] = 37;
    bumpAt(ptr, i);                            // 传进函数里照样读改写
    std.println("dot = {} {}", ptr.0[1], ptr[0][7]);
    std.println("br = {} {}", ptr[0][0], ptr[0][i]);
    std.println("len = {}", ptr[0].len);
    a.free(a.ctx, (*u8)ptr, 8 * @type(i32).size);

    var stk = std.stackAlloc(i32, 4);          // 栈那份同一套语法
    stk[0][2] = 22;
    stk[0][i - 2] = 33;
    std.println("stack = {} {}", stk[0][2], stk[0][i - 2]);
    return 0;
};
