// 标签收割：一次跳出多层、continue 继续（循环没有 else 分支——E0405）
const std = @mod("std");

const firstBig = fn (xs: []const i32) i32 {
    var hit: i32 = 0;
    var found = false;
    for (xs) x {
        if (found) { continue; }        // 已命中：跳过（没有 break）
        if (x <= 100) { continue; }
        hit = x;
        found = true;
    }
    return hit;
};

const countEven = fn (xs: []const i32) usize {
    var n: usize = 0;
    for (xs) x {
        if (x % 2 != 0) { continue; }
        n = n + 1;
    }
    return n;
};

const main = fn () u8 {
    let xs: *const [4]i32 = &.{7, 250, 9, 400};
    std.println("{} {}", firstBig(xs[0..]), countEven(xs[0..]));
    return 0;
};

// expect-output
// 250 2
