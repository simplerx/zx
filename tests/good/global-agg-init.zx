// global-agg-init.zx —— 模块级 var 的聚合字面量初值必须真发出来（§150）。
//
// 旧后端把编译期 Value 物化成静态初始化数据，而 V_FN（函数引用）在
// val_init 里落到 default -> {0}：模块级 `var G = S{ .f = inc, ... }`
// 的 f 字段成 NULL，G.f(4) 直接段错误；聚合里嵌一层也一样。
// §150 改成：编译期值里带 V_FN 就不物化，交给 zx_init_<unit>() 在 main
// 开头按源码表达式赋值（复合字面量），函数符号保持真实名字。
//
// 纯标量聚合（Pt）仍走静态初始化，不进 zx_init_main —— 一并钉住别退化。
// expect-exit: 0
// expect-output
// g: 5 5
// o: 2 7
// p: 3 7
const std = @mod("std");

const inc = fn (x: i32) i32 { return x + 1; };

const S = struct { f: fn (i32) i32, n: i32 };
var G = S{ .f = inc, .n = 5 };

const Inner = struct { f: fn (i32) i32 };
const Outer = struct { in: Inner, n: i32 };
var O = Outer{ .in = Inner{ .f = inc }, .n = 7 };

const Pt = struct { x: i32, y: i32 };
var P = Pt{ .x = 3, .y = 7 };

pub const main = fn () i32 {
    std.println("g: {} {}", G.f(4), G.n);
    std.println("o: {} {}", O.in.f(1), O.n);
    std.println("p: {} {}", P.x, P.y);
    return 0;
};
