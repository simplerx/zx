// chan_basic.zx —— 实例自带的无缓冲 rendezvous：任务里 send/recv 真停靠、
// 配对直接握手；tryRecv 空报 would_block；close 后操作报 closed。
// expect-output:sum:6
// expect-output:try:would_block
// expect-output:after-close:closed
const std = module("std");
const Task = std.Task;

var total: usize = 0;
const producer = fn (ctx: usize) !usize {
    let t = Task.fromId(ctx);
    var i: usize = 1;
    while (i <= 3) { try t.send(i); i = i + 1; }
    return 0;
};

const consumer = fn (ctx: usize) !usize {
    let t = Task.fromId(ctx);
    var i: usize = 0;
    while (i < 3) {
        let v = try t.recv();
        std.atomic.atomicAdd(&total, v);
        i = i + 1;
    }
    return 0;
};

const main = fn () !i32 {
    let co = Task.coro();
    let hp = co.spawn(producer, co.id).?;
    let hc = co.spawn(consumer, co.id).?;
    try co.awaitAll();
    std.println("sum:{}", total);
    if (co.tryRecv()) v { std.println("unexpected:{}", v); } else e {
        std.println("try:{}", std.debug.errName(e));
    }
    co.close();
    if (co.recv()) v { std.println("unexpected"); } else e {
        std.println("after-close:{}", std.debug.errName(e));
    }
    return 0;
};
