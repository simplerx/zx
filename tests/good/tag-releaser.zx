// tag-releaser.zx —— §170 释放器封装：函数体里直接调 Allocator.free 的函数
// 是"释放器"，调用点视作一次释放事件，无需额外语法。
const std = @mod("std");
tag.buf;

const release = fn (a: Allocator, p: *i32, bytes: usize) void {
    a.free(a.ctx, (*u8)p, bytes);
};

const main = fn () u8 {
    var p = tag.buf : std.heapAlloc(std.heap.page, i32, 4);
    p[0] = 3;
    release(std.heap.page, p, 16);
    std.println("released");
    return 0;
};

// expect-output
// released
