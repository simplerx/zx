// reflect-ptr.zx —— §118 字段值指针（ptr 槽）+ 静态成员切片（statics）
//
// 用户 2026-11-11 拍板"使用指针取值"：fields[i].ptr = 基址 + offset，
// 编译期两头都已知。`@type(左值)` 的描述符才有 ptr；`f.ptr.0` 取值 /
// 写值（var 实例）、传给 *T 形参都是普通指针语义。
// statics：容器静态成员（const/var 数据，不含方法与类型成员）的切片，
// `@type(T)` 与 `@type(左值)` 都有；`info.statics.len` / `statics[i].name/.ty`。
const std = module("std");

const Point = struct { x: i32, y: i32 };
const Pair = struct { a: i32, b: i64 };
const Inner = struct { n: i32, m: i64 };
const Outer = struct { name: u8, inner: Inner };

const P3 = struct {
    a: i32,
    b: i64,

    pub const tag = 7;
    pub const label = "P3";
    pub const make = fn (v: i32) P3 {
        return P3{ .a = v, .b = 0 };
    };
};

const Color = enum { red, green };

const Cnt = struct {
    hits: i32,
    pub const lim = 100;
    pub var count: i32 = 0;
};

// §118 续（用户二次拍板）：statics[i].ptr 不依赖实例——后端把静态成员全部
// 物化成 C 全局，两种形态都是 &全局 的真指针。`.0` 取值（const 折字面量，
// var 读写全局）；裸 ptr 能传 *T 形参。@type(T) 与 @type(左值) 都有。
const bumpS = fn (p: *i32) void { p.0 = p.0 + 1; };

const bump = fn (p: *i32) void { p.0 = p.0 + 1; };

// 不知道字段名，遍历拿到所有字段的值（i32/i64 混合）
const dump = fn (T: type, v: T) void {
    const info = @type(v);
    inline for (0..info.fieldCount) i {
        const f = info.fields[i];
        std.println("  {} = {}", f.name, f.ptr.0);
    }
};

// 不知道静态成员名，遍历打印名字与类型
const dumpStatics = fn (T: type) void {
    const info = @type(T);
    inline for (0..info.statics.len) i {
        const s = info.statics[i];
        std.println("  static {} : {}", s.name, @type(s.ty).name);
    }
};

pub const main = fn () u8 {
    std.println("Point:");
    dump(Point, Point{ .x = 11, .y = 22 });
    std.println("Pair:");
    dump(Pair, Pair{ .a = 33, .b = 44 });

    // 写字段：var 实例通过 ptr 改值
    var pt = Outer{ .name = 1, .inner = Inner{ .n = 5, .m = 6 } };
    const io = @type(pt);
    io.fields[0].ptr.0 = 42;
    std.println("name={} (expect 42)", io.fields[0].ptr.0);

    // 嵌套基址：@type(p.inner) 的字段指针
    const ii = @type(pt.inner);
    ii.fields[1].ptr.0 = 77;
    std.println("m={} (expect 77)", pt.inner.m);

    // 字段指针传给 *T 形参（真指针语义）
    bump(ii.fields[0].ptr);
    std.println("n={} (expect 6)", pt.inner.n);

    // 静态成员切片：P3 的 const 数据（方法 make 不是数据成员，不进 statics）
    std.println("P3 statics:");
    dumpStatics(P3);
    // 枚举：显式 tag 的名字是变体不是静态常量，statics 为空
    std.println("Color statics:");
    dumpStatics(Color);

    // §118 续：statics[i].ptr —— @type(T) 形态（无实例）也能取值
    const ci = @type(Cnt);
    std.println("lim={} count={}", ci.statics[0].ptr.0, ci.statics[1].ptr.0);
    ci.statics[1].ptr.0 = 9;                    // var 静态可写
    std.println("count={} (expect 9)", Cnt.count);
    bumpS(ci.statics[1].ptr);                   // 裸 ptr 传 *T 形参
    std.println("count={} (expect 10)", Cnt.count);
    let p = ci.statics[0].ptr;                  // const 静态：&全局 真指针
    std.println("via-ptr={} (expect 100)", p.0);
    // @type(左值) 形态：statics.ptr 同样在（不与 fields.ptr 互斥）
    var c2 = Cnt{ .hits = 3 };
    const c2i = @type(c2);
    std.println("hits={} lim={}", c2i.fields[0].ptr.0, c2i.statics[0].ptr.0);

    return 0;
};

// expect-output
// Point:
//   x = 11
//   y = 22
// Pair:
//   a = 33
//   b = 44
// name=42 (expect 42)
// m=77 (expect 77)
// n=6 (expect 6)
// P3 statics:
//   static tag : i32
//   static label : *const [2]u8
// Color statics:
// lim=100 count=0
// count=9 (expect 9)
// count=10 (expect 10)
// via-ptr=100 (expect 100)
// hits=3 lim=100
