// §252：`[N]v` —— 用同一元素重复 N 次初始化数组。
// 值形式得 [N]T；&[N]v 得 *[N]T；元素是类型时 [N]T 是类型值（顺带支持
// 表达式位置的类型别名 `[4]u8`）。长度必须是编译期整数。
// expect-output
// vals=7 7 7 7
// chars=97 97 97
// agg=3 4 3 4
// alias=4
// ptr=9 9
// expect-exit: 0
const std = @mod("std");

const Pair = struct { x: i32, y: i32 };
const Buf: type = [4]u8;             // 表达式位置的数组类型别名
const Zeros = [3]0;                  // 编译期常量数组值

pub const main = fn () u8 {
    let a: [4]i32 = [4]7;
    if (a.len != 4 or a[0] != 7 or a[3] != 7) { return 1; }

    let c: [3]u8 = [3]'a';
    if (c[0] != 97 or c[2] != 97) { return 2; }

    let ps: [2]Pair = [2]Pair{ .x = 3, .y = 4 };
    if (ps[1].x != 3 or ps[1].y != 4) { return 3; }

    var buf: Buf = [4]0;
    if (buf.len != 4) { return 4; }
    if (Zeros[2] != 0) { return 5; }

    var p: *[2]i32 = &[2]9;
    if (p[0].len != 2 or p[0][1] != 9) { return 6; }

    std.println("vals={} {} {} {}", a[0], a[1], a[2], a[3]);
    std.println("chars={} {} {}", (i32)c[0], (i32)c[1], (i32)c[2]);
    std.println("agg={} {} {} {}", ps[0].x, ps[0].y, ps[1].x, ps[1].y);
    std.println("alias={}", buf.len);
    std.println("ptr={} {}", p[0][0], p[0][1]);
    return 0;
};
