// 指针算术 p ± n / p - q，以及 (usize)p / (*T)i
const std = @mod("std");

// 编译期：视图上的算术照样折叠（R1 要求 const 必须算得出来）
const tail = "hello"[1..];              // 视图 "ello"
const t0 = tail.0;                      // 'e'  ← 视图里的第 0 个
const nums = &.{ 10, 20, 30 };
const mid = nums[0..].ptr + 1;          // 视图偏移 +1 个元素
const midVal = mid.0;                   // 20
const dist = (nums[0..].ptr + 2) - nums[0..].ptr;   // 2（元素个数）

const main = fn () u8 {
    var buf = std.stackAlloc(u8, 16);
    var s = buf[0..];
    for (0..5) i { s[i] = (u8)(65 + i); }
    std.println("head={s}", s[0..5]);

    let p = buf[0..].ptr;               // *u8
    let q = p + 3;                      // 第 3 个字节
    std.println("q={} delta={}", q.0, q - p);

    let addr = (usize)p;
    let back = (*u8)addr;               // 整数转回地址
    std.println("roundtrip={} same={}", back.0, back == p);

    q.0 = 122;                          // 写成 'z'
    // §187：`(*u8)(addr + 3)` 这类洗源转回须显式续链贴标（守门见
    // tag-provenance-launder）；此处语义等价的指针算术写法：
    let z = p + 3;                      // 按字节 +3 再读回来
    std.println("z={}", z.0);

    var r = p;                          // 原地移动
    r += 1;
    r += 1;
    let moved = r.0;
    r -= 1;
    std.println("moved={} back={}", moved, r.0);

    var ints: *[4]i32 = &.{ 1, 2, 3, 4 };
    let ip: *i32 = ints;                // R7.1：丢数量
    std.println("ints={} {}", (ip + 1).0, (ip + 3).0);

    std.println("ct: {s} {} {} {}", tail, t0, midVal, dist);
    return 0;
};

// expect-output
// head=ABCDE
// q=68 delta=3
// roundtrip=65 same=true
// z=122
// moved=67 back=66
// ints=2 4
// ct: ello 101 20 2
