// 编译期求值：const 必须算出来（R1），泛型是编译期函数
const std = @mod("std");

const N     = 2 + 3 * 4;                     // 14
const M     = if (N > 10) 3 else 1;          // 3
const add   = fn (a: i32, b: i32) i32 { return a + b; };
const FIVE  = add(2, 3);                     // 5

// 编译期造表：块的值靠收割交出，整块物化成静态数据
const table = build: {
    var t: *[4]u8 = &.{0, 0, 0, 0};
    var i: usize = 0;
    while (i < 4) {
        t[i] = (u8)(i + 1);
        i = i + 1;
    }
    build: t;
};

// 编译期断言：@error 只在真的执行到的时候才报
const checked = if (table.2 != 3) @error("table[2] should be 3") else 0;

const main = fn () u8 {
    var _: *[N]i32 = undefined;             // 长度 14
    var _: *[FIVE + M]i32 = undefined;      // 长度 8
    let c = table.2;                         // 3
    let d = table.size;                      // 4
    let e = add(FIVE, 1);                    // 6
    std.println("{} {} {}", c, d, e);
    return 0;
};

// expect-output
// 3 4 6
