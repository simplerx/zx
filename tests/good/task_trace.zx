// task_trace.zx —— 捕获环随任务走：任务的捕获记录在任务自己的环里，
// 与根上下文的环天然隔离。
// 期望 stdout 见文件末尾的 expect-output 块：printTrace 走 stderr，runner
// 合并 stdout/stderr 比对，所以 trace 两行也在断言里。放末尾是为了不改动
// 前面代码的行号 —— trace 文本里含 tests/good/task_trace.zx:15:5。
const std = @mod("std");
const Task = std.task.Task;

const may_fail = fn (x: usize) !i32 {
    if (x > 0) { return error.too_big; }
    return 0;
};

const probe = fn (_: usize) !usize {
    if (may_fail(7)) v { return 0; } else e {
        std.println("task caught:{}", std.debug.errName(e));
        std.debug.printTrace();
        return 7;
    }
};

const main = fn () !i32 {
    let co = Task.coro();
    if (may_fail(7)) v {} else e {
        std.println("root caught:{}", std.debug.errName(e));
    }
    let f = co.spawn(probe, co.id).?;
    if (co.await(f)) v {
        std.println("task ret:{}", v);
    } else e { return error.bad; }
    co.close();
    return 0;
};

// expect-output
// zx trace (oldest first):
//   too_big at tests/good/task_trace.zx:15:5 in probe
// root caught:too_big
// task caught:too_big
// task ret:7
