// `*[N]T` 只是"带长度的指针"（8 字节），不是数组：Zx 没有数组变量。
// `&xs` 取的是**指针变量的地址**（得 `**T`），不存在"数组的地址"——
// 这正是删掉数组变量、与 C 的数组/指针歧义划清界限的设计意图。
const std = module("std");

const main = fn () u8 {
    var xs: *[4]i32 = &.{ 1, 2, 3, 4 };
    var p = &xs;
    p[0][2] = 9;
    if (@type(*[4]i32).size != 8) { return 1; }
    if (xs[2] != 9) { return 2; }

    // stackAlloc 拿到的也是指针，同样能取地址
    var ys = std.stackAlloc(i32, 3);
    var q = &ys;
    q[0][1] = 5;
    if (ys[1] != 5) { return 3; }
    std.println("ok {} {}", xs.len, ys.len);
    return 0;
};
