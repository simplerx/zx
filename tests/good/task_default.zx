// task_default.zx —— 默认任务（M57）：go / run / sleep。
// spawn 要求 fn(usize)!usize 全量签名；go/run 把零参两种形态包掉，
// sleep 让当前任务毫秒级停靠（取消会以 error.cancelled 醒来）。
// expect-output:run:42
// expect-output:go:7
// expect-output:slept:3
// expect-output:main-after:ok
const std = module("std");

const forty_two = fn () usize {
    return 42;
};

const lucky = fn () !usize {
    return 7;
};

const sleeper = fn (_: usize) !usize {
    try std.Task.sleep(20);              // 任务里：挂定时器真挂起
    return 3;
};

const main = fn () !i32 {
    std.Task.init(0);
    let h = std.Task.run(forty_two).?;   // 不可错零参：句柄
    if (std.Task.await(h)) v {
        std.println("run:{}", v);
    } else e {
        return e;
    }
    let g = std.Task.go(lucky).?;        // 可错零参
    if (std.Task.await(g)) v {
        std.println("go:{}", v);
    } else e {
        return e;
    }
    let s = std.Task.spawn(sleeper, 0).?;
    if (std.Task.await(s)) v {
        std.println("slept:{}", v);
    } else e {
        return e;
    }
    std.println("main-after:ok");
    return 0;
};
