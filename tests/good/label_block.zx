// label_block.zx —— 标签写在哪（v0.24）
//
// 一条规则：**标签写在被命名的结构前面**。
//   块的标签   `t: { … }`              → 跳到块末，交出值
//   循环的标签 `done: while (…) { … }` → 跳出循环，交出值
//
// 块臂里两个名字的区分：紧跟 `{` 的是**捕获**（绑定的就是匹配到的东西），
// 紧跟 `:` 的是**标签**（块内 `lbl: v;` 交出值）。两者可以同时出现，捕获在前。
const std = @mod("std");

const Shape = union(enum) {
    circle: f64,
    rect:   { f64, f64 },
};

// ① 标签块臂：只交值，不捕获
const kind = fn (s: Shape) i32 {
    return switch (s) {
        .circle: a: { a: 1; };
        .rect:   a: { a: 2; };
    };
};

// ② 捕获 + 标签：先捕获载荷 `r`，再给块贴标签 `a`
const measure = fn (s: Shape) f64 {
    return switch (s) {
        .circle: r  a: { a: r * 2.0; };
        .rect:   wh a: { a: wh.0 + wh.1; };
    };
};

// ③ 枚举臂：捕获主语值本身，标签块再加工
const Color = enum { red, green };
const weight = fn (c: Color) i32 {
    return switch (c) {
        .red:   v r: { r: (i32)v + 10; };
        .green: v g: { g: (i32)v + 20; };
    };
};

// ⑦ orelse 兜底臂里的带标签块是**值**（§223）；块内 `pick: v;` 给块交值，
//    不是收割到函数外一个叫 pick 的标签。
const orelse_value = fn (o: ?i32) i32 {
    return o orelse pick: { pick: 88; };
};

const main = fn () i32 {
    const c = Shape{ .circle = 1.5 };
    const r = Shape{ .rect = { 3.0, 4.0 } };

    // ④ if 臂的标签块；没有 else 时，条件为假就是零值
    const i = if (true) tag: { tag: 5; };
    const j = if (false) tag: { tag: 5; } else 0;

    // ⑤ while：标签写在关键字前面——它是循环的名字，`done: v;` 直接跳出循环
    var n: i32 = 0;
    const w = done: while (true) {
        n = n + 1;
        if (n == 7) { done: n * 10; }
    };

    // ⑥ for：同上，跳出循环而不是"跳到体末再进下一轮"
    // （循环没有 else 分支——E0405；兜底值用 var）
    var f: i32 = -1;
    for (0..8) k {
        if (k == 3) { f = (i32)k; }
    }

    std.println("{} {} {} {}", kind(c), kind(r), measure(c), measure(r));
    std.println("{} {} {} {}", i, j, w, f);
    std.println("{} {}", weight(Color.red), weight(Color.green));
    std.println("{} {}", orelse_value(null), orelse_value(5));
    return 0;
};

// expect-output
// 1 2 3 7
// 5 0 70 3
// 10 21
// 88 5
