// else 臂的标识符 + 运算符/调用是普通表达式，不是真值臂的捕获语法。
const std = @mod("std");

const nextValue = fn (x: usize) usize {
    return x + 1;
};

pub const main = fn () i32 {
    var values: [8]u64 = .{ 0, 0, 0, 0, 0, 0, 0, 0 };
    var i: usize = 0;
    while (i < 3) {
        let next = if (i == 2) 0 else i + 1;
        let called = if (i == 2) 0 else nextValue(i);
        if (next != called) return 1;
        values[next] = values[next] + 1;
        i = i + 1;
    }
    if (values[0] != 1 or values[1] != 1 or values[2] != 1) return 2;
    if (values[3] != 0 or values[4] != 0 or values[5] != 0 or
        values[6] != 0 or values[7] != 0) return 3;
    std.println("{} {} {} {}", values[0], values[1], values[2], values[0] + values[1] + values[2]);
    return 0;
};

// expect-exit: 0
// expect-output
// 1 1 1 3
