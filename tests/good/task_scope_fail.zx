// task_scope_fail.zx —— fail-fast：任一成员失败，运行时立刻取消其余兄弟。
// coro 实例的就绪队列是 FIFO，spawn 顺序固定，交错确定：
//   spin 先跑一轮并 yield → boom 结算报错 → cancel 兄弟 → spin 在循环回边
//   收到 cancelled（上轮做的纯计算循环取消检查）。
// join 必须回放的是**首个**错误（boom），不是后来那个 cancelled。
// expect-output:join:boom
// expect-output:sibling:cancelled
// expect-output:interrupted:1
const std = module("std");
const Task = std.task.Task;

const LIMIT: usize = 1000000;
var g_tid: usize = 0;
var g_h: usize = 0;
var ticks: usize = 0;

const spin = fn (_: usize) !usize {
    let t = Task.fromId(g_tid);
    var i: usize = 0;
    while (i < LIMIT) {
        i = i + 1;
        std.atomic.atomicStore(&ticks, i);
        t.yield();
    }
    return i;
};

const boom = fn (_: usize) !usize { return error.boom; };

const main = fn () !i32 {
    let co = Task.coro();
    defer co.close();
    g_tid = co.id;

    let sc = co.scope();
    defer co.scopeClose(sc);
    g_h = co.scopeSpawn(sc, spin, 0).?;
    _ = co.scopeSpawn(sc, boom, 0).?;

    if (co.scopeJoin(sc)) v { std.println("unexpected:{}", v); } else e {
        std.println("join:{}", std.debug.errName(e));
    }
    if (co.await(g_h)) v { std.println("sibling-unexpected:{}", v); } else e {
        std.println("sibling:{}", std.debug.errName(e));
    }
    let n = std.atomic.atomicLoad(&ticks);
    var it: usize = 0;
    if (n > 0 && n < LIMIT) { it = 1; }
    std.println("interrupted:{}", it);
    return 0;
};
