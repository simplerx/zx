// guide_examples.zx —— docs/guide.md 示例代码的回归用例。
//
// 文档里的每段示例都从这里抽验：这段过了，指南就不会教坏新人。
// 改动指南示例时同步改这里（或反过来）。
const std = @mod("std");

const Person = struct {
    name: []const u8,
    age: i32 = 0,
};

const Color = enum {
    red, green = 5, blue,

    const name = fn (self: Self) []const u8 {
        return switch (self) {
            .red: "red";
            .green: "green";
            .blue: "blue";
        };
    };
    const count = fn () u32 { return 3; };
};

const Shape = union(enum) {
    circle: f64,
    rect:   { f64, f64 },
};

const Vec = struct {
    x: i32,
    y: i32,

    const add = fn (self: Self, o: Self) Self {
        return Self{ .x = self.x + o.x, .y = self.y + o.y };
    };
    const shift = fn (self: *Self, d: i32) void {
        self.x = self.x + d;
    };
    const len2 = fn (self: Self) i32 {
        return self.x * self.x + self.y * self.y;
    };
};

// 结构体没有内建 ==，写个逐字段比较（1.2.0 起没有 @typeInfo 反射，
// 泛型按类型分派也就没有了：要进比较的类型直接写出来）。
const eql = fn (x: Vec, y: Vec) bool {
    return x.x == y.x && x.y == y.y;
};

const sum = fn (xs: []const i32) i32 {
    var s: i32 = 0;
    for (xs) x { s = s + x; }
    return s;
};

const main = fn () u8 {
    // §4 绑定
    const MAX: usize = 100;
    var i: usize = 0;
    let n: usize = MAX;
    i = n;
    std.println("i={}", i);

    // §6.1 元组
    let t = {1, 2.5, "hi"};
    std.println("t.0={} t.len={}", t.0, t.len);

    // §6.2 数组/切片
    var arr: *[4]i32 = &.{1, 2, 3, 4};
    arr.0 = 10;
    arr[2] = 30;
    std.println("arr.len={} sum={}", arr.len, sum(arr[0..]));

    // §6.4 结构体
    var p: Person = .{ .name = "ann" };
    std.println("{} age={}", p.name, p.age);

    // §6.5 枚举
    std.println("{} {} {}", Color.red.name(), Color.count(), (u32)Color.blue);

    // §6.6 联合体
    let s = Shape{ .circle = 2.0 };
    let area = switch (s) {
        .circle: r  a: { a: 3.14159 * r * r; };
        .rect:   wh a: { a: wh.0 * wh.1; };
    };
    std.println("area={}", area);

    // §6.7 方法
    var a = Vec{ .x = 1, .y = 2 };
    a.shift(10);
    let b = a.add(a);
    std.println("len2={}", b.len2());   // Self 只读，按大小自动选传值/传址

    // §7.2 while 带值
    var nn: i32 = 0;
    const w = done: while (true) {
        nn = nn + 1;
        if (nn == 7) { done: nn * 10; }
    };
    std.println("w={}", w);

    // §7.3 for 的查找（循环没有 else 分支——E0405；兜底用 var）
    let xs = &.{3, 9, 4};
    var idx: i32 = 0;
    for (xs[0..]) x {
        if (x == 9) { idx = 1; }
    }
    std.println("idx={}", idx);

    // §8 捕获
    let maybe: ?i32 = 5;
    if (maybe) v {
        std.println("v={}", v);
    } else {
        std.println("null");
    }
    std.println("port={}", maybe orelse 8080);

    // §15 eql
    std.println("eql={} eql={}", eql(a, a), eql(a, Vec{ .x = 1, .y = 2 }));

    // §14 std.array.List
    var list = std.array.List(i32).init(std.heap.page);
    defer list.deinit();
    if (!list.push(7)) { return 1; }
    std.println("list={}", list.items());

    return 0;
};

// expect-output
// i=100
// t.0=1 t.len=3
// arr.len=4 sum=46
// ann age=0
// red 3 6
// area=12.56636
// len2=500
// w=70
// idx=1
// v=5
// port=5
// eql=true eql=false
// list=[7]
