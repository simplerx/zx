// true / false 就是 bool 字面量：能参与 && || !、能当 switch 模式、能做编译期条件
const std = module("std");
const debug = true;
const level = if (debug) 2 else 0;

const pick = fn (flag: bool) i32 {
    return switch (flag) {
        true: 1;
        false: 0;
    };
};

const main = fn () u8 {
    var b: bool = true;
    b = !b;
    b = b || debug;
    if (b && true) { b = false; }
    let f: f32 = if (b) 1.5 else 0.5;
    std.println("{} {} {} {}", b, f, level, pick(debug));
    return 0;
};

// expect-output
// false 0.5 2 1
