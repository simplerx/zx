// 一个"稍微像样"的程序：读文件 → 切分 → 过滤出数字 → 排序 → 输出。
// 只用标准库，不需要手搓容器和字符串处理。
const std = @mod("std");

const main = fn () i32 {
    let al = std.heap.page;
    let path = "tests_csv.tmp";

    // 造一份输入
    if (!std.file.write(path, "12, 7, 30, 7, 41, x, 5\n")) { return 1; }
    std.println("input  [{}]", std.str.trim("12, 7, 30, 7, 41, x, 5\n"));

    let text = std.file.read(al, path);
    if (text) t {
        let line = std.str.trim(t);
        let parts = std.str.split(al, line, ",");
        if (parts) ps {
            var xs = std.array.List(i32).init(al);
            var sum: i64 = 0;
            for (ps) p {
                if (std.str.parseInt(p)) v {          // "x" 在这里被丢掉
                    if (!xs.push((i32)v)) { return 2; }
                    sum = sum + v;
                }
            }

            // 插入排序（语言里没有 break，用条件变量收尾）
            var i: usize = 1;
            while (i < xs.len) {
                let cur = xs.get(i);
                if (cur) c {
                    var j = i;
                    var going = true;
                    while (j > 0 and going) {
                        let prev = xs.get(j - 1);
                        if (prev) pv {
                            if (pv > c) {
                                if (!xs.set(j, pv)) { return 3; }
                                j = j - 1;
                            } else {
                                going = false;
                            }
                        } else {
                            going = false;
                        }
                    }
                    if (!xs.set(j, c)) { return 4; }
                }
                i = i + 1;
            }

            std.println("count  {}", xs.len);
            std.println("sum    {}", sum);
            std.println("sorted {}", xs.items());
            xs.deinit();
            std.str.freeSplit(al, ps);
        }
    }

    std.println("remove {}", std.file.remove(path));
    return 0;
};

// expect-output
// input  [12, 7, 30, 7, 41, x, 5]
// count  6
// sum    102
// sorted [5, 7, 7, 12, 30, 41]
// remove true
