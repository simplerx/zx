// optional.zx —— `a orelse b` 与 `a.?`（G1）
//
// 这两条是把自举搬上日程的前提：没有它们，AST 里每个子节点都得写成
// `if (n->a) x { … }`，代码量翻倍。现在钉住五件事：
//   ① 有值取载荷、空/错取右边
//   ② 右结合 + 优先级低于算术（`a orelse 0 + 1` 是 `a orelse (0 + 1)`）
//   ③ 右边只在真的空/错时才求值（惰性）
//   ④ `.?` 在表达式任意位置可用（含 `(.?).?.` 这类链）
//   ⑤ 编译期能定下来的就在编译期折掉（`null orelse 42` 是常量）
const std = module("std");

const Node = struct { v: i32, next: ?*Node };

// 惰性探针：被调用就会打一行
fn noisy(tag: []const u8, v: i32) i32 {
    std.println("side {}", tag);
    return v;
}

// ③ 捕获 + `.?`，两种写法都给同一个答案
fn or_neg(o: ?i32) i32 {
    return o orelse -1;
}

fn must(o: ?i32) i32 {
    return o.?;
}

// ⑤ 编译期折叠
const FALLBACK = null orelse 42;
const SOME: ?i32 = 7;
const FROM_SOME: i32 = SOME orelse 0;
const FROM_UNWRAP: i32 = SOME.?;

fn main() i32 {
    let a: ?i32 = 3;
    let b: ?i32 = null;

    // ① 基本语义
    std.println("{} {} {}", or_neg(a), or_neg(b), must(a));

    // 错误联合体同一套规则：(error)3 是"出错"，5 是有值
    let e: !i32 = (error)3;
    let ok: !i32 = 5;
    std.println("{} {} {}", e orelse -1, ok orelse -1, ok.?);

    // ② 右结合与优先级
    std.println("{} {}", b orelse (null orelse 9), b orelse 0 + 1);
    std.println("{}", (a orelse 0) + 1);

    // ③ 惰性：a 有值，右边的 side 不该出现；b 是空，才会出现
    std.println("{}", a orelse noisy("first", 100));
    std.println("{}", b orelse noisy("second", 200));

    // ④ 链式解包
    var tail: Node = .{ .v = 3, .next = null };
    var mid: Node = .{ .v = 2, .next = &tail };
    var head: Node = .{ .v = 1, .next = &mid };
    std.println("{} {}", (head.next).?.v, (head.next).?.next.?.v);

    // ⑤ const 侧的折叠
    std.println("{} {} {} {}", FALLBACK, FROM_SOME, FROM_UNWRAP, null orelse "s");
    return 0;
}

// expect-output
// 3 -1 3
// -1 5 5
// 9 1
// 4
// 3
// side second
// 200
// 2 3
// 42 7 7 s
