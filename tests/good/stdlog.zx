// std.log：高性能落盘日志 + 多线程安全守门。
// 单线程 Logger 验级别过滤与落盘格式；SyncLogger 由 4 个 worker 并发写，
// 校验每行完整（不交错）、总数不丢、各 worker 行数正确。
const std = @mod("std");
const Task = std.task.Task;

const PATH1 = "zx-log-single.log";
const PATH2 = "zx-log-concurrent.log";

// spawn 的签名固定 fn(u64) !u64（task 方法不能泛型），所以 worker 靠 u64
// 编号索引全局消息表，logger 走全局指针共享。
const MSGS = &.{ "w0", "w1", "w2", "w3" };
var g_log: *std.log.SyncLogger = undefined;

const worker = fn (id: u64) !u64 {
    let msg = MSGS[0..][(usize)id];
    var i: usize = 0;
    while (i < 200) {
        if (!g_log.info(msg)) { return 1; }
        i = i + 1;
    }
    return 0;
};

const main = fn () !i32 {
    let al = std.heap.page;
    _ = std.fs.removeFile(al, PATH1);
    _ = std.fs.removeFile(al, PATH2);

    // ---- 单线程 + 级别过滤 ----
    if (std.log.Logger.initCap(al, PATH1, 256, std.log.INFO)) lv {
        var l = lv;
        if (l.enabled(std.log.DEBUG)) { return 1; }
        if (!l.debug("filtered")) { return 2; }       // 被过滤：不算失败
        if (l.pending() != 0) { return 3; }           // 也没进缓冲
        if (!l.info("alpha")) { return 4; }
        if (!l.warn("beta")) { return 5; }
        if (!l.err("gamma")) { return 6; }
        if (!l.flush()) { return 7; }
        if (l.pending() != 0) { return 8; }
        l.deinit();
    } else { return 9; }

    if (std.fs.readAll(al, PATH1)) d {
        var lines: usize = 0;
        var i: usize = 0;
        while (i < d.len) {
            if (d[i] == '\n') { lines = lines + 1; }
            i = i + 1;
        }
        if (lines != 3) { return 10; }
        if (std.str.contains(d, "filtered")) { return 11; }
        if (!std.str.contains(d, "[") or !std.str.contains(d, "Z INFO ] alpha")
            or !std.str.contains(d, "Z WARN ] beta")
            or !std.str.contains(d, "Z ERROR] gamma")) { return 12; }
    } else { return 13; }

    // ---- 多线程并发写：4 worker × 200 条 ----
    if (std.log.SyncLogger.initCap(al, PATH2, 8192, std.log.DEBUG)) sv {
        var sl = sv;
        g_log = &sl;
        let t = Task.pool(4);
        var k: u64 = 0;
        while (k < 4) { _ = t.spawn(worker, k).?; k = k + 1; }
        try t.awaitAll();
        t.close();
        if (!g_log.flush()) { return 14; }
        g_log.deinit();
    } else { return 15; }

    // 每行 "…] wN\n"：检查 \n 前两字节是 'w'+数字，统计各 worker 行数。
    var total: usize = 0;
    var bad: usize = 0;
    var c0: usize = 0; var c1: usize = 0; var c2: usize = 0; var c3: usize = 0;
    if (std.fs.readAll(al, PATH2)) d2 {
        var i: usize = 0;
        while (i < d2.len) {
            if (d2[i] == '\n') {
                total = total + 1;
                if (i >= 2 and d2[i - 2] == 'w' and d2[i - 1] >= '0' and d2[i - 1] <= '3') {
                    let c = d2[i - 1];
                    if (c == '0') { c0 = c0 + 1; }
                    else if (c == '1') { c1 = c1 + 1; }
                    else if (c == '2') { c2 = c2 + 1; }
                    else { c3 = c3 + 1; }
                } else { bad = bad + 1; }
            }
            i = i + 1;
        }
    } else { return 16; }
    if (bad != 0 or total != 800) { return 17; }
    if (c0 != 200 or c1 != 200 or c2 != 200 or c3 != 200) { return 18; }

    std.println("single:ok concurrent:{} lines", total);
    _ = std.fs.removeFile(al, PATH1);
    _ = std.fs.removeFile(al, PATH2);
    return 0;
};

// expect-output
// single:ok concurrent:800 lines
