// @memcpy / @memmove / @memset：批量内存操作（v0.25）。
//
// ArrayList 增长 / 插入删除 / append 原来是逐元素循环——T 任意大小，
// 每次搬运都是一次访存加一次循环判断。现在容器内部直接用这三个内建，
// 一次批量搬运（C 的 memcpy / memmove / memset，SIMD 友好）。
//
// 语义与 C 一致：
//   @memcpy  区间不得重叠（重叠用 @memmove）
//   @memmove 允许重叠，按方向正确搬运
//   @memset  按字节填充
// 三者都返回 void；切片实参自动取 .ptr。
const std = module("std");

const main = fn () i32 {
    // ① @memcpy：指针到指针
    var src = &.{ 1, 2, 3, 4, 5, 6, 7, 8 };
    var dst: *[8]i32 = &.{ 0, 0, 0, 0, 0, 0, 0, 0 };
    @memcpy(dst, src, 8 * @type(i32).size);
    std.println("{} {} {} {}", dst[0], dst[3], dst[6], dst[7]);

    // ② @memmove：同 buffer 内重叠右移
    var buf: *[6]i32 = &.{ 1, 2, 3, 4, 5, 6 };
    @memmove((buf + 2), (buf + 0), 4 * @type(i32).size);
    std.println("{} {} {} {} {} {}", buf[0], buf[1], buf[2], buf[3], buf[4], buf[5]);

    // ③ @memset：清零
    @memset(buf, 0, 6 * @type(i32).size);
    std.println("{} {}", buf[0], buf[5]);

    // ④ 切片实参（自动取 .ptr）
    let s: []const i32 = src[0..];
    var d2: *[4]i32 = &.{ 0, 0, 0, 0 };
    @memcpy(d2, s, 4 * @type(i32).size);
    std.println("{} {}", d2[1], d2[3]);

    // ⑤ 容器内部也走它们：append 大批量
    var al = std.ArrayList(i32).init(std.heap.page);
    defer al.deinit();
    var i: usize = 0;
    while (i < 64) {
        _ = al.push((i32)(i * i));
        i = i + 1;
    }
    let xs = al.items();
    std.println("{} {} {}", xs[0], xs[7], xs[63]);
    return 0;
};

// expect-output
// 1 4 7 8
// 1 2 1 2 3 4
// 0 0
// 2 4
// 0 49 3969
