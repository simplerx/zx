// §134：检查性使用不是 E0510。`free` / `deinit` 之后用 `if (t.get(h)) p`
// 或 `== null` 查询合法性，是 side table 刻意提供的 fail-safe 路径；
// 只有 `.?` 这种「确定失效还强制解包」才报硬错（见 tests/bad 那条）。
// 直线发行 + 直线作废，slot 未 tainted，所以状态机确实知道它已失效。
const std = module("std");

const Point = struct { x: i32 };
const Table = std.slot.SlotTable(Point, 4);

pub const main = fn () u8 {
    const al = std.heap.page;
    var t = Table.init(al).?;
    let h = t.create().?;
    std.println("free {}", t.free(h));
    if (t.get(h)) p {
        p.x = 9;
        std.println("unexpected {}", p.x);
    } else {
        std.println("stale {}", t.get(h) == null);
    }
    std.println("leak {}", t.deinit());
    std.println("closed {}", t.get(h) == null);
    return 0;
};

// expect-output
// free true
// stale true
// leak 0
// closed true
