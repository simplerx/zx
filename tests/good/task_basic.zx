// task_basic.zx —— Task 实例（M58）：coro 实例上的 spawn / await / yield /
// awaitAll。实例自带队列与推进力，交错是确定性的。
// expect-output:spawned:1
// expect-output:order:1212123
// expect-output:sum:20
// expect-output:awaitAll:ok
// expect-output:main-after:ok
const std = @mod("std");
const Task = std.task.Task;

var order: usize = 0;

const pa = fn (ctx: usize) !usize {
    let t = Task.fromId(ctx);
    var n: usize = 0;
    while (n < 3) { order = order * 10 + 1; t.yield(); n = n + 1; }
    order = order * 10 + 3;
    return 100;
};

const pb = fn (ctx: usize) !usize {
    let t = Task.fromId(ctx);
    var n: usize = 0;
    while (n < 3) { order = order * 10 + 2; t.yield(); n = n + 1; }
    return 20;
};

const main = fn () !i32 {
    let co = Task.coro();
    let a = co.spawn(pa, co.id).?;
    let b = co.spawn(pb, co.id).?;
    std.println("spawned:{}", a);
    if (co.await(a)) v { std.println("order:{}", order); } else e { return error.bad; }
    if (co.await(b)) v { std.println("sum:{}", v); } else e { return error.bad; }
    try co.awaitAll();
    std.println("awaitAll:ok");
    co.close();
    std.println("main-after:ok");
    return 0;
};
