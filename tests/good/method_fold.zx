// 方法调用出现在"会被编译期折叠的函数体"里（M19 修的回归）。
// ct_call 折叠调用时会 clone 已检查过的函数体再 check 一遍；
// 方法调用第一次检查已把接收者塞进参数表，克隆体复检必须幂等。
const std = module("std");

const P = struct {
    x: i32,
    const bump = fn (self: *P, d: i32) void { self.x = self.x + d; };
};

const g = fn () i32 {
    var p = P{ .x = 1 };
    p.bump(2);
    return p.x;
};

const main = fn () u8 {
    let a = g();
    let b = g();
    std.println("{} {}", a, b);
    return 0;
};

// expect-output
// 3 3
