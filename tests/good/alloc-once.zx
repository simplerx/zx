// §130：正常一次 free 不报诊断。`(*u8)p` 是指针→指针强转，地址不变，
// 编译期仍认得同一个发行版本（provenance 未断）；指针↔整数互转才抹源。
const std = @mod("std");

const main = fn () u8 {
    const al = std.heap.page;
    var p = std.heapAlloc(al, u8, 64).?;
    p[0][0] = 7;
    let v = p[0][0];
    al.free(al.ctx, (*u8)p, 64);
    std.println("v={d}", v);
    return 0;
};

// expect-output
// v=7
