// 守门：解构临时与 `_ = expr` 丢弃临时共用 `_ds` 前缀但计数器独立，
// `_ = p;` 跟在 `const {a,b} = t;` 后面会发两个 `_ds0` → B1001 redefinition。
// 修复：丢弃临时前缀改 `_ig`（2026-11-11 reference 校对踩中）。
const std = module("std");

const main = fn () u8 {
    const t = {1, 2};
    const {a, b} = t;
    std.println("{} {}", a, b);
    let .{p, q} = t;
    _ = p;
    _ = q;
    const u = {1, 2.5, "x"};
    const {x, y, z} = u;
    std.println("{} {} {}", x, y, z);
    let .{m, n, o} = u;
    _ = m; _ = n; _ = o;
    return 0;
};
