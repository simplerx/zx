// program.zx —— 一个像样的小程序：定长向量、排序、统计、状态机
const std = @mod("std");

const MAX: usize = 8;

const Vec = struct {
    data: *[MAX]i32,
    len: usize = 0,
};

const push = fn (v: *Vec, x: i32) bool {
    if (v.len >= MAX) { return false; }
    v.data[0][v.len] = x;
    v.len = v.len + 1;
    return true;
};

const get = fn (v: Vec, i: usize) ?i32 {
    if (i >= v.len) { return null; }
    return v.data[0][i];
};

const sortUp = fn (v: *Vec) void {
    var i: usize = 0;
    while (i + 1 < v.len) {
        var j: usize = 0;
        while (j + 1 < v.len - i) {
            if (v.data[0][j] > v.data[0][j + 1]) {
                let t = v.data[0][j];
                v.data[0][j] = v.data[0][j + 1];
                v.data[0][j + 1] = t;
            }
            j = j + 1;
        }
        i = i + 1;
    }
};

const dump = fn (tag: []const u8, v: Vec) void {
    std.print("{}:", tag);
    for (v.data[0..v.len]) x { std.print(" {}", x); }
    std.print("\n");
};

const fib = fn (n: i32) i32 {
    if (n < 2) { return n; }
    return fib(n - 1) + fib(n - 2);
};

const State = enum { idle, running, done };

const step = fn (s: State) State {
    return switch (s) {
        .idle: State.running;
        .running: State.done;
        else: State.idle;
    };
};

const nameOf = fn (s: State) []const u8 {
    return switch (s) {
        .idle: "idle";
        .running: "running";
        else: "done";
    };
};

const main = fn () u8 {
    var raw = std.stackAlloc(i32, MAX);
    var v = Vec{ .data = raw, .len = 0 };

    _ = push(&v, 5);
    _ = push(&v, 3);
    _ = push(&v, 9);
    _ = push(&v, 1);
    _ = push(&v, 7);
    dump("in ", v);

    sortUp(&v);
    dump("out", v);

    var total: i32 = 0;
    for (v.data[0..v.len]) x { total = total + x; }
    std.println("sum={} fib={}", total, fib(10));

    if (get(v, 2)) x { std.println("v[2]={}", x); } else { std.println("v[2]=none"); }
    if (get(v, 99)) x { std.println("v[99]={}", x); } else { std.println("v[99]=none"); }

    var s: State = State.idle;
    var i: usize = 0;
    while (i < 4) {
        std.print("{} -> ", nameOf(s));
        s = step(s);
        i = i + 1;
    }
    std.println("{}", nameOf(s));

    var pushes: i32 = 0;
    while (push(&v, 42)) { pushes = pushes + 1; }
    std.println("full? pushes={} len={}", pushes, v.len);

    return 0;
};

// expect-output
// in : 5 3 9 1 7
// out: 1 3 5 7 9
// sum=25 fib=55
// v[2]=5
// v[99]=none
// idle -> running -> done -> idle -> running
// full? pushes=3 len=8
