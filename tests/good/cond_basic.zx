// cond_basic.zx —— std.cond（M57）：OS 线程级条件变量，std.mutex 的
// 搭档。无等待者时 signal/broadcast 是空放；wait 的真阻塞场景需要
// 第二个 OS 线程配合（纤程级的等待请用 std.channel）。
// expect-output:cond:ok
const std = module("std");

const main = fn () !i32 {
    let m = std.mutex.mutexNew();
    let cv = std.cond.condNew();
    std.mutex.mutexLock(m);
    std.cond.condSignal(cv);                 // 没人等：空放
    std.cond.condBroadcast(cv);
    std.mutex.mutexUnlock(m);
    std.cond.condFree(cv);
    std.mutex.mutexFree(m);
    std.println("cond:ok");
    return 0;
};
