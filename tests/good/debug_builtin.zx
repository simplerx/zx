// debug_builtin.zx —— std.debug 与位置内建（decisions §85）
//
// `@file` / `@line` / `@col` / `@fnName` 在编译期折成字面量，零运行时开销；
// `std.debug.panic` / `std.debug.assert` 的位置实参由编译器在调用点自动注入。
//   assert：条件为假才 panic（带位置）；release（-DZX_RELEASE）整段擦除
//   panic：永不返回（noreturn），之后的代码按不可达处理（E0502）
//   errName：错误码 → 名字，静态表由编译器按编译期登记的错误集生成
// （会 abort 的用例——panic 真触发、assert 失败——退出码跨平台不稳，
//   放在 .tmp 手工验证，不进回归。）

const std = module("std");

const probe = fn () []const u8 {
    return @fnName();
};

const main = fn () !i32 {
    // 错误码在编译期登记，errName 查静态表
    std.println("e1:{}", std.debug.errName(error.disk_full));
    std.println("e2:{}", std.debug.errName(error.bad_arg));
    std.println("e3:{}", std.debug.errName(error.never_registered));
    // 通过的断言不打印任何东西
    std.debug.assert(2 + 2 == 4, "arithmetic is broken");
    std.println("assert:ok");
    std.println("fn:{}", probe());
    return 0;
};

// expect-output
// e1:disk_full
// e2:bad_arg
// e3:never_registered
// assert:ok
// fn:probe
