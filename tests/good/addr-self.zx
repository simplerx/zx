// addr-self.zx —— §224：`&self` 就是普通形参取址，不再有 ABI 穿透。
//
// `self: Self` 是按值参数（副本），`&self` 得到指向这个副本的 `*Self`；
// 要拿调用者本身的地址，方法必须声明成 `self: *Self` / `self: *const Self`。
// 形参槽在栈帧上，所以把 `&self` 返回出去照旧被 E0503 挡住（见
// tests/bad/addr-self-return.zx），写按值 self 照旧被 E0403 挡住。
// expect-exit: 0
// expect-output
// small: 11 11
// big: 22 22
// field: 55
// empty: 0
const std = @mod("std");

const Small = struct {
    a: u64,
    const viaAddr = fn (self: Self) u64 {
        let p = &self;
        return p.a;
    };
    const read = fn (p: *const Self) u64 { return p.a; };
    const viaArg = fn (self: Self) u64 { return Self.read(&self); };
};

const Big = struct {
    a: u64, b: u64, c: u64,
    const viaAddr = fn (self: Self) u64 {
        let p = &self;
        return p.a;
    };
    const read = fn (p: *const Self) u64 { return p.a; };
    const viaArg = fn (self: Self) u64 { return Self.read(&self); };
    const viaField = fn (self: Self) u64 {
        let pa = &self.a;
        let pb = &self.b;
        return pa.0 + pb.0;
    };
};

const Empty = struct {
    z: i32,
    const viaAddr = fn (self: Self) i32 {
        let p = &self;
        return Self.zero(p);
    };
    const zero = fn (p: *const Self) i32 { return p.z; };
};

pub const main = fn () i32 {
    let s = Small{ .a = 11 };
    let b = Big{ .a = 22, .b = 33, .c = 44 };
    let e = Empty{ .z = 0 };
    std.println("small: {} {}", s.viaAddr(), s.viaArg());
    std.println("big: {} {}", b.viaAddr(), b.viaArg());
    std.println("field: {}", b.viaField());
    std.println("empty: {}", e.viaAddr());
    return 0;
};
