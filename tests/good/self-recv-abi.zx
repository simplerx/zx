// self-recv-abi.zx —— §224：方法接收者形态完全由写法决定，编译器不再按
// 大小改 ABI。`self: Self` 就是普通按值参数（C 里发 `ZxS self`，无论结构
// 多大），`self: *Self` 发 `ZxS * self`，`self: *const Self` 发
// `const ZxS * self`。不再有 >16B 自动降级成 const 指针，也不再有方法体里补
// `(*self)`；§274 的调用点值/只读指针转换不改变这些签名。
//
// 生成 C 的形态由 test.sh §224 断言钉住：Small/Big 都按值、没有 (*self)。
// expect-exit: 0
// expect-output
// small: 3
// big: 15
// copy: 15
// empty: 0
// mut: 17
const std = @mod("std");

const Small = struct {
    x: i32,
    y: i32,
    const sum = fn (self: Self) i32 { return self.x + self.y; };
};

const Big = struct {
    a: i32, b: i32, c: i32, d: i32, e: i32,
    // >16B 也照写法按值收：C 形参是结构体本身，不是 const 指针
    const total = fn (self: Self) i32 {
        return self.a + self.b + self.c + self.d + self.e;
    };
    const copy = fn (self: Self) Self { return self; };
    const peek = fn (self: *const Self) i32 { return self.a + 10; };
    const bumpMe = fn (self: *Self, d: i32) void { self.a = self.a + d; };
};

const Empty = struct {
    const zero = fn (self: Self) i32 { return 0; };
};

pub const main = fn () i32 {
    let s = Small{ .x = 1, .y = 2 };
    var b = Big{ .a = 1, .b = 2, .c = 3, .d = 4, .e = 5 };
    let e = Empty{};
    std.println("small: {}", s.sum());
    std.println("big: {}", b.total());
    let bc = b.copy();
    std.println("copy: {}", bc.total());
    std.println("empty: {}", e.zero());
    b.bumpMe(6);
    std.println("mut: {}", b.peek());
    return 0;
};
