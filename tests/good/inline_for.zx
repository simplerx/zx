// inline_for.zx —— inline for 编译期展开 + @field / @fieldName 字段遍历
const std = module("std");

const Point = struct { x: i32, y: i32, tag: u8 };
const Inner = struct { a: i32, b: i32 };
const Outer = struct { n: i32, in: Inner, ok: bool };

// 泛型 eql：字段比较代码由 inline for 自动生成
const eql = fn (T: type, x: T, y: T) bool {
    const info = @typeInfo(T);
    if (info.kind != std.TypeKind.struct_) {
        return x == y;      // 标量 / bool：直接比
    }
    // 结构体：逐字段递归——手写两行，展开出来和字段数一样多
    inline for (0..info.fieldCount) i {
        const FT = @fieldType(T, @fieldName(T, i));
        if (!eql(FT, @field(x, @fieldName(T, i)), @field(y, @fieldName(T, i)))) {
            return false;
        }
    }
    return true;
};

const main = fn () u8 {
    // ① 普通 unroll：循环变量是编译期常量
    var acc: usize = 0;
    inline for (0..5) i {
        acc = acc + i * i;
    }
    std.println("acc={d}", acc);            // 0+1+4+9+16 = 30

    // ② 循环变量当数组长度用——证明它是编译期常量
    inline for (0..3) i {
        var buf: *[i + 1]u8 = undefined;
        std.println("len={d}", buf.len);    // 数组的编译期字段：i + 1
    }

    // ③ @field 按名字取字段
    let p = Point{ .x = 3, .y = 4, .tag = 9 };
    std.println("x={d}", @field(p, "x"));
    std.println("y={d}", @field(p, "y"));

    // ④ 遍历字段：fieldCount + fieldName + fieldType
    const info = @typeInfo(Point);
    inline for (0..info.fieldCount) i {
        const fname = @fieldName(Point, i);
        std.println("field {d} = {s} : {s}", i, fname, @typeName(@fieldType(Point, fname)));
    }

    // ⑤ 泛型 eql：结构体全字段比较
    let a = Outer{ .n = 1, .in = Inner{ .a = 2, .b = 3 }, .ok = true };
    let b = Outer{ .n = 1, .in = Inner{ .a = 2, .b = 3 }, .ok = true };
    let c = Outer{ .n = 1, .in = Inner{ .a = 2, .b = 9 }, .ok = true };
    std.println("a==b: {b}", eql(Outer, a, b));
    std.println("a==c: {b}", eql(Outer, a, c));
    std.println("i32:  {b}", eql(i32, 7, 7));

    // ⑥ @field 当左值
    var m = Outer{ .n = 0, .in = Inner{ .a = 0, .b = 0 }, .ok = false };
    @field(m, "n") = 42;
    @field(@field(m, "in"), "a") = 5;
    std.println("m.n={d} m.in.a={d}", m.n, m.in.a);

    // ⑦ 无绑定：纯按次数重复
    inline for (0..2) { std.println("ping"); }

    return 0;
};

// expect-output
// acc=30
// len=1
// len=2
// len=3
// x=3
// y=4
// field 0 = x : i32
// field 1 = y : i32
// field 2 = tag : u8
// a==b: 1
// a==c: 0
// i32:  1
// m.n=42 m.in.a=5
// ping
// ping
