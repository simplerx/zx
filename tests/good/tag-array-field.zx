// §226：数组/切片**字段**进标签群——群键是「基变量 + 字段路径」。
//
// 改造前 `s.arr[i]` 的基址解析不到（agt_base_of 不认 NK_FIELD），标签
// 既进不了群也读不回，就算配对 free 了，终扫还**假报 E0513**。现在读写
// 两侧共用 agt_base_of，字段数组和局部数组一样可追踪；同结构体的
// `s.a` / `s.b` 因路径不同是两本独立的账（串号防护见
// tests/bad/tag-array-field-collide.zx）。
// expect-exit: 0
// expect-output
// ok
tag.enable;
const std = @mod("std");

const Bufs = struct {
    arr: [2]*u8,
    tail: i32,
};

pub const main = fn () u8 {
    var s = Bufs{ .arr = .{ undefined, undefined }, .tail = 0 };

    // 常索引：写进字段数组、读回、配对释放——全程该可追踪
    s.arr[0] = std.heapAlloc(std.heap.page, u8, 8);
    s.arr[1] = std.heapAlloc(std.heap.page, u8, 8);
    let q = s.arr[0];
    std.heap.page.free(std.heap.page.ctx, q, 8);
    std.heap.page.free(std.heap.page.ctx, s.arr[1], 8);

    // 再写一轮，覆盖"覆盖写入换账"路径
    s.arr[0] = std.heapAlloc(std.heap.page, u8, 16);
    std.heap.page.free(std.heap.page.ctx, s.arr[0], 16);

    // 运行期索引：用注解读取取出（群成员取出通路）
    var r = Bufs{ .arr = .{ undefined, undefined }, .tail = 1 };
    let i: usize = 0;
    r.arr[i] = tag.buf2 : std.heapAlloc(std.heap.page, u8, 4);
    tag v : tag.buf2 = r.arr[i];
    std.heap.page.free(std.heap.page.ctx, v, 4);

    std.println("ok");
    return 0;
};
