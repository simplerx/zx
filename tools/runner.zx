// tools/runner.zx —— 用 Zx 写的测试 runner。
//
// 为什么要用 Zx 写：它把编译器推向自己最常被使用的那条路——读文件、切字符串、
// 拼命令、起进程、比对输出。任何一处能力缺口都会在这里暴露（之前是 extern C
// 与 fmt 的细节），比再写十个 hello world 有用。
//
// 用法（原由 test.sh 调用）：
//   runner <zxc> <tmpprefix> <file.zx>...
//
// **状态：保留，但不再参与 CI。**
// 它有两个位置不对的问题：用 system() 拼 cmd 行时自己重定向的 stdout 会整块
// 丢失（实测 1/6），而且不计量耗时。CI 现在走 tools/runner.c（同样的判定协议）。
// 这个文件留下是因为 spec/bootstrap.md 拿它当自举的迁移试验目标。
//
// 判定规则与旧 test.sh 一致：
//   1. tests/bad / tests/multibad：必须编译失败，且 stderr 里有 `// expect:` 的文本
//      （可选 `// expect-code:` 断码、`// expect-count:` 断条数）
//   2. 其他：必须编译通过（--check）；源码里有 `// expect-output` 时还要
//      编成二进制跑一遍，stdout 逐行对得上
const std = module("std");

extern fn system(cmd: *const u8) i32;

const BUFCAP: usize = 4096;

// 拼命令用的定长字符串缓冲：system() 要 NUL 结尾的 C 字符串，
// Zx 的 []const u8 不保证结尾，所以每次都得现拼一个。
const Cmd = struct {
    p: *[BUFCAP]u8,
    n: usize,

    const init = fn () Cmd {
        /* 必须走堆：stackAlloc 分配在**当前函数帧**里，在 init() 里申请
         * 再返回指针就是悬空指针（命令字符串会变成垃圾）。 */
        return .{ .p = std.heapAlloc(std.heap.page, u8, BUFCAP), .n = 0 };
    };
    const add = fn (self: *Cmd, s: []const u8) void {
        var i: usize = 0;
        while (i < s.len && self.n + 1 < BUFCAP) {
            self.p[self.n] = s[i];
            self.n = self.n + 1;
            i = i + 1;
        }
    };
    const addc = fn (self: *Cmd, ch: u8) void {
        if (self.n + 1 < BUFCAP) { self.p[self.n] = ch; self.n = self.n + 1; }
    };
    // system() 走 cmd.exe：正斜杠路径它不认（`./bin/zxc.exe` 会被当成命令名），
    // 所以拼命令时统一转成反斜杠。
    const addpath = fn (self: *Cmd, s: []const u8) void {
        var i: usize = 0;
        while (i < s.len) {
            let ch = s[i];
            if (ch == '/') { self.addc('\\'); } else { self.addc(ch); }
            i = i + 1;
        }
    };
    const cstr = fn (self: *Cmd) *const u8 {
        self.p[self.n] = 0;
        return self.p;
    };
};

const run = fn (cmd: *Cmd) i32 {
    /* system() 在 Windows 上是 `cmd /c <整串>`，而 cmd 对引号有条古怪规则：
     * 只要命令以 " 开头、且引号总数不是「恰好两个」，它就剥掉最外层的一对。
     * 于是 `"E:\..\a.exe" > "E:\..\out" 2>&1` 会被糟蹋成
     * `E:\..\a.exe" > "E:\..\out 2>&1`，报「文件名、目录名或卷标语法不正确」。
     * 对策：自己先包一层引号，让它剥掉的正好是我们多包的那层。 */
    if (cmd.n + 2 < BUFCAP) {
        var i = cmd.n;
        while (i > 0) { cmd.p[i] = cmd.p[i - 1]; i = i - 1; }
        cmd.p[0] = '"';
        cmd.p[cmd.n + 1] = '"';
        cmd.n = cmd.n + 2;
    }
    let dbg = std.process.getEnv("ZX_RUNNER_DEBUG");
    if (dbg) v { if (v.len > 0) {
        std.io.print(std.io.stderr(), "cmd: {s}\n", cmd.p[0..cmd.n]);
    } }
    return system(cmd.cstr());
};

const slurp = fn (al: std.Allocator, path: []const u8) []const u8 {
    let r = std.file.read(al, path);
    if (r) t { return t; }
    return "";
};

/* 重定向出来的 stdout 是 CRLF，而 `// expect-output` 里写的是 LF。
 * 比对前把 \r 全去掉，免得每个用例都因为行尾差异假失败。 */
const no_cr = fn (al: std.Allocator, s: []const u8) []const u8 {
    var sb = std.ArrayList(u8).init(al);
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] != '\r') {
            if (!sb.push(s[i])) { return s; }
        }
        i = i + 1;
    }
    return sb.items();
};

// 前缀判断：路径属于哪一类
const is_err_test = fn (path: []const u8) bool {
    return std.str.startsWith(path, "tests/bad/") ||
           std.str.startsWith(path, "tests/multibad/");
};

// 取第一条 `// key` 注释后面的内容（key 含 "// " 前缀，比如 "// expect: "）
const directive = fn (parts: [][]const u8, key: []const u8) ?[]const u8 {
    for (parts) p {
        let line = std.str.trimEnd(p);
        if (std.str.startsWith(line, key)) return line[key.len..];
    }
    return null;
};

/* 进程退出码断言：`// expect-exit: 7`。没写就只看 stdout。
 * 错误处理最后靠的就是退出码——`main() !void` 出错时码就是错误码。 */
const exit_ok = fn (ps: [][]const u8, status: i32) bool {
    if (directive(ps, "// expect-exit: ")) want {
        if (std.str.parseInt(want)) n { return n == (i64)status; }
    }
    return true;
};

// 取 `// expect-output` 之后所有 `// ` 行，拼成期望的 stdout（行间 \n，末尾不带）。
// 没有这一段就返回空串（调用方用 len 判断）。
const expect_output = fn (al: std.Allocator, parts: [][]const u8) []const u8 {
    var sb = std.ArrayList(u8).init(al);
    var on = false;
    var n: usize = 0;
    var broken = false;
    for (parts) p {
        let line = std.str.trimEnd(p);
        if (!on) {
            if (std.str.eq(line, "// expect-output")) on = true;
        } else if (!std.str.startsWith(line, "// ")) {
            on = false;                      // 注释块结束
        } else if (!broken) {
            let body = line[3..];
            var good = true;
            if (n > 0) { good = sb.push('\n'); }
            var i: usize = 0;
            while (i < body.len && good) {
                good = sb.push(body[i]);
                i = i + 1;
            }
            if (!good) { broken = true; } else { n = n + 1; }
        }
    }
    if (n == 0) { sb.deinit(); return ""; }
    return sb.items();
};

/* 入口有两种写法都算有 main：旧式 `fn main(`，和 v0.24 起的
 * `const main = fn (…)`。判错了不会报错——只会静默跳过运行，
 * 让 47 个 expect-output 用例退化成纯类型检查。 */
const has_main = fn (src: []const u8) bool {
    return std.str.contains(src, "fn main(") || std.str.contains(src, "main = fn");
};

/* `// expect-output` 有没有写，和它后面写了几个期望行是两件事。
 * 裸写一个标记 = "这个程序什么都不打印"，也是一条断言——不能用
 * "期望行数为 0" 当"没写"（`spec/examples/syntax.zx` 正是这种）。 */
const has_output = fn (parts: [][]const u8) bool {
    for (parts) p {
        if (std.str.eq(std.str.trimEnd(p), "// expect-output")) return true;
    }
    return false;
};

/* concat 返回 ?[]u8；OOM 在这里当成空串——runner 自己的失败不该伪装成测试失败 */
const cat = fn (al: std.Allocator, a: []const u8, b: []const u8) []const u8 {
    let r = std.str.concat(al, a, b);
    if (r) v { return v; }
    return "";
};

const report = fn (ok: bool, path: []const u8, why: []const u8) void {
    if (ok) std.println("  ok   {}", path)
    else    std.println("  FAIL {} — {}", path, why);
};

/* 数一数 stderr 里有几条诊断（`error[Exxxx]` 的出现次数）。
 * 用来断 R? "多错误恢复"——一次该报几条就是几条。 */
const count_errors = fn (log: []const u8) usize {
    var n: usize = 0;
    var i: usize = 0;
    while (i < log.len) {
        let at = std.str.indexOfFrom(log, "error[E", i);
        if (at) k { n = n + 1; i = k + 7; } else { i = log.len; }
    }
    return n;
};

/* 反例的三条断言：expect / expect-code / expect-count。
 * 任何一条不满足就算失败，一次把所有问题都报出来（不要修一个才看见下一个）。 */
const verify_err = fn (al: std.Allocator, f: []const u8, ps: [][]const u8, log: []const u8) bool {
    var ok = true;

    if (directive(ps, "// expect: ")) want {
        if (!std.str.contains(log, want)) {
            std.println("  FAIL {} -- stderr lacks \"{}\"", f, want);
            std.println("       {}", log);
            ok = false;
        }
    }

    if (directive(ps, "// expect-count: ")) cs {
        if (std.str.parseInt(cs)) wn {
            let got = count_errors(log);
            if (got != (usize)wn) {
                std.println("  FAIL {} -- {} error(s) reported, want {}", f, got, wn);
                std.println("       {}", log);
                ok = false;
            }
        }
    }

    if (directive(ps, "// expect-code: ")) codes {
        if (std.str.split(al, codes, " ")) list {
            var i: usize = 0;
            while (i < list.len) {
                let c = list[i];
                i = i + 1;
                if (c.len > 0) {
                    if (!std.str.contains(log, c)) {
                        std.println("  FAIL {} -- no diagnostic with code {}", f, c);
                        std.println("       {}", log);
                        ok = false;
                    }
                }
            }
            std.str.freeSplit(al, list);
        }
    }

    return ok;
};

const main = fn () i32 {
    let al = std.heap.page;
    let args = std.process.args();
    if (args.len < 3) {
        std.println("usage: runner <zxc> <tmp> <file.zx>...");
        return 2;
    }
    let zxc = args[0];
    let tmp = args[1];

    var pass: i32 = 0;
    var fail: i32 = 0;

    let o1 = cat(al, tmp, ".o1");
    let o2 = cat(al, tmp, ".o2");
    let b  = cat(al, tmp, ".exe");   /* 必须带 .exe：cmd 不执行无扩展名的文件 */

    var i: usize = 2;
    while (i < args.len) {
        let f = args[i];
        i = i + 1;

        let src = slurp(al, f);
        let parts = std.str.split(al, src, "\n");
        if (parts) ps {
            if (is_err_test(f)) {
                // 必须失败：stdout/stderr 都收进临时文件再找关键字
                var c = Cmd.init();
                c.addpath(zxc); c.add(" \""); c.addpath(f); c.add("\" > \""); c.addpath(o1); c.add("\" 2>&1");
                let code = run(&c);
                let log = slurp(al, o1);
                if (code == 0) {
                    report(false, f, "should be rejected, but compiled");
                    fail = fail + 1;
                } else if (verify_err(al, f, ps, log)) {
                    pass = pass + 1;
                    report(true, f, "");
                } else {
                    fail = fail + 1;              // 细节已由 verify_err 打印
                }
            } else {
                // 必须通过检查
                var c = Cmd.init();
                c.addpath(zxc); c.add(" \""); c.addpath(f); c.add("\" > \""); c.addpath(o1); c.add("\" 2>&1");
                if (run(&c) != 0) {
                    std.println("  FAIL {} -- type check failed", f);
                    std.println("       {}", slurp(al, o1));
                    fail = fail + 1;
                } else {
                    pass = pass + 1;
                    report(true, f, "");

                    // 有 expect-output 就跑一遍真二进制
                    let want = expect_output(al, ps);
                    if (has_main(src) && has_output(ps)) {
                        var cb = Cmd.init();
                        cb.addpath(zxc); cb.add(" \""); cb.addpath(f); cb.add("\" -o \""); cb.addpath(b);
                        cb.add("\" > \""); cb.addpath(o1); cb.add("\" 2>&1");
                        if (run(&cb) != 0) {
                            std.println("  FAIL {} -- backend compile failed", f);
                            std.println("       {}", slurp(al, o1));
                            fail = fail + 1;
                        } else {
                            var rr = Cmd.init();
                            rr.add("\""); rr.addpath(b); rr.add("\" > \""); rr.addpath(o2); rr.add("\" 2>&1");
                            let status = run(&rr);
                            /* Windows 上刚执行过的 exe 还会被映像占用；不删的话
                             * 下一个用例链接到同名文件会被拒绝（AccessDenied） */
                            std.file.remove(b);
                            let got = std.str.trimEnd(no_cr(al, slurp(al, o2)));
                            if (!std.str.eq(got, std.str.trimEnd(no_cr(al, want)))) {
                                std.println("  FAIL {} -- stdout mismatch", f);
                                std.println("    want: {}", std.str.trimEnd(want));
                                std.println("    got:  {}", got);
                                fail = fail + 1;
                            } else if (!exit_ok(ps, status)) {
                                std.println("  FAIL {} -- exit {}", f, status);
                                fail = fail + 1;
                            } else {
                                pass = pass + 1;
                                report(true, f, "");
                            }
                        }
                    }
                }
            }
            std.str.freeSplit(al, ps);
        } else {
            report(false, f, "cannot split source");
            fail = fail + 1;
        }
    }

    std.file.remove(o1);
    std.file.remove(o2);
    std.file.remove(b);

    std.println("passed {}, failed {}", pass, fail);
    /* 报告必须落盘：stdout 被重定向时是整块缓冲，而 runner 一路在起子进程
     * （system()），退出时的隐式刷新有时不可靠——实测 1/6 的概率整份报告丢失。
     * 显式刷一次，别让"全过"只留在内存里。 */
    std.io.flush(std.io.stdout());
    if (fail != 0) { return 1; }
    return 0;
};
