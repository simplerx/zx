// math.zx —— 数学：常量、整数工具、浮点函数。
//
//   const std = @mod("std");
//   std.println("{}", std.math.sqrt(2.0));
//   let n = std.math.nextPowerOfTwo(37);       // 64
//
// 平台：浮点函数直接 extern 到 C 运行时的 libm（Windows 是 ucrt，POSIX 是
// libm，zig cc 默认都链得上，不需要 @link）。参数是 f64，和 C double 同构。
// `extern "C" { pub fn … }` 让 C 符号本身就是 std.math 的公开成员，不另造
// 一层同名转发——既少一份代码，补全会直接看到真实签名。形参一律具名：
// 无名形参虽能编译（`_p0/_p1`），补全/hover 却会退化成 C 原型 `sqrt(f64)`，
// snippet 占位也变成类型名；写成 `sqrt(x: f64) f64` 才是 Zx 的形状。
//
// 简约约定：不做泛型 min/max（容器方法不能泛型，函数泛型要按实例检查），
// 整数用 *I 后缀、浮点用无后缀，一眼看清走的是哪条路。常量名不与函数名
// 同前缀（`root2` 而不是 `sqrt2`），否则输入 `std.math.sqrt` 会连带弹出常量。

// ---- 常量（编译期值，可直接当数组长度 / 泛型实参）-------------------------

pub const pi: f64 = 3.14159265358979323846;
pub const e: f64 = 2.71828182845904523536;
pub const tau: f64 = 6.28318530717958647692;
pub const root2: f64 = 1.41421356237309504880;
pub const ln2: f64 = 0.69314718055994530942;
pub const ln10: f64 = 2.30258509299404568402;

// ---- C 运行时的浮点函数（签名必须与 math.h 一致）---------------------------

extern "C" {
    pub fn sqrt(x: f64) f64;
    pub fn cbrt(x: f64) f64;
    pub fn pow(x: f64, y: f64) f64;
    pub fn floor(x: f64) f64;
    pub fn ceil(x: f64) f64;
    pub fn round(x: f64) f64;
    pub fn trunc(x: f64) f64;
    pub fn fabs(x: f64) f64;
    pub fn fmod(x: f64, y: f64) f64;
    pub fn sin(x: f64) f64;
    pub fn cos(x: f64) f64;
    pub fn tan(x: f64) f64;
    pub fn asin(x: f64) f64;
    pub fn acos(x: f64) f64;
    pub fn atan(x: f64) f64;
    pub fn atan2(y: f64, x: f64) f64;
    pub fn exp(x: f64) f64;
    pub fn log(x: f64) f64;
    pub fn log2(x: f64) f64;
    pub fn log10(x: f64) f64;
    pub fn hypot(x: f64, y: f64) f64;
}

// ---- 纯 Zx 的整数工具（不依赖任何外部符号）---------------------------------

pub const absI = fn (x: i32) i32 {
    if (x < 0) { return -x; }
    return x;
};

pub const minI = fn (a: i32, b: i32) i32 {
    if (a < b) { return a; }
    return b;
};

pub const maxI = fn (a: i32, b: i32) i32 {
    if (a > b) { return a; }
    return b;
};

pub const clampI = fn (x: i32, lo: i32, hi: i32) i32 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
};

pub const gcd = fn (a: u32, b: u32) u32 {
    var x = a;
    var y = b;
    while (y != 0) {
        let t = x % y;
        x = y;
        y = t;
    }
    return x;
};

pub const lcm = fn (a: u32, b: u32) u32 {
    if (a == 0 or b == 0) { return 0; }
    return a / gcd(a, b) * b;
};

// 快速幂：u32 溢出按无符号回绕，和 Zx 的整数语义一致。
pub const powI = fn (base: u32, n: u32) u32 {
    var r: u32 = 1;
    var b = base;
    var k = n;
    while (k > 0) {
        if (k % 2 == 1) { r = r * b; }
        b = b * b;
        k = k / 2;
    }
    return r;
};

pub const isPowerOfTwo = fn (x: u32) bool {
    return x != 0 and (x & (x - 1)) == 0;   // §248：O(1)，不再逐位循环
};

pub const nextPowerOfTwo = fn (x: u32) u32 {
    if (x <= 1) { return 1; }
    var v = x - 1;                          // §248：位扩散一次成型
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    if (v == 0xffffffff) { return 0; }      // 再翻一倍就溢出 u32
    return v + 1;
};

// ---- 纯 Zx 的浮点小工具 ----------------------------------------------------

pub const min = fn (a: f64, b: f64) f64 {
    if (a < b) { return a; }
    return b;
};

pub const max = fn (a: f64, b: f64) f64 {
    if (a > b) { return a; }
    return b;
};

pub const clamp = fn (x: f64, lo: f64, hi: f64) f64 {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
};

pub const sign = fn (x: f64) i32 {
    if (x < 0.0) { return -1; }
    if (x > 0.0) { return 1; }
    return 0;
};

pub const degToRad = fn (d: f64) f64 { return d * pi / 180.0; };
pub const radToDeg = fn (r: f64) f64 { return r * 180.0 / pi; };

// ---- 位运算工具（u32，纯 Zx，无编译器内建）-------------------------------
// 本文件约定整数工具用 *32 后缀标明宽度（见文件头的简约约定）。

// 置位数。x=0 返回 0。
pub const popcount32 = fn (x: u32) u32 {
    var v = x;                              // §248：SWAR 并行计数，5 步固定
    v = v - ((v >> 1) & 0x55555555);
    v = (v & 0x33333333) + ((v >> 2) & 0x33333333);
    v = (v + (v >> 4)) & 0x0f0f0f0f;
    return (v + (v >> 8) + (v >> 16) + (v >> 24)) & 0x3f;
};

// 末尾连续 0 的个数。x=0 返回 32（没有最低的 1）。
pub const ctz32 = fn (x: u32) u32 {
    if (x == 0) { return 32; }
    var v = x;                              // §248：折半定位，最多 5 步
    var n: u32 = 0;
    if ((v & 0xffff) == 0) { v = v >> 16; n = n + 16; }
    if ((v & 0xff) == 0) { v = v >> 8; n = n + 8; }
    if ((v & 0xf) == 0) { v = v >> 4; n = n + 4; }
    if ((v & 0x3) == 0) { v = v >> 2; n = n + 2; }
    if ((v & 0x1) == 0) { n = n + 1; }
    return n;
};

// 开头连续 0 的个数。x=0 返回 32。
pub const clz32 = fn (x: u32) u32 {
    if (x == 0) { return 32; }
    var v = x;                              // §248：折半定位，最多 5 步
    var n: u32 = 0;
    if (v <= 0x0000ffff) { v = v << 16; n = n + 16; }
    if (v <= 0x00ffffff) { v = v << 8; n = n + 8; }
    if (v <= 0x0fffffff) { v = v << 4; n = n + 4; }
    if (v <= 0x3fffffff) { v = v << 2; n = n + 2; }
    if (v <= 0x7fffffff) { n = n + 1; }
    return n;
};

// 向上对齐到 alignment（须为 2 的幂）。已是倍数就原样返回。
pub const alignForward = fn (x: usize, alignment: usize) usize {
    let mask = alignment - 1;
    let t = x + mask;
    return t - (t & mask);      // 等价于 t & ~mask，不依赖位取反
};
