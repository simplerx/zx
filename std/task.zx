// task.zx —— zx 唯一的并发抽象。对外只有 Task 一个类型。
//
// 简洁、透明（decisions §123 / §128）：
//   * std.io 是纯同步调用，没有 hook / offload / 隐式线程。要并发就显式
//     「task + io」：起一个任务，在任务里做 io；编译器不替用户做调度决策。
//   * 任务函数是普通 fn(usize) !usize，await 是普通方法。没有 async/await、
//     没有函数着色、没有新语法、没有类型系统里的新概念。
//   * Task 是接口：4 个静态构造器（coro/single/pool/fromId）生成实例，
//     任务调度、默认 rendezvous、select 与生命周期都走 `t.` 分发；
//     没有 `Task.spawn()` 这类关联函数调用。句柄统一 usize。
//   * 唯一例外是内核线程组：`Task.group()` 是工厂方法，生成 `Group`
//     实例（`g.spawn/wait/run/close`），与 Task 实例调度器互补。组不占
//     实例资源，C 侧只是原子计数 + 裸 OS 线程，任务即发即忘。
//   * 接口只保留四组：任务调度、实例自带的默认 rendezvous、select、
//     内核线程组。**不导出**作用域 / 命名通道 / 定时器：zx 没有
//     trait / interface / 子类型，Scope/Chan/Timer 无法「实现 Task 接口」
//     做多态；手写 vtable 只是函数指针表 + ctx 强转，没有静态检查，
//     而三者的能力集与 Task 也不构成同一契约（见 §128）。C 运行时里
//     这些机制仍然存在，但只作内部实现，服务默认通道、select 超时与
//     close 的唤醒链，不进对外 API。
//   * 类型命名空间：4 个静态构造器 + `group` 工厂 + 编译期分支常量
//     SEL_AWAIT / SEL_RECV（值，不是行为）。
//
// 实例物理隔离：每个 Task 有自己的任务表、就绪队列、通道与一组线程。
//   Task.coro()      协程实例：不建线程，await/awaitAll 时推进
//   Task.single()    单线程实例：1 条专属 OS 线程
//   Task.pool(n)     多线程实例：n 条工作线程（n=0 自动取 CPU-1）
//
// 边界（decisions §94）：spawn/await/cancel/send/recv 可从本实例管理的
// 任意 OS 线程并发调用；构造、awaitAll、close 由创建者串行使用。
//
// 运行时分层：C（src/backend.c 的 emit_task_runtime）是内部机制层，只提供
// 栈切换 / TLS / 线程 / 锁 / 条件变量 / 单调钟 / 原子这些 zx 表达不了的
// 原语，以及竞态密集的纤程调度与等待链；库层用下面这些私有 extern 声明
// 使用它们。策略与编排（句柄、组批量、select 分支常量）在 zx 侧。
// API 与边界见 docs/reference.md §14.10。

// ---- 内部：运行时入口（不导出）----

extern fn zx_task_new(mode: usize, n: usize) usize;
extern fn zx_task_spawn(s: usize, f: fn (usize) !usize, ctx: usize) ?usize;
extern fn zx_task_await(s: usize, h: usize) !usize;
extern fn zx_task_await_all(s: usize) !void;
extern fn zx_task_cancel(s: usize, h: usize) void;
extern fn zx_task_yield(s: usize) void;
extern fn zx_task_send(s: usize, v: usize) !void;
extern fn zx_task_recv(s: usize) !usize;
extern fn zx_task_try_send(s: usize, v: usize) !void;
extern fn zx_task_try_recv(s: usize) !usize;
extern fn zx_task_close(s: usize) void;

extern fn zx_tg_new() usize;
extern fn zx_tg_spawn(g: usize, f: fn (usize) !usize, ctx: usize) usize;
extern fn zx_tg_wait(g: usize) void;
extern fn zx_tg_close(g: usize) void;

extern fn zx_sel_wait(t: usize, br: *const usize, n: usize, ms: usize, which: *usize) !usize;

// ---------------------------------------------------------------------------
// Group：内核调度线程组（Task.group() 生成的实例）。
// ---------------------------------------------------------------------------
pub const Group = struct {
    id: usize,

    // 起线程失败（句柄耗尽/内存不足）返回 false，计数不残留。
    pub const spawn = fn (self: *const Self, f: fn (usize) !usize, ctx: usize) bool {
        return zx_tg_spawn(self.id, f, ctx) == 1;
    };

    // 等本组任务全部收尾。组可复用（wait 后还能继续 spawn）。
    pub const wait = fn (self: *const Self) void {
        zx_tg_wait(self.id);
    };

    // 批量编排：起 n 条内核线程跑同一个函数，ctx 依次 0..n-1，等收尾。
    pub const run = fn (self: *const Self, f: fn (usize) !usize, n: usize) void {
        var i: usize = 0;
        while (i < n) {
            _ = zx_tg_spawn(self.id, f, i);
            i = i + 1;
        }
        zx_tg_wait(self.id);
    };

    // 等收尾后释放计数器，之后句柄不可再用。
    pub const close = fn (self: *const Self) void {
        zx_tg_close(self.id);
    };
};

// ---------------------------------------------------------------------------
// Task：并发接口的主体（Group 是唯一的伴随类型）。
// ---------------------------------------------------------------------------
pub const Task = struct {
    pub id: usize,

    // ---- 构造：三种物理形态 ----

    pub const coro = fn () Self {
        return Self{ .id = zx_task_new(0, 0) };
    };

    pub const single = fn () Self {
        return Self{ .id = zx_task_new(1, 0) };
    };

    pub const pool = fn (n: usize) Self {
        return Self{ .id = zx_task_new(2, n) };
    };

    // 任务函数只能带一个 usize 进来；把实例 id 当 ctx 传进去，任务里用
    // fromId 还原，就能在任务内 send/recv/await。
    pub const fromId = fn (id: usize) Self {
        return Self{ .id = id };
    };

    // ---- 任务 ----

    pub const spawn = fn (self: *const Self, f: fn (usize) !usize, ctx: usize) ?usize {
        return zx_task_spawn(self.id, f, ctx);
    };

    pub const await = fn (self: *const Self, h: usize) !usize {
        return zx_task_await(self.id, h);
    };

    // 等本实例名下全部任务完成。纯屏障：结果仍用 await(h) 逐个取。
    pub const awaitAll = fn (self: *const Self) !void {
        return zx_task_await_all(self.id);
    };

    pub const cancel = fn (self: *const Self, h: usize) void {
        zx_task_cancel(self.id, h);
    };

    pub const yield = fn (self: *const Self) void {
        zx_task_yield(self.id);
    };

    // ---- 通信：实例自带的无缓冲 rendezvous ----
    // 任务内真停靠（配对直接握手）；根上下文是非阻塞的协作式操作，
    // 没有对手就返回 would_block。载荷是 usize：大值传指针，由调用点
    // (usize)v / (T)bits 自己 cast，castable 表当编译期约束。

    pub const send = fn (self: *const Self, v: usize) !void {
        return zx_task_send(self.id, v);
    };

    pub const recv = fn (self: *const Self) !usize {
        return zx_task_recv(self.id);
    };

    pub const trySend = fn (self: *const Self, v: usize) !void {
        return zx_task_try_send(self.id, v);
    };

    pub const tryRecv = fn (self: *const Self) !usize {
        return zx_task_try_recv(self.id);
    };

    // ---- select ----
    //
    // br 每 2 项描述一个分支 [kind, arg]，which 出参写胜者索引，ms 是整体
    // 超时。同时就绪时索引小者胜（确定性）；返回胜者的值。
    //   var which: usize = 0;
    //   let br = &.{ Task.SEL_AWAIT, h, Task.SEL_RECV, 0 };
    //   if (t.select(br, 2, 100, &which)) v { ... } else e { ... }

    // select 分支种类：br 每 2 个 usize 是 [kind, arg]。
    pub const SEL_AWAIT: usize = 0;   // arg = 任务句柄
    pub const SEL_RECV: usize = 1;    // arg = 0 即实例默认通道

    pub const select = fn (self: *const Self, br: *const usize, n: usize, ms: usize, which: *usize) !usize {
        return zx_sel_wait(self.id, br, n, ms, which);
    };

    // ---- 内核线程组：工厂方法 ----
    //
    // 与实例形态互补：实例是「物理隔离的用户态调度器」，组是「零设施的
    // 内核调度」—— 不建线程池、不建队列、不锁任何东西，spawn 即起一条
    // OS 线程。适合即发即忘的批量工作；要结果、要取消、要通道用实例。
    // 组不占实例资源：入口是 Task.group() 工厂，生成的 Group 实例自带
    // spawn/wait/run/close，不在 Task 实例命名空间里。

    pub const group = fn () Group {
        return Group{ .id = zx_tg_new() };
    };

    // ---- 生命周期 ----

    pub const close = fn (self: *const Self) void {
        zx_task_close(self.id);
    };
};
