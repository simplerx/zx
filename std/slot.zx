// slot.zx —— §130 运行时 side table（世代槽位表）。
//
// 编译期状态机只能证明「作废事件在源码里可见、provenance 没断」的那部分
// （见 decisions §131）。循环里同一分配点反复发行、跨函数 / C 边界 /
// 跨线程的指针，交给这张表在运行时兜。两者不是二选一，是同一套 slot
// 语义的两个时态。
//
// 形状：SoA 三列平行数组，不是 [Header][payload]。
//     gens : *[cap]u64   每个槽的世代号，free 一次 +1
//     alive: *[cap]u8    0=空闲 1=在用 2=退役（gen 回绕）
//     ptr  : *[cap]*u8   纯地址；free 不用 p - HDR，块头为 0
// 三列全是私有字段（容器字段默认私有，跨文件访问报 E0404）；对外只发
// Handle，读写与释放一律走 get/free —— 中介不可绕过，否则整套检查失效。
//
// Handle 带 pool id：A 池句柄落到 B 池表上，idx 合法且 gen 恰好相同
// 也不能通过。gen 单调递增；u64 回绕到 0 就把该槽永久退役，不赌概率。
// alive 防二次释放，gen 防 ABA（free 后同槽重分配、旧句柄来访），
// 两者不冗余。
//
// 用法（完整回归见 tests/good/slot-table.zx）：
//     const Table = std.slot.SlotTable(Node, 64);
//     var t = Table.init(std.heap.page);
//     if (t.create()) h {
//         if (t.get(h)) p { p.0 = ...; }
//         t.free(h);
//     }
//     let leaked = t.deinit();   // 返回还没还的槽数（debug 区间末巡检）
//
// 注意：三个能力给的是 fail-safe 拒绝，不是让程序变正确。表本身占内存
// 且与池同生命周期；「不需要头块」成立，「不需要任何元数据」不成立。

// 池标识从 1 起，0 留给「表已关闭」。模块级 var 是静态存储。
var g_next_pool: u64 = 1;

// 句柄是值，不是胖指针：不含地址成分；字段私有，外部只能持有 / 传递。
pub const Handle = struct {
    pool: u64,
    pos: usize,
    gen: u64,
};

pub const SlotTable = fn (T: type, cap: usize) type {
    return struct {
        gens: *[cap]u64,
        alive: *[cap]u8,
        ptr: *[cap]*u8,
        pool: u64,
        alloc: Allocator,

        // std 内部模块不能自引用 `std.heapAlloc`（循环依赖），直接走
        // Allocator.alloc；与 arena / BufReader 一样返回 ?Self，失败回滚。
        pub const init = fn (alloc: Allocator) ?Self {
            let graw = alloc.alloc(alloc.ctx, cap * @type(u64).size);
            if (graw) g {
                let araw = alloc.alloc(alloc.ctx, cap);
                if (araw) av {
                    let praw = alloc.alloc(alloc.ctx, cap * @type(*u8).size);
                    if (praw) pv {
                        let id = g_next_pool;
                        g_next_pool = g_next_pool + 1;
                        var s = Self{
                            .gens = (*[cap]u64)g,
                            .alive = (*[cap]u8)av,
                            .ptr = (*[cap]*u8)pv,
                            .pool = id,
                            .alloc = alloc,
                        };
                        for (0..cap) i {
                            s.gens[i] = 1;
                            s.alive[i] = 0;
                            s.ptr[i] = null;
                        }
                        return s;
                    }
                    alloc.free(alloc.ctx, av, cap);
                }
                alloc.free(alloc.ctx, g, cap * @type(u64).size);
            }
            return null;
        };

        // 唯一的合法性判据。pool=0 表示 deinit 过：之后所有操作一律拒绝，
        // 不去解引用已经归还的列（std.pool 在 deinit 后是空指针解引用）。
        const valid = fn (self: *Self, h: Handle) bool {
            if (self.pool == 0) { return false; }
            if (h.pool != self.pool) { return false; }
            if (h.pos >= cap) { return false; }
            if (self.alive[h.pos] != 1) { return false; }
            if (self.gens[h.pos] != h.gen) { return false; }
            return true;
        };

        // 发行：找空闲槽、向分配器要一个 T、登记纯地址。
        pub const create = fn (self: *Self) ?Handle {
            if (self.pool == 0) { return null; }
            var i: usize = 0;
            while (i < cap) {
                if (self.alive[i] == 0) {
                    let raw = self.alloc.alloc(self.alloc.ctx, @type(T).size);
                    if (raw) p {
                        self.ptr[i] = p;
                        self.alive[i] = 1;
                        return Handle{ .pool = self.pool, .pos = i, .gen = self.gens[i] };
                    }
                    return null;
                }
                i = i + 1;
            }
            return null;             // 表满：不扩容，容量是编译期给定的
        };

        // 唯一的取地址通道。外部永远拿不到 ptr[] 那一列。
        pub const get = fn (self: *Self, h: Handle) ?*T {
            if (!self.valid(h)) { return null; }
            return (*T)self.ptr[h.pos];
        };

        // 作废：先归还对象，再递增 gen。二次释放时 gen 已变，valid 拒绝。
        pub const free = fn (self: *Self, h: Handle) bool {
            if (!self.valid(h)) { return false; }
            let i = h.pos;
            self.alloc.free(self.alloc.ctx, self.ptr[i], @type(T).size);
            let ng = self.gens[i] + 1;
            if (ng == 0) {
                self.alive[i] = 2;   // u64 回绕：槽永久退役，不赌「到不了」
            } else {
                self.gens[i] = ng;
                self.alive[i] = 0;
            }
            self.ptr[i] = null;
            return true;
        };

        // 区间末巡检：数出还活着的槽。分不清「故意长命」和「忘了还」，
        // 所以只做可观测，不报诊断（与编译期账本的口径一致）。
        pub const liveCount = fn (self: *Self) usize {
            if (self.pool == 0) { return 0; }
            var n: usize = 0;
            for (0..cap) i {
                if (self.alive[i] == 1) { n = n + 1; }
            }
            return n;
        };

        // 整批清算：活槽逐个归还对象，再三列一起还给分配器。
        // 返回未释放数，debug 构建里由调用方/ledger 展示。
        pub const deinit = fn (self: *Self) usize {
            if (self.pool == 0) { return 0; }
            var leaked: usize = 0;
            for (0..cap) i {
                if (self.alive[i] == 1) {
                    leaked = leaked + 1;
                    self.alloc.free(self.alloc.ctx, self.ptr[i], @type(T).size);
                    self.alive[i] = 0;
                    self.ptr[i] = null;
                }
            }
            self.alloc.free(self.alloc.ctx, (*u8)self.gens, cap * @type(u64).size);
            self.alloc.free(self.alloc.ctx, (*u8)self.alive, cap);
            self.alloc.free(self.alloc.ctx, (*u8)self.ptr, cap * @type(*u8).size);
            self.gens = null;
            self.alive = null;
            self.ptr = null;
            self.pool = 0;
            return leaked;
        };
    };
};
