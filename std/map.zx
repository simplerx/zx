// map.zx —— 哈希表。键是 `[]const u8`，值可以是任意类型。
//
// 结构：开放寻址 + 线性探测。容量是 2 的幂，负载超过 3/4 就翻倍。
// 键**不复制**：表里存的是切片本身，所以字符串要比表活得久
// （字面量、或调用方自己管着的缓冲区都行）。
//
// 没有 remove：要删就重建一张表。省略它是为了让探测链里没有墓碑——
// 少一个状态，少一类 bug。

const str = module("str.zx");

// FNV-1a 64 位。溢出是 u64 回绕（C 里定义良好的那种），不是错误。
pub fn fnv1a(s: []const u8) u64 {
    var h: u64 = 14695981039346656037;
    var i: usize = 0;
    while (i < s.len) {
        h = h ^ (u64)s[i];
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
}

pub const HashMap = fn (V: type) type {
    return struct {
        keys: *?[]const u8,     // 每格一个可空切片：null = 空槽
        vals: *V,
        n: usize,               // 已占用的槽数
        cap: usize,             // 总槽数：0 或 2 的幂
        alloc: Allocator,

        // ---- 构造 / 释放 ----

        fn init(alloc: Allocator) Self {
            return Self{ .keys = undefined, .vals = undefined, .n = 0, .cap = 0, .alloc = alloc };
        }

        fn deinit(self: *Self) void {
            if (self.cap > 0) {
                self.alloc.free((*u8)self.keys, self.cap * @sizeOf(?[]const u8));
                self.alloc.free((*u8)self.vals, self.cap * @sizeOf(V));
            }
            self.keys = undefined;
            self.vals = undefined;
            self.n = 0;
            self.cap = 0;
        }

        // ---- 规模 ----

        fn count(self: *Self) usize { return self.n; }
        fn capacity(self: *Self) usize { return self.cap; }
        fn empty(self: *Self) bool { return self.n == 0; }

        // ---- 查找 ----

        // 命中返回它的下标；没命中返回第一个空槽——也就是插入点。
        fn slotFor(self: *Self, key: []const u8, h: u64) usize {
            let mask = self.cap - 1;
            var i = (usize)h & mask;
            var probes: usize = 0;
            while (probes <= mask) {
                let cur = (self.keys + i).0;
                if (cur) k {
                    if (str.eq(k, key)) { return i; }
                } else {
                    return i;
                }
                i = (i + 1) & mask;
                probes = probes + 1;
            }
            return i;               /* 表满（不会发生：负载上限 3/4） */
        }

        fn get(self: *Self, key: []const u8) ?V {
            if (self.cap == 0) { return null; }
            let i = self.slotFor(key, fnv1a(key));
            let cur = (self.keys + i).0;
            if (cur) k {
                if (str.eq(k, key)) { return (self.vals + i).0; }
            }
            return null;
        }

        fn contains(self: *Self, key: []const u8) bool {
            if (self.cap == 0) { return false; }
            let i = self.slotFor(key, fnv1a(key));
            let cur = (self.keys + i).0;
            if (cur) k {
                if (str.eq(k, key)) { return true; }
            }
            return false;
        }

        // 取指针：已经存在就直接改它，省一次查找。
        fn getPtr(self: *Self, key: []const u8) ?*V {
            if (self.cap == 0) { return null; }
            let i = self.slotFor(key, fnv1a(key));
            let cur = (self.keys + i).0;
            if (cur) k {
                if (str.eq(k, key)) { return self.vals + i; }
            }
            return null;
        }

        // ---- 写入 ----

        fn put(self: *Self, key: []const u8, val: V) bool {
            if (self.cap == 0 || (self.n + 1) * 4 > self.cap * 3) {
                if (!self.grow()) { return false; }
            }
            let i = self.slotFor(key, fnv1a(key));
            let cur = (self.keys + i).0;
            if (cur) k {
                if (str.eq(k, key)) {
                    (self.vals + i).0 = val;
                    return true;
                }
            }
            (self.keys + i).0 = key;
            (self.vals + i).0 = val;
            self.n = self.n + 1;
            return true;
        }

        // 只在键不存在时写入；已存在就返回它原来的值。
        fn putNew(self: *Self, key: []const u8, val: V) ?V {
            if (self.cap != 0) {
                let old = self.get(key);
                if (old) v { return v; }
            }
            if (!self.put(key, val)) { return val; }
            return null;
        }

        fn clear(self: *Self) void {
            var i: usize = 0;
            while (i < self.cap) {
                (self.keys + i).0 = null;
                i = i + 1;
            }
            self.n = 0;
        }

        // ---- 遍历 ----

        // 槽下标从 0 到 capacity()-1；空槽返回 null，跳过即可。
        fn keyAt(self: *Self, i: usize) ?[]const u8 {
            if (i >= self.cap) { return null; }
            return (self.keys + i).0;
        }

        fn valueAt(self: *Self, i: usize) ?V {
            if (i >= self.cap) { return null; }
            if ((self.keys + i).0) k { return (self.vals + i).0; }
            return null;
        }

        // ---- 扩容 ----

        fn grow(self: *Self) bool {
            let ncap: usize = if (self.cap == 0) 8 else self.cap * 2;
            let kb = ncap * @sizeOf(?[]const u8);
            let nk = self.alloc.alloc(kb);
            if (nk) nkp {
                let vb = ncap * @sizeOf(V);
                let nv = self.alloc.alloc(vb);
                if (nv) nvp {
                    let nkeys = (*?[]const u8)nkp;
                    let nvals = (*V)nvp;

                    var j: usize = 0;
                    while (j < ncap) {
                        (nkeys + j).0 = null;
                        j = j + 1;
                    }

                    let mask = ncap - 1;
                    var i: usize = 0;
                    while (i < self.cap) {
                        let cur = (self.keys + i).0;
                        if (cur) k {
                            var t = (usize)fnv1a(k) & mask;
                            var done = false;
                            while (!done) {
                                let probe = (nkeys + t).0;
                                if (probe) q {
                                    if (str.eq(q, k)) { done = true; }
                                    else { t = (t + 1) & mask; }
                                } else {
                                    done = true;
                                }
                            }
                            (nkeys + t).0 = k;
                            (nvals + t).0 = (self.vals + i).0;
                        }
                        i = i + 1;
                    }

                    if (self.cap > 0) {
                        self.alloc.free((*u8)self.keys, self.cap * @sizeOf(?[]const u8));
                        self.alloc.free((*u8)self.vals, self.cap * @sizeOf(V));
                    }
                    self.keys = nkeys;
                    self.vals = nvals;
                    self.cap = ncap;
                    return true;
                }
                self.alloc.free(nkp, kb);
            }
            return false;
        }
    };
};
