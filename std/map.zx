// map.zx —— 哈希表。键是 `[]const u8`，值可以是任意类型。
//
// 结构：开放寻址 + 线性探测。容量是 2 的幂，负载超过 3/4 就翻倍。
// 键**不复制**：表里存的是切片本身，所以字符串要比表活得久
// （字面量、或调用方自己管着的缓冲区都行）。
//
// 每个槽额外存一份 64 位哈希（hashes 数组，0 = 空槽）：
//   - 探测时先比哈希，哈希不同不用碰字符串——热点路径少一次访存
//     （8 字节的哈希数组 vs 16 字节的切片）和一次 str.eq；
//   - 扩容重排不重算哈希、也不做键比较——键在旧表里本来就唯一，
//     新表里找第一个空槽放进去就是正确的线性探测结果；
//   - clear 是一次 memset，不是逐槽清。
//
// 删除用墓碑（hashes[i] == DELETED）：直接清空会把同一条探测链上后面的
// 键截断，所以删掉的位置必须保留成"链还在走、这里没键"的状态。墓碑在
// 插入时优先复用；扩容重排时丢掉。有效哈希 >= 2，0 = 空槽、1 = 墓碑。

const str = @mod("str.zx");

// 槽状态：0 空，1 墓碑，>= 2 是规范后的有效哈希。
const DELETED: u64 = 1;

// FNV-1a 64 位。溢出是 u64 回绕（C 里定义良好的那种），不是错误。
pub const fnv1a = fn (s: []const u8) u64 {
    var h: u64 = 14695981039346656037;
    var i: usize = 0;
    while (i < s.len) {
        h = h ^ (u64)s[i];
        h = h * 1099511628211;
        i = i + 1;
    }
    return h;
};

pub const HashMap = struct (V: type) {
        keys: *[]const u8,      // 每格一个切片；空不空看 hashes
        hashes: *u64,           // 每格一个哈希：0 = 空槽（FNV 结果为 0 时存 1）
        vals: *V,
        n: usize,               // 已占用的槽数
        cap: usize,             // 总槽数：0 或 2 的幂
        alloc: Allocator,

        // ---- 构造 / 释放 ----

        pub const init = fn (alloc: Allocator) Self {
            return Self{ .keys = undefined, .hashes = undefined, .vals = undefined,
                         .n = 0, .cap = 0, .alloc = alloc };
        };

        pub const deinit = fn (self: *Self) void {
            if (self.cap > 0) {
                self.alloc.free(self.alloc.ctx, (*u8)self.keys, self.cap * @type([]const u8).size);
                self.alloc.free(self.alloc.ctx, (*u8)self.hashes, self.cap * @type(u64).size);
                self.alloc.free(self.alloc.ctx, (*u8)self.vals, self.cap * @type(V).size);
            }
            self.keys = undefined;
            self.hashes = undefined;
            self.vals = undefined;
            self.n = 0;
            self.cap = 0;
        };

        // ---- 规模 ----

        pub const count = fn (self: *Self) usize { return self.n; };
        pub const capacity = fn (self: *Self) usize { return self.cap; };
        const empty = fn (self: *Self) bool { return self.n == 0; };

        // ---- 查找 ----

        // 找已有键：空槽说明链到此为止，墓碑要继续往后探。
        const findSlot = fn (self: *Self, key: []const u8, h: u64) ?usize {
            let mask = self.cap - 1;
            var i = (usize)h & mask;
            var probes: usize = 0;
            while (probes <= mask) {
                let sh = (self.hashes + i).0;
                if (sh == 0) { return null; }
                if (sh >= 2 and sh == h and str.eq((self.keys + i).0, key)) { return i; }
                i = (i + 1) & mask;
                probes = probes + 1;
            }
            return null;
        };

        // 找插入点：记下第一块墓碑继续走，命中已有键就返回它，遇到空槽时
        // 优先复用墓碑（复用后探测链仍然完整）。
        const insertSlot = fn (self: *Self, key: []const u8, h: u64) usize {
            let mask = self.cap - 1;
            var i = (usize)h & mask;
            var tomb: usize = self.cap;       // cap 是"没有墓碑"的哨兵
            var probes: usize = 0;
            while (probes <= mask) {
                let sh = (self.hashes + i).0;
                if (sh == 0) {
                    if (tomb != self.cap) { return tomb; }
                    return i;
                }
                if (sh == DELETED) {
                    if (tomb == self.cap) { tomb = i; }
                } else if (sh == h and str.eq((self.keys + i).0, key)) {
                    return i;
                }
                i = (i + 1) & mask;
                probes = probes + 1;
            }
            if (tomb != self.cap) { return tomb; }
            return i;               /* 表满（不会发生：负载上限 3/4） */
        };

        // FNV 结果可能是 0 或 1，而它们是空槽 / 墓碑哨兵——压到 2。
        const norm = fn (h: u64) u64 { return if (h < 2) 2 else h; };

        pub const get = fn (self: *Self, key: []const u8) ?V {
            if (self.cap == 0) { return null; }
            if (self.findSlot(key, Self.norm(fnv1a(key)))) i { return (self.vals + i).0; }
            return null;
        };

        pub const contains = fn (self: *Self, key: []const u8) bool {
            if (self.cap == 0) { return false; }
            if (self.findSlot(key, Self.norm(fnv1a(key)))) _ { return true; }
            return false;
        };

        // 取指针：已经存在就直接改它，省一次查找。
        pub const getPtr = fn (self: *Self, key: []const u8) ?*V {
            if (self.cap == 0) { return null; }
            if (self.findSlot(key, Self.norm(fnv1a(key)))) i { return self.vals + i; }
            return null;
        };

        // ---- 写入 ----

        pub const put = fn (self: *Self, key: []const u8, val: V) bool {
            if (self.cap == 0 or (self.n + 1) * 4 > self.cap * 3) {
                if (!self.grow()) { return false; }
            }
            let h = Self.norm(fnv1a(key));
            let i = self.insertSlot(key, h);
            let existed = (self.hashes + i).0 >= 2;
            (self.keys + i).0 = key;
            (self.vals + i).0 = val;
            (self.hashes + i).0 = h;
            if (!existed) { self.n = self.n + 1; }
            return true;
        };

        // 只在键不存在时写入；已存在就返回它原来的值。
        // 一次探测同时完成"查旧"和"插入"，不像 get+put 那样哈希两遍。
        pub const putNew = fn (self: *Self, key: []const u8, val: V) ?V {
            if (self.cap == 0 or (self.n + 1) * 4 > self.cap * 3) {
                if (!self.grow()) { return val; }       // 扩容失败：写入没有发生
            }
            let h = Self.norm(fnv1a(key));
            let i = self.insertSlot(key, h);
            if ((self.hashes + i).0 >= 2) { return (self.vals + i).0; }
            (self.keys + i).0 = key;
            (self.vals + i).0 = val;
            (self.hashes + i).0 = h;
            self.n = self.n + 1;
            return null;
        };

        // 删掉键。命中返回 true。位置留成墓碑，保住同一条探测链上后续键
        // 的可达性；新插入会优先复用墓碑。count() 立即反映删除结果。
        pub const remove = fn (self: *Self, key: []const u8) bool {
            if (self.cap == 0) { return false; }
            if (self.findSlot(key, Self.norm(fnv1a(key)))) i {
                (self.hashes + i).0 = DELETED;
                self.n = self.n - 1;
                return true;
            }
            return false;
        };

        pub const clear = fn (self: *Self) void {
            if (self.cap > 0) {
                @memset((*u8)self.hashes, 0, self.cap * @type(u64).size);
            }
            self.n = 0;
        };

        // ---- 遍历 ----

        // 槽下标从 0 到 capacity()-1；空槽返回 null，跳过即可。
        pub const keyAt = fn (self: *Self, i: usize) ?[]const u8 {
            if (i >= self.cap or (self.hashes + i).0 < 2) { return null; }
            return (self.keys + i).0;
        };

        pub const valueAt = fn (self: *Self, i: usize) ?V {
            if (i >= self.cap or (self.hashes + i).0 < 2) { return null; }
            return (self.vals + i).0;
        };

        // ---- 扩容 ----

        const grow = fn (self: *Self) bool {
            let ncap: usize = if (self.cap == 0) 8 else self.cap * 2;
            let hsz = ncap * @type(u64).size;
            let nh = self.alloc.alloc(self.alloc.ctx, hsz);
            if (nh) nhp {
                let kb = ncap * @type([]const u8).size;
                let nk = self.alloc.alloc(self.alloc.ctx, kb);
                if (nk) nkp {
                    let vb = ncap * @type(V).size;
                    let nv = self.alloc.alloc(self.alloc.ctx, vb);
                    if (nv) nvp {
                        let nhashes = (*u64)nhp;
                        let nkeys = (*[]const u8)nkp;
                        let nvals = (*V)nvp;

                        @memset((*u8)nhashes, 0, hsz);

                        // 键在旧表里本来就唯一：新表里找第一个空槽放进去，
                        // 就是正确的线性探测结果——不重算哈希、不比字符串。
                        // 墓碑不搬过去：扩容正好把删除留下的链垃圾清掉。
                        let mask = ncap - 1;
                        var i: usize = 0;
                        while (i < self.cap) {
                            let h = (self.hashes + i).0;
                            if (h >= 2) {
                                var t = (usize)h & mask;
                                while ((nhashes + t).0 != 0) {
                                    t = (t + 1) & mask;
                                }
                                (nhashes + t).0 = h;
                                (nkeys + t).0 = (self.keys + i).0;
                                (nvals + t).0 = (self.vals + i).0;
                            }
                            i = i + 1;
                        }

                        if (self.cap > 0) {
                            self.alloc.free(self.alloc.ctx, (*u8)self.keys, self.cap * @type([]const u8).size);
                            self.alloc.free(self.alloc.ctx, (*u8)self.hashes, self.cap * @type(u64).size);
                            self.alloc.free(self.alloc.ctx, (*u8)self.vals, self.cap * @type(V).size);
                        }
                        self.keys = nkeys;
                        self.hashes = nhashes;
                        self.vals = nvals;
                        self.cap = ncap;
                        return true;
                    }
                    self.alloc.free(self.alloc.ctx, nkp, kb);
                }
                self.alloc.free(self.alloc.ctx, nhp, hsz);
            }
            return false;
        };
};
