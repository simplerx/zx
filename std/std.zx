// std.zx —— 标准库。编译器随附这个文件（std/ 目录），`module("std")` 就是在读它。
//
// 这个文件里能用的"魔法"只有三样，全部来自编译器：
//   print / println / format   打印与格式化
//   heap.page                  现成的分配器（malloc/free）
//   file / io                  整块读写文件 / 带句柄的分次读写
// 其余都是普通 Zx 代码——包括下面这个可增长数组和两个缓冲流。

// 字符串工具（str.zx）。`std.str.eq(a, b)`、`std.str.split(alloc, s, ",")` 之类。
pub const str = module("str.zx");

// 哈希表（map.zx）。`std.HashMap(i32)` 就是"字符串键 → i32"的表；
// 下面这行是普通的名字别名，不是特殊的导出语法。
pub const map = module("map.zx");
pub const HashMap = map.HashMap;

// 可增长数组。`T` 是元素类型；容量不够时按倍数向分配器要内存、搬过去、释放旧的。
pub const ArrayList = fn (T: type) type {
    return struct {
        buf: *T,
        len: usize,
        cap: usize,
        alloc: Allocator,

        // ---- 构造 / 释放 ----

        const init = fn (alloc: Allocator) Self {
            return Self{ .buf = undefined, .len = 0, .cap = 0, .alloc = alloc };
        };

        const deinit = fn (self: *Self) void {
            if (self.cap > 0) {
                self.alloc.free((*u8)self.buf, self.cap * @sizeOf(T));
            }
            self.buf = undefined;
            self.len = 0;
            self.cap = 0;
        };

        // ---- 取值 ----

        const at = fn (self: *Self, i: usize) ?*T {
            if (i >= self.len) { return null; }
            return self.buf + i;
        };

        const get = fn (self: *Self, i: usize) ?T {
            if (i >= self.len) { return null; }
            return (self.buf + i).0;
        };

        const set = fn (self: *Self, i: usize, v: T) bool {
            if (i >= self.len) { return false; }
            (self.buf + i).0 = v;
            return true;
        };

        const items = fn (self: *Self) []T { return self.buf[0..self.len]; };

        const clear = fn (self: *Self) void { self.len = 0; };

        // ---- 增长 ----

        // 容量不够就翻倍。搬家用一次 memcpy：T 任意大小，逐元素循环
        // 换成内存原语后这一步从 O(n) 次访存变成一次批量搬运。
        const reserve = fn (self: *Self, need: usize) bool {
            if (need <= self.cap) { return true; }

            var ncap = self.cap;
            if (ncap == 0) { ncap = 8; }
            while (ncap < need) { ncap = ncap * 2; }

            let bytes = ncap * @sizeOf(T);
            let raw = self.alloc.alloc(bytes);
            if (raw) p {
                let dst = (*T)p;
                if (self.len > 0) {
                    @memcpy((*u8)dst, (*u8)self.buf, self.len * @sizeOf(T));
                }
                if (self.cap > 0) {
                    self.alloc.free((*u8)self.buf, self.cap * @sizeOf(T));
                }
                self.buf = dst;
                self.cap = ncap;
                return true;
            }
            return false;
        };

        const push = fn (self: *Self, v: T) bool {
            if (!self.reserve(self.len + 1)) { return false; }
            (self.buf + self.len).0 = v;
            self.len = self.len + 1;
            return true;
        };

        const pop = fn (self: *Self) ?T {
            if (self.len == 0) { return null; }
            self.len = self.len - 1;
            return (self.buf + self.len).0;
        };

        const first = fn (self: *Self) ?T {
            if (self.len == 0) { return null; }
            return (self.buf + 0).0;
        };

        const last = fn (self: *Self) ?T {
            if (self.len == 0) { return null; }
            return (self.buf + self.len - 1).0;
        };

        // 在 i 处插一个，后面的整体右移（memmove：同 buffer 内重叠）。
        // i == len 等价于 push。
        const insertAt = fn (self: *Self, i: usize, v: T) bool {
            if (i > self.len) { return false; }
            if (!self.reserve(self.len + 1)) { return false; }
            if (i < self.len) {
                @memmove((*u8)(self.buf + i + 1), (*u8)(self.buf + i),
                         (self.len - i) * @sizeOf(T));
            }
            (self.buf + i).0 = v;
            self.len = self.len + 1;
            return true;
        };

        // 删掉第 i 个，后面的左移。删最后一个等价于 pop。
        const removeAt = fn (self: *Self, i: usize) bool {
            if (i >= self.len) { return false; }
            if (i + 1 < self.len) {
                @memmove((*u8)(self.buf + i), (*u8)(self.buf + i + 1),
                         (self.len - i - 1) * @sizeOf(T));
            }
            self.len = self.len - 1;
            return true;
        };

        const reverse = fn (self: *Self) void {
            if (self.len < 2) { return; }
            var i: usize = 0;
            var j = self.len - 1;
            while (i < j) {
                let t = (self.buf + i).0;
                (self.buf + i).0 = (self.buf + j).0;
                (self.buf + j).0 = t;
                i = i + 1;
                j = j - 1;
            }
        };

        // 把长度改成 n：变长用 fill 补，变短直接截断（容量不动）。
        const resize = fn (self: *Self, n: usize, fill: T) bool {
            if (n > self.len) {
                if (!self.reserve(n)) { return false; }
                var k = self.len;
                while (k < n) {
                    (self.buf + k).0 = fill;
                    k = k + 1;
                }
            }
            self.len = n;
            return true;
        };

        // 就地交换两个元素。
        const swap = fn (self: *Self, i: usize, j: usize) bool {
            if (i >= self.len || j >= self.len) { return false; }
            let t = (self.buf + i).0;
            (self.buf + i).0 = (self.buf + j).0;
            (self.buf + j).0 = t;
            return true;
        };

        // 追加一个切片：一次 memcpy。
        const append = fn (self: *Self, vs: []const T) bool {
            if (vs.len == 0) { return true; }
            if (!self.reserve(self.len + vs.len)) { return false; }
            @memcpy((*u8)(self.buf + self.len), vs.ptr, vs.len * @sizeOf(T));
            self.len = self.len + vs.len;
            return true;
        };
    };
};

// ---- 缓冲流 ----
//
// std.file 是"整块读、整块写"：一次 fread 到分配好的缓冲区里。
// 逐行处理大文件时那样太重——每读一行就要把整个文件搬一遍。
// io 给的是句柄（open / read / write / close），下面两个结构在它上面加一层缓冲：
//   BufReader  一次向文件要 cap 字节，按行切出来（行还指向缓冲，不复制）
//   BufWriter  攒满 cap 字节才真正写一次
//
// 缓冲层用普通 Zx 代码写，编译器只提供句柄原语——这样"缓冲多大、怎么切行"
// 都留在库里，改起来不用动编译器。

// 一次读一块、按行交付。切出来的行**指向内部缓冲**，下一次 next() 之后失效；
// 要留住就自己复制。行比缓冲还长时缓冲会翻倍（`grow`），所以不会读一半断掉。
pub const BufReader = struct {
    h: usize,
    buf: *u8,
    cap: usize,
    start: usize,     // 已消费到的位置
    end: usize,       // 缓冲里有效数据的末尾
    eof: bool,
    owned: bool,      // 句柄是不是自己开的（deinit 时负责关）
    alloc: Allocator,

    const init = fn (alloc: Allocator, h: usize, cap: usize) ?Self {
        var n = cap;
        if (n < 16) { n = 16; }
        let raw = alloc.alloc(n);
        if (raw) p {
            return Self{ .h = h, .buf = p, .cap = n, .start = 0, .end = 0,
                         .eof = false, .owned = false, .alloc = alloc };
        }
        return null;
    };

    // 开文件 + 建缓冲，一步到位。路径打不开就返回 null。
    const open = fn (alloc: Allocator, path: []const u8, cap: usize) ?Self {
        if (io.openRead(path)) h {
            if (Self.init(alloc, h, cap)) got {
                var r = got;
                r.owned = true;
                return r;
            }
            io.close(h);
        }
        return null;
    };

    const deinit = fn (self: *Self) void {
        if (self.owned) { io.close(self.h); }
        self.alloc.free(self.buf, self.cap);
        self.buf = undefined;
        self.cap = 0;
        self.start = 0;
        self.end = 0;
    };

    const close = fn (self: *Self) void { self.deinit(); };

    // 缓冲里的数据用完、又还没到文件尾 → 再要一块。
    // 行跨块时先把残段挪到最前面，腾出空间；整块都不够就翻倍。
    const fill = fn (self: *Self) bool {
        if (self.start == self.end) {
            /* 缓冲已经全部交付完了：从头再来，别把它当成"残段"挤到前面 */
            self.start = 0;
            self.end = 0;
        } else if (self.start > 0) {
            var i = self.start;
            var j: usize = 0;
            while (i < self.end) {
                (self.buf + j).0 = (self.buf + i).0;
                i = i + 1;
                j = j + 1;
            }
            self.end = self.end - self.start;
            self.start = 0;
        }
        if (self.end == self.cap) {
            if (!self.grow()) { return false; }
        }
        let n = io.read(self.h, self.buf[self.end..self.cap]);
        if (n == 0) { return false; }
        self.end = self.end + n;
        return true;
    };

    const grow = fn (self: *Self) bool {
        let ncap = self.cap * 2;
        let raw = self.alloc.alloc(ncap);
        if (raw) p {
            var i: usize = 0;
            while (i < self.end) {
                (p + i).0 = (self.buf + i).0;
                i = i + 1;
            }
            self.alloc.free(self.buf, self.cap);
            self.buf = p;
            self.cap = ncap;
            return true;
        }
        return false;
    };

    // 下一行（去掉行尾的 \n 和 \r）。文件结束且没有残行时返回 null。
    const next = fn (self: *Self) ?[]const u8 {
        while (true) {
            var i = self.start;
            while (i < self.end) {
                if ((self.buf + i).0 == '\n') {
                    var stop = i;
                    if (stop > self.start && (self.buf + stop - 1).0 == '\r') { stop = stop - 1; }
                    let line = self.buf[self.start..stop];
                    self.start = i + 1;
                    return line;
                }
                i = i + 1;
            }
            if (self.eof) {
                if (self.start == self.end) { return null; }
                let line = self.buf[self.start..self.end];
                self.start = self.end;
                return line;
            }
            if (!self.fill()) { self.eof = true; }
        }
    };

    // 下一块原始字节（不切行）。适合读二进制。
    const chunk = fn (self: *Self) ?[]const u8 {
        while (self.start == self.end) {
            if (self.eof) { return null; }
            if (!self.fill()) { self.eof = true; }
        }
        let out = self.buf[self.start..self.end];
        self.start = self.end;
        return out;
    };

    // 还剩多少字节没消费（当前缓冲里）
    const buffered = fn (self: *Self) usize { return self.end - self.start; };
};

// 攒够再写。write 超过缓冲大小就直接写出去，不绕道。
pub const BufWriter = struct {
    h: usize,
    buf: *u8,
    cap: usize,
    len: usize,
    owned: bool,
    alloc: Allocator,

    const init = fn (alloc: Allocator, h: usize, cap: usize) ?Self {
        var n = cap;
        if (n < 16) { n = 16; }
        let raw = alloc.alloc(n);
        if (raw) p {
            return Self{ .h = h, .buf = p, .cap = n, .len = 0,
                         .owned = false, .alloc = alloc };
        }
        return null;
    };

    // 建文件（存在就清空）+ 建缓冲
    const create = fn (alloc: Allocator, path: []const u8, cap: usize) ?Self {
        if (io.openWrite(path)) h {
            if (Self.init(alloc, h, cap)) got {
                var r = got;
                r.owned = true;
                return r;
            }
            io.close(h);
        }
        return null;
    };

    // 追加模式：文件已有的内容不动
    const appendTo = fn (alloc: Allocator, path: []const u8, cap: usize) ?Self {
        if (io.openAppend(path)) h {
            if (Self.init(alloc, h, cap)) got {
                var r = got;
                r.owned = true;
                return r;
            }
            io.close(h);
        }
        return null;
    };

    const deinit = fn (self: *Self) void {
        if (self.len > 0) { self.flush(); }
        if (self.owned) { io.close(self.h); }
        self.alloc.free(self.buf, self.cap);
        self.buf = undefined;
        self.cap = 0;
        self.len = 0;
    };

    const flush = fn (self: *Self) bool {
        if (self.len == 0) { return true; }
        let want = self.len;
        self.len = 0;
        return io.write(self.h, self.buf[0..want]) == want;
    };

    const write = fn (self: *Self, data: []const u8) bool {
        // 大块直接落盘：占满缓冲再 flush 反而多一次拷贝
        if (data.len >= self.cap) {
            if (!self.flush()) { return false; }
            return io.write(self.h, data) == data.len;
        }
        if (self.len + data.len > self.cap) {
            if (!self.flush()) { return false; }
        }
        var i: usize = 0;
        while (i < data.len) {
            (self.buf + self.len + i).0 = data[i];
            i = i + 1;
        }
        self.len = self.len + data.len;
        return true;
    };

    const writeByte = fn (self: *Self, c: u8) bool { return self.write(&.{c}); };

    // 一行：内容 + \n
    const writeLine = fn (self: *Self, s: []const u8) bool {
        if (!self.write(s)) { return false; }
        return self.write(&.{'\n'});
    };

    const pending = fn (self: *Self) usize { return self.len; };
};
