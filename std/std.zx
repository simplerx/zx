// std.zx —— 标准库。编译器随附这个文件（std/ 目录），`@mod("std")` 就是在读它。
//
// 这个文件里能用的"魔法"全部来自编译器：
//   print / println / format   打印与格式化
//   heap.page                  现成的分配器（malloc/free）
//   file / io                  整块读写文件 / 带句柄的分次读写
//   stackAlloc                 编译期常量长度 -> *[N]T（栈，不会失败）
//   heapAlloc                  编译期常量长度 -> ?*[N]T（OOM 返回 null，判空自己来）
//   heapSlice                  运行期长度     -> ?[]T（OOM 返回 null，判空自己来）
//   free(a, s)                 释放（a.deinit(s) 的函数形式，自动算字节量）
// 其余都是普通 Zx 代码——包括下面这个可增长数组和两个缓冲流。

// 字符串工具（str.zx）。`std.str.eq(a, b)`、`std.str.split(alloc, s, ",")` 之类。
pub const str = @mod("str.zx");

// 哈希表（map.zx）。`std.map.HashMap(i32)` 就是"字符串键 → i32"的表。
// 不设 `pub const HashMap = map.HashMap` 这类别名——用户要求：别名和真身
// 分不清，类型只走一条真实路径。下面 pool/arena/task 同此约定。
pub const map = @mod("map.zx");

// 数组（array.zx）。两个类型：可增长列表 std.array.List(T)（原 ArrayList
// 迁来），定长数组 std.array.Array(T, N)——内部 data 是 [N]T 数组值，
// 真正占 N*sizeof(T) 内存，可作为其他类型的成员；下标经 (*[N]T) 视图。
// 不设 std.ArrayList / std.Array 别名——别名和真身分不清，类型只走真实路径。
pub const array = @mod("array.zx");

// 内存池（pool.zx）。`var p = std.pool.Pool.init(std.heap.page)` 之后
// `p.alloc(n)` / `p.free(ptr)`；重复释放会被拦下。Pool 只给单线程用，
// 多线程共用改用 `std.pool.SyncPool.init(...)`：另一个类型，内含 Pool + 锁，
// 同样有 alloc/free/used/allocator，全部加锁。
pub const pool = @mod("pool.zx");

// 文件系统（fs.zx）。路径操作零分配；DirIter 流式遍历；stat/exists 元数据。
pub const fs = @mod("fs.zx");

// JSON（json.zx）。零拷贝解析、最短 round-trip 序列化，arena 友好。
pub const json = @mod("json.zx");

// Arena（arena.zx）。一次性批量分配：`std.arena.ArenaAllocator.init(std.heap.page)`
// 造出 Allocator 喂给 json.parse / std.array.List / 任何吃 Allocator 的东西，
// deinit 一次全释放。ctx 机制下 arena 是有状态分配器的标准实现。
pub const arena = @mod("arena.zx");

// DebugAllocator（debug_alloc.zx）。记账分配器：每次分配都留档，
// 泄漏 / 重复释放 / 野指针当场报出来。`init(std.heap.page)` 造出来的
// 分配器直接喂给 std.array.List / json / fs；`deinit(a)` 收尾。
pub const debug_alloc = @mod("debug_alloc.zx");

// 时间（time.zx）。QPC 单调钟（nsBetween 测耗时）、墙钟、ISO 8601 格式化。
pub const time = @mod("time.zx");

// 任务（task.zx）。对外只有 Task 一个类型：它是接口，coro/single/pool/
// fromId 生成实例，其余能力全是 `t.` 实例方法（分发）。接口只保留任务
// 调度、实例自带的默认通道、select 与内核线程组；作用域 / 命名通道 /
// 定时器不做对外 API（zx 没有接口/多态，见 decisions §128），它们留在
// C 机制层服务唤醒链。Task. 上只剩 SEL_AWAIT / SEL_RECV。
// std.io 保持纯同步，要并发就显式「task + io」。
pub const task = @mod("task.zx");

// 数学（math.zx）。`std.math.sqrt(2.0)` / `std.math.gcd(12,18)`。
// 浮点函数 extern 到 C 运行时的 libm，整数工具是纯 Zx 代码。
pub const math = @mod("math.zx");

// 排序与搜索（sort.zx）。`std.sort.sort(i32, xs, less)` 原地堆排序，
// `std.sort.binarySearch(i32, xs, key, less)` 在有序切片里查 key（重复取第一个）。
// 比较器 `less(a,b)` 由调用方提供：a 严格排在 b 前面时为 true。
pub const sort = @mod("sort.zx");

// 伪随机（random.zx）。Rng 是显式状态，没有全局随机源；shuffle 是顶层泛型
// 函数（容器方法不能带类型参数）。xorshift64*，非密码学用途。
pub const random = @mod("random.zx");

// 断言工具（test.zx）。ok/eqI/eqU/eqStr/near 失败时打印差异并返回 false，
// 调用方自己计数；summary(failed) 直接当 main 的退出码。
pub const test = @mod("test.zx");

// 网络（net.zx）。同步 IPv4 TCP / UDP，Windows Winsock2 先行；
// 用 `std.net.init()` / `deinit()` 包住，句柄由 TcpListener/TcpStream/UdpSocket 拿。
pub const net = @mod("net.zx");

// 向量数学（simd.zx）。语言只给 `@Vec(T, N)` 类型与它的运算符，其余都在
// 这里：度量 / 逐分量 / 掩码 `select` `any` `all`、`cross` / `reflect`、
// 四元数 `Quat`、列主序矩阵 `Mat3` / `Mat4`（含四元数互转、投影与视图）。
// 全是普通函数，没有额外的向量内建；4 分量是这一层的形状（3D 用 xyz +
// w=0），矩阵就是三 / 四列这样的向量。
pub const simd = @mod("simd.zx");

// ---- 缓冲流 ----
//
// std.file 是"整块读、整块写"：一次 fread 到分配好的缓冲区里。
// 逐行处理大文件时那样太重——每读一行就要把整个文件搬一遍。
// io 给的是句柄（open / read / write / close），下面两个结构在它上面加一层缓冲：
//   BufReader  一次向文件要 cap 字节，按行切出来（行还指向缓冲，不复制）
//   BufWriter  攒满 cap 字节才真正写一次
//
// 缓冲层用普通 Zx 代码写，编译器只提供句柄原语——这样"缓冲多大、怎么切行"
// 都留在库里，改起来不用动编译器。

// 一次读一块、按行交付。切出来的行**指向内部缓冲**，下一次 next() 之后失效；
// 要留住就自己复制。行比缓冲还长时缓冲会翻倍（`grow`），所以不会读一半断掉。
pub const BufReader = struct {
    pub h: usize,
    pub buf: *u8,
    pub cap: usize,
    pub start: usize,     // 已消费到的位置
    pub end: usize,       // 缓冲里有效数据的末尾
    pub eof: bool,
    pub owned: bool,      // 句柄是不是自己开的（deinit 时负责关）
    pub alloc: Allocator,

    pub const init = fn (alloc: Allocator, h: usize, cap: usize) ?Self {
        var n = cap;
        if (n < 16) { n = 16; }
        let raw = alloc.alloc(alloc.ctx, n);
        if (raw) p {
            return Self{ .h = h, .buf = p, .cap = n, .start = 0, .end = 0,
                         .eof = false, .owned = false, .alloc = alloc };
        }
        return null;
    };

    // 开文件 + 建缓冲，一步到位。路径打不开就返回 null。
    pub const open = fn (alloc: Allocator, path: []const u8, cap: usize) ?Self {
        if (io.openRead(path)) h {
            if (Self.init(alloc, h, cap)) got {
                var r = got;
                r.owned = true;
                return r;
            }
            io.close(h);
        }
        return null;
    };

    pub const deinit = fn (self: *Self) void {
        if (self.owned) { io.close(self.h); }
        self.alloc.free(self.alloc.ctx, self.buf, self.cap);
        self.buf = undefined;
        self.cap = 0;
        self.start = 0;
        self.end = 0;
    };

    pub const close = fn (self: *Self) void { self.deinit(); };

    // 缓冲里的数据用完、又还没到文件尾 → 再要一块。
    // 行跨块时先把残段挪到最前面，腾出空间；整块都不够就翻倍。
    pub const fill = fn (self: *Self) bool {
        if (self.start == self.end) {
            /* 缓冲已经全部交付完了：从头再来，别把它当成"残段"挤到前面 */
            self.start = 0;
            self.end = 0;
        } else if (self.start > 0) {
            @memmove((*u8)self.buf, (*u8)(self.buf + self.start), self.end - self.start);
            self.end = self.end - self.start;
            self.start = 0;
        }
        if (self.end == self.cap) {
            if (!self.grow()) { return false; }
        }
        let n = io.read(self.h, self.buf[self.end..self.cap]);
        if (n == 0) { return false; }
        self.end = self.end + n;
        return true;
    };

    pub const grow = fn (self: *Self) bool {
        let ncap = self.cap * 2;
        let raw = self.alloc.alloc(self.alloc.ctx, ncap);
        if (raw) p {
            @memcpy(p, self.buf, self.end);
            self.alloc.free(self.alloc.ctx, self.buf, self.cap);
            self.buf = p;
            self.cap = ncap;
            return true;
        }
        return false;
    };

    // 下一行（去掉行尾的 \n 和 \r）。文件结束且没有残行时返回 null。
    pub const next = fn (self: *Self) ?[]const u8 {
        while (true) {
            var i = self.start;
            while (i < self.end) {
                if ((self.buf + i).0 == '\n') {
                    var stop = i;
                    if (stop > self.start and (self.buf + stop - 1).0 == '\r') { stop = stop - 1; }
                    let line = self.buf[self.start..stop];
                    self.start = i + 1;
                    return line;
                }
                i = i + 1;
            }
            if (self.eof) {
                if (self.start == self.end) { return null; }
                let line = self.buf[self.start..self.end];
                self.start = self.end;
                return line;
            }
            if (!self.fill()) { self.eof = true; }
        }
    };

    // 下一块原始字节（不切行）。适合读二进制。
    pub const chunk = fn (self: *Self) ?[]const u8 {
        while (self.start == self.end) {
            if (self.eof) { return null; }
            if (!self.fill()) { self.eof = true; }
        }
        let out = self.buf[self.start..self.end];
        self.start = self.end;
        return out;
    };

    // 还剩多少字节没消费（当前缓冲里）
    pub const buffered = fn (self: *Self) usize { return self.end - self.start; };
};

// 攒够再写。write 超过缓冲大小就直接写出去，不绕道。
pub const BufWriter = struct {
    pub h: usize,
    pub buf: *u8,
    pub cap: usize,
    pub len: usize,
    pub owned: bool,
    pub alloc: Allocator,

    pub const init = fn (alloc: Allocator, h: usize, cap: usize) ?Self {
        var n = cap;
        if (n < 16) { n = 16; }
        let raw = alloc.alloc(alloc.ctx, n);
        if (raw) p {
            return Self{ .h = h, .buf = p, .cap = n, .len = 0,
                         .owned = false, .alloc = alloc };
        }
        return null;
    };

    // 建文件（存在就清空）+ 建缓冲
    pub const create = fn (alloc: Allocator, path: []const u8, cap: usize) ?Self {
        if (io.openWrite(path)) h {
            if (Self.init(alloc, h, cap)) got {
                var r = got;
                r.owned = true;
                return r;
            }
            io.close(h);
        }
        return null;
    };

    // 追加模式：文件已有的内容不动
    pub const appendTo = fn (alloc: Allocator, path: []const u8, cap: usize) ?Self {
        if (io.openAppend(path)) h {
            if (Self.init(alloc, h, cap)) got {
                var r = got;
                r.owned = true;
                return r;
            }
            io.close(h);
        }
        return null;
    };

    pub const deinit = fn (self: *Self) void {
        if (self.len > 0) { _ = self.flush(); }
        if (self.owned) { io.close(self.h); }
        self.alloc.free(self.alloc.ctx, self.buf, self.cap);
        self.buf = undefined;
        self.cap = 0;
        self.len = 0;
    };

    pub const flush = fn (self: *Self) bool {
        if (self.len == 0) { return true; }
        let want = self.len;
        self.len = 0;
        return io.write(self.h, self.buf[0..want]) == want;
    };

    pub const write = fn (self: *Self, data: []const u8) bool {
        // 大块直接落盘：占满缓冲再 flush 反而多一次拷贝
        if (data.len >= self.cap) {
            if (!self.flush()) { return false; }
            return io.write(self.h, data) == data.len;
        }
        if (self.len + data.len > self.cap) {
            if (!self.flush()) { return false; }
        }
        @memcpy((*u8)(self.buf + self.len), data.ptr, data.len);
        self.len = self.len + data.len;
        return true;
    };

    pub const writeByte = fn (self: *Self, c: u8) bool { return self.write(&.{c}); };

    // 一行：内容 + \n
    pub const writeLine = fn (self: *Self, s: []const u8) bool {
        if (!self.write(s)) { return false; }
        return self.write(&.{'\n'});
    };

    pub const pending = fn (self: *Self) usize { return self.len; };
};
