// str.zx —— 字符串（`[]const u8`）工具。全是普通 Zx 代码。
//
//   const std = @mod("std");
//   if (std.str.eq(a, b)) { … }
//
// 不分配的函数直接切片返回；要分配的把分配器放在第一个参数上。

const I64_MAX: i64 = 9223372036854775807;

const isSpace = fn (c: u8) bool {
    return c == 32 or c == 9 or c == 10 or c == 13;
};

// hay[i..i+needle.len] 是不是 needle。调用者必须先保证 i + needle.len <= hay.len：
// 这个函数自己不查越界（它是最内层循环）。
const matchAt = fn (hay: []const u8, i: usize, needle: []const u8) bool {
    var j: usize = 0;
    while (j < needle.len) {
        if (hay[i + j] != needle[j]) { return false; }
        j = j + 1;
    }
    return true;
};

// needle 在 hay 里非重叠出现的次数。空 needle 返回 0（避免无限循环）。
pub const count = fn (hay: []const u8, needle: []const u8) usize {
    if (needle.len == 0 or needle.len > hay.len) { return 0; }
    var n: usize = 0;
    var i: usize = 0;
    while (i + needle.len <= hay.len) {
        if (matchAt(hay, i, needle)) {
            n = n + 1;
            i = i + needle.len;   // 非重叠：命中后跳过整段
        } else {
            i = i + 1;
        }
    }
    return n;
};

pub const eq = fn (a: []const u8, b: []const u8) bool {
    if (a.len != b.len) { return false; }
    var i: usize = 0;
    while (i < a.len) {
        if (a[i] != b[i]) { return false; }
        i = i + 1;
    }
    return true;
};

pub const startsWith = fn (s: []const u8, p: []const u8) bool {
    if (p.len > s.len) { return false; }
    var i: usize = 0;
    while (i < p.len) {
        if (s[i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
};

pub const endsWith = fn (s: []const u8, p: []const u8) bool {
    if (p.len > s.len) { return false; }
    let off = s.len - p.len;
    var i: usize = 0;
    while (i < p.len) {
        if (s[off + i] != p[i]) { return false; }
        i = i + 1;
    }
    return true;
};

pub const indexOfFrom = fn (hay: []const u8, needle: []const u8, from: usize) ?usize {
    if (needle.len == 0) { return from; }
    if (needle.len > hay.len) { return null; }
    var i = from;
    while (i + needle.len <= hay.len) {
        if (matchAt(hay, i, needle)) { return i; }
        i = i + 1;
    }
    return null;
};

pub const indexOf = fn (hay: []const u8, needle: []const u8) ?usize {
    return indexOfFrom(hay, needle, 0);
};

pub const contains = fn (hay: []const u8, needle: []const u8) bool {
    let r = indexOf(hay, needle);
    if (r) _ { return true; }
    return false;
};

// 从开头去掉空白
pub const trimStart = fn (s: []const u8) []const u8 {
    var i: usize = 0;
    while (i < s.len and isSpace(s[i])) { i = i + 1; }
    return s[i..];
};

// 从结尾去掉空白
pub const trimEnd = fn (s: []const u8) []const u8 {
    var n = s.len;
    while (n > 0 and isSpace(s[n - 1])) { n = n - 1; }
    return s[0..n];
};

pub const trim = fn (s: []const u8) []const u8 {
    return trimEnd(trimStart(s));
};

// 十进制整数，允许前面的 + / -。多余字符、空串、溢出都算失败。
pub const parseInt = fn (s: []const u8) ?i64 {
    let t = trim(s);
    if (t.len == 0) { return null; }
    var i: usize = 0;
    var neg = false;
    if (t[0] == 45 or t[0] == 43) {
        neg = (t[0] == 45);
        i = 1;
        if (t.len == 1) { return null; }
    }
    var v: i64 = 0;
    while (i < t.len) {
        let c = t[i];
        if (c < 48 or c > 57) { return null; }
        let d: i64 = (i64)(c - 48);
        if (v > (I64_MAX - d) / 10) { return null; }   /* 溢出：宁可 null，不要乱数 */
        v = v * 10 + d;
        i = i + 1;
    }
    if (neg) { return -v; }
    return v;
};

// 拼两个切片，结果末尾补 0（可以当 C 串直接传给 file.write）
pub const concat = fn (alloc: Allocator, a: []const u8, b: []const u8) ?[]u8 {
    let n = a.len + b.len;
    let raw = alloc.alloc(alloc.ctx, n + 1);
    if (raw) p {
        var dst = p[0..n];
        var i: usize = 0;
        while (i < a.len) {
            dst[i] = a[i];
            i = i + 1;
        }
        var j: usize = 0;
        while (j < b.len) {
            dst[a.len + j] = b[j];
            j = j + 1;
        }
        var whole = p[0..n + 1];
        whole[n] = 0;
        return dst;
    }
    return null;
};

const countOf = fn (s: []const u8, sep: []const u8) usize {
    if (sep.len == 0) { return 1; }
    return count(s, sep) + 1;   // 段数 = 分隔符出现次数 + 1
};

// 按 sep 切开。结果和每段都指向原串（不复制），数组本身向分配器要。
// sep 为空时整串作为唯一一段返回（不是"每个字节切一刀"）。
pub const split = fn (alloc: Allocator, s: []const u8, sep: []const u8) ?[][]const u8 {
    let n = countOf(s, sep);
    let raw = alloc.alloc(alloc.ctx, n * @type([]const u8).size);
    if (raw) p {
        let slots = ((*[]const u8)p)[0..n];
        var k: usize = 0;
        var start: usize = 0;
        var i: usize = 0;
        while (sep.len > 0 and i + sep.len <= s.len) {
            if (matchAt(s, i, sep)) {
                slots[k] = s[start..i];
                k = k + 1;
                i = i + sep.len;
                start = i;
            } else {
                i = i + 1;
            }
        }
        slots[k] = s[start..];
        return slots;
    }
    return null;
};

// 释放 split 的结果
pub const freeSplit = fn (alloc: Allocator, parts: [][]const u8) void {
    alloc.free(alloc.ctx, (*u8)parts.ptr, parts.len * @type([]const u8).size);
};

// ASCII 大小写转换。非 ASCII 字节原样保留（这里不做 Unicode）。
// 结果末尾补 0，可以当 C 串用。
const mapAscii = fn (alloc: Allocator, s: []const u8, upper: bool) ?[]u8 {
    let raw = alloc.alloc(alloc.ctx, s.len + 1);
    if (raw) p {
        var dst = p[0..s.len];
        var i: usize = 0;
        while (i < s.len) {
            let c = s[i];
            if (upper and c >= 97 and c <= 122) {
                dst[i] = c - 32;
            } else if (!upper and c >= 65 and c <= 90) {
                dst[i] = c + 32;
            } else {
                dst[i] = c;
            }
            i = i + 1;
        }
        var whole = p[0..s.len + 1];
        whole[s.len] = 0;
        return dst;
    }
    return null;
};

pub const toUpper = fn (alloc: Allocator, s: []const u8) ?[]u8 {
    return mapAscii(alloc, s, true);
};

pub const toLower = fn (alloc: Allocator, s: []const u8) ?[]u8 {
    return mapAscii(alloc, s, false);
};

// 把 parts 用 sep 连成一个新串。parts.len==0 返回空串（末尾补 0）。
// 每段、sep 都按字节原样复制，结果末尾补 0。
pub const join = fn (alloc: Allocator, parts: [][]const u8, sep: []const u8) ?[]u8 {
    var total: usize = 0;
    var i: usize = 0;
    while (i < parts.len) {
        total = total + parts[i].len;
        if (i + 1 < parts.len) { total = total + sep.len; }
        i = i + 1;
    }
    let raw = alloc.alloc(alloc.ctx, total + 1);
    if (raw) p {
        var dst = p[0..total];
        var pos: usize = 0;
        i = 0;
        while (i < parts.len) {
            var j: usize = 0;
            while (j < parts[i].len) {
                dst[pos] = parts[i][j];
                pos = pos + 1;
                j = j + 1;
            }
            if (i + 1 < parts.len) {
                j = 0;
                while (j < sep.len) {
                    dst[pos] = sep[j];
                    pos = pos + 1;
                    j = j + 1;
                }
            }
            i = i + 1;
        }
        var whole = p[0..total + 1];
        whole[total] = 0;
        return dst;
    }
    return null;
};

// 把 s 里所有非重叠的 old 换成 new。old 为空时原样返回（避免无限循环）。
pub const replace = fn (alloc: Allocator, s: []const u8, old: []const u8, new: []const u8) ?[]u8 {
    if (old.len == 0) {
        let raw = alloc.alloc(alloc.ctx, s.len + 1);
        if (raw) p {
            var dst = p[0..s.len];
            var i: usize = 0;
            while (i < s.len) { dst[i] = s[i]; i = i + 1; }
            var whole = p[0..s.len + 1];
            whole[s.len] = 0;
            return dst;
        }
        return null;
    }
    let hits = count(s, old);
    if (hits == 0) {
        let raw = alloc.alloc(alloc.ctx, s.len + 1);
        if (raw) p {
            var dst = p[0..s.len];
            var i: usize = 0;
            while (i < s.len) { dst[i] = s[i]; i = i + 1; }
            var whole = p[0..s.len + 1];
            whole[s.len] = 0;
            return dst;
        }
        return null;
    }
    let total = s.len - hits * old.len + hits * new.len;
    let raw = alloc.alloc(alloc.ctx, total + 1);
    if (raw) p {
        var dst = p[0..total];
        var src: usize = 0;
        var pos: usize = 0;
        while (src + old.len <= s.len) {
            if (matchAt(s, src, old)) {
                var j: usize = 0;
                while (j < new.len) { dst[pos] = new[j]; pos = pos + 1; j = j + 1; }
                src = src + old.len;
            } else {
                dst[pos] = s[src];
                pos = pos + 1;
                src = src + 1;
            }
        }
        while (src < s.len) { dst[pos] = s[src]; pos = pos + 1; src = src + 1; }
        var whole = p[0..total + 1];
        whole[total] = 0;
        return dst;
    }
    return null;
};

// 把 s 重复 n 次。n==0 返回空串（末尾补 0）。
pub const repeat = fn (alloc: Allocator, s: []const u8, n: usize) ?[]u8 {
    let total = s.len * n;
    let raw = alloc.alloc(alloc.ctx, total + 1);
    if (raw) p {
        var dst = p[0..total];
        var pos: usize = 0;
        var k: usize = 0;
        while (k < n) {
            var i: usize = 0;
            while (i < s.len) { dst[pos] = s[i]; pos = pos + 1; i = i + 1; }
            k = k + 1;
        }
        var whole = p[0..total + 1];
        whole[total] = 0;
        return dst;
    }
    return null;
};

// 从后往前找 needle。空 needle 返回 hay.len（末尾位置），找不到返回 null。
pub const lastIndexOf = fn (hay: []const u8, needle: []const u8) ?usize {
    if (needle.len == 0) { return hay.len; }
    if (needle.len > hay.len) { return null; }
    var i = hay.len - needle.len;
    while (true) {
        if (matchAt(hay, i, needle)) { return i; }
        if (i == 0) { return null; }
        i = i - 1;
    }
};

const lowerAscii = fn (c: u8) u8 {
    if (c >= 65 and c <= 90) { return c + 32; }
    return c;
};

// ASCII 大小写不敏感比较。非 ASCII 字节原样比较（字符串是裸 []const u8）。
pub const eqIgnoreCase = fn (a: []const u8, b: []const u8) bool {
    if (a.len != b.len) { return false; }
    var i: usize = 0;
    while (i < a.len) {
        if (lowerAscii(a[i]) != lowerAscii(b[i])) { return false; }
        i = i + 1;
    }
    return true;
};

// 十进制浮点，形如 [-+]ddd[.ddd][eE[-+]ddd]。前后空白会被 trim。
// 整数或小数部分至少要有数字；指数超范围（|exp| > 400）算失败，
// 免得积出一堆 inf 还假装成功。多余字符一律失败。
pub const parseFloat = fn (s: []const u8) ?f64 {
    let t = trim(s);
    if (t.len == 0) { return null; }
    var i: usize = 0;
    var neg = false;
    if (t[0] == 45 or t[0] == 43) {
        neg = (t[0] == 45);
        i = 1;
        if (t.len == 1) { return null; }
    }
    var v: f64 = 0.0;
    var digits: usize = 0;
    while (i < t.len and t[i] >= 48 and t[i] <= 57) {
        v = v * 10.0 + (f64)(t[i] - 48);
        i = i + 1;
        digits = digits + 1;
    }
    if (digits == 0) { return null; }
    if (i < t.len and t[i] == 46) {              // '.'
        i = i + 1;
        var frac: f64 = 0.1;
        while (i < t.len and t[i] >= 48 and t[i] <= 57) {
            v = v + (f64)(t[i] - 48) * frac;
            frac = frac / 10.0;
            i = i + 1;
        }
    }
    if (i < t.len and (t[i] == 101 or t[i] == 69)) {  // e / E
        i = i + 1;
        var eneg = false;
        if (i < t.len and (t[i] == 45 or t[i] == 43)) {
            eneg = (t[i] == 45);
            i = i + 1;
        }
        var ev: usize = 0;
        while (i < t.len and t[i] >= 48 and t[i] <= 57) {
            if (ev <= 400) { ev = ev * 10 + (usize)(t[i] - 48); }
            i = i + 1;
        }
        if (ev > 400) { return null; }
        var p: f64 = 1.0;
        var k: usize = 0;
        while (k < ev) { p = p * 10.0; k = k + 1; }
        if (eneg) { v = v / p; } else { v = v * p; }
    }
    if (i != t.len) { return null; }
    if (neg) { v = -v; }
    return v;
};
