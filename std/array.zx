// array.zx —— 数组工具：可增长列表 List 与定长数组 Array。
//
// 两个类型都不搞别名、只走这一条真实路径：
//   std.array.List(T)    原 std.ArrayList(T) 迁来，可增长，吃 Allocator
//   std.array.Array(T,N) C 风格定长数组：data 是 [N]T 数组值，
//                        真正占 N*sizeof(T) 内存，可作为其他类型的成员
//
// §201 起 Zx 有真正的数组值类型 `[N]T`：占栈内存，内建 .ptr/.len/.size，
// `data[i]` 直接取元素。`&data` 得 `*[N]T`——普通指针，指向整个数组，
// `p[0]` / `p.0` 取出数组本身，`p + i` 按整个数组步进；它不再有内建成员。

// ---- 可增长列表（原 ArrayList）----
// `T` 是元素类型；容量不够时按倍数向分配器要内存、搬过去、释放旧的。
pub const List = struct (T: type) {
    pub buf: *T,
    pub len: usize,
    pub cap: usize,
    pub alloc: Allocator,

    // ---- 构造 / 释放 ----

    pub const init = fn (alloc: Allocator) Self {
        return Self{ .buf = undefined, .len = 0, .cap = 0, .alloc = alloc };
    };

    pub const deinit = fn (self: *Self) void {
        if (self.cap > 0) {
            self.alloc.free(self.alloc.ctx, (*u8)self.buf, self.cap * @type(T).size);
        }
        self.buf = undefined;
        self.len = 0;
        self.cap = 0;
    };

    // ---- 取值 ----

    pub const at = fn (self: *Self, i: usize) ?*T {
        if (i >= self.len) { return null; }
        return self.buf + i;
    };

    pub const get = fn (self: *Self, i: usize) ?T {
        if (i >= self.len) { return null; }
        return (self.buf + i).0;
    };

    pub const set = fn (self: *Self, i: usize, v: T) bool {
        if (i >= self.len) { return false; }
        (self.buf + i).0 = v;
        return true;
    };

    pub const items = fn (self: *Self) []T { return self.buf[0..self.len]; };

    // 按调用方给的 eq 找元素。Zx 没有 trait/重载，`==` 对聚合类型不可用
    // （E0306），所以和 std.sort 一样把比较口径交给调用方。
    pub const indexOf = fn (self: *Self, key: T, eq: fn (T, T) bool) ?usize {
        var i: usize = 0;
        while (i < self.len) {
            if (eq((self.buf + i).0, key)) { return i; }
            i = i + 1;
        }
        return null;
    };

    pub const contains = fn (self: *Self, key: T, eq: fn (T, T) bool) bool {
        if (self.indexOf(key, eq)) _ { return true; }
        return false;
    };

    pub const clear = fn (self: *Self) void { self.len = 0; };

    // ---- 增长 ----

    // 容量不够就翻倍。搬家用一次 memcpy：T 任意大小，逐元素循环
    // 换成内存原语后这一步从 O(n) 次访存变成一次批量搬运。
    pub const reserve = fn (self: *Self, need: usize) bool {
        if (need <= self.cap) { return true; }

        var ncap = self.cap;
        if (ncap == 0) { ncap = 8; }
        while (ncap < need) { ncap = ncap * 2; }

        let bytes = ncap * @type(T).size;
        let raw = self.alloc.alloc(self.alloc.ctx, bytes);
        if (raw) p {
            let dst = (*T)p;
            if (self.len > 0) {
                @memcpy((*u8)dst, (*u8)self.buf, self.len * @type(T).size);
            }
            if (self.cap > 0) {
                self.alloc.free(self.alloc.ctx, (*u8)self.buf, self.cap * @type(T).size);
            }
            self.buf = dst;
            self.cap = ncap;
            return true;
        }
        return false;
    };

    pub const push = fn (self: *Self, v: T) bool {
        if (!self.reserve(self.len + 1)) { return false; }
        (self.buf + self.len).0 = v;
        self.len = self.len + 1;
        return true;
    };

    pub const pop = fn (self: *Self) ?T {
        if (self.len == 0) { return null; }
        self.len = self.len - 1;
        return (self.buf + self.len).0;
    };

    pub const first = fn (self: *Self) ?T {
        if (self.len == 0) { return null; }
        return (self.buf + 0).0;
    };

    pub const last = fn (self: *Self) ?T {
        if (self.len == 0) { return null; }
        return (self.buf + self.len - 1).0;
    };

    // 在 i 处插一个，后面的整体右移（memmove：同 buffer 内重叠）。
    // i == len 等价于 push。
    pub const insertAt = fn (self: *Self, i: usize, v: T) bool {
        if (i > self.len) { return false; }
        if (!self.reserve(self.len + 1)) { return false; }
        if (i < self.len) {
            @memmove((*u8)(self.buf + i + 1), (*u8)(self.buf + i), (self.len - i) * @type(T).size);
        }
        (self.buf + i).0 = v;
        self.len = self.len + 1;
        return true;
    };

    // 删掉第 i 个，后面的左移。删最后一个等价于 pop。
    pub const removeAt = fn (self: *Self, i: usize) bool {
        if (i >= self.len) { return false; }
        if (i + 1 < self.len) {
            @memmove((*u8)(self.buf + i), (*u8)(self.buf + i + 1),
                (self.len - i - 1) * @type(T).size);
        }
        self.len = self.len - 1;
        return true;
    };

    pub const reverse = fn (self: *Self) void {
        if (self.len < 2) { return; }
        var i: usize = 0;
        var j = self.len - 1;
        while (i < j) {
            let t = (self.buf + i).0;
            (self.buf + i).0 = (self.buf + j).0;
            (self.buf + j).0 = t;
            i = i + 1;
            j = j - 1;
        }
    };

    // 把长度改成 n：变长用 fill 补，变短直接截断（容量不动）。
    pub const resize = fn (self: *Self, n: usize, fill: T) bool {
        if (n > self.len) {
            if (!self.reserve(n)) { return false; }
            var k = self.len;
            while (k < n) {
                (self.buf + k).0 = fill;
                k = k + 1;
            }
        }
        self.len = n;
        return true;
    };

    // 就地交换两个元素。
    pub const swap = fn (self: *Self, i: usize, j: usize) bool {
        if (i >= self.len or j >= self.len) { return false; }
        let t = (self.buf + i).0;
        (self.buf + i).0 = (self.buf + j).0;
        (self.buf + j).0 = t;
        return true;
    };

    // 追加一个切片：一次 memcpy。
    pub const append = fn (self: *Self, vs: []const T) bool {
        if (vs.len == 0) { return true; }
        if (!self.reserve(self.len + vs.len)) { return false; }
        @memcpy((*u8)(self.buf + self.len), vs.ptr, vs.len * @type(T).size);
        self.len = self.len + vs.len;
        return true;
    };
};

// ---- 定长数组（C 风格 T arr[N]，内联存储）----
// T 元素类型，N 编译期常量长度。data 是数组值 `[N]T`——真正内联占
// N*sizeof(T) 内存：作为其他类型的成员时内存随之携带，调用方不需要
// 再给存储（这是它跟 `*[N]T` 指针的本质区别）。
// 下标直接用 `data[i]`；需要首元素裸指针时用 `data.ptr`。
// 方法一律收 `self: *Self`——按值收 self 时 &self.data 指向栈副本，
// 写了也写不进真身。数组字段里的指针不进 tag 字段账（已知限制）。
pub const Array = struct (T: type, N: usize) {
    // 内联存储：N 个 T。零初始化请配合 zero()（一次 memset）或逐元素 set。
    pub data: [N]T,

    // 编译期元信息（§117 编译期值槽）：长度与总字节数都能静态取。
    pub const count = N;
    pub const byteSize = N * @type(T).size;

    pub const init = fn () Self {
        return Self{ .data = undefined };
    };

    // 数组指针视图：指向内联存储的起始地址，运行期下标全走它。
    pub const ptr = fn (self: *Self) *[N]T {
        return &self.data;
    };

    pub const len = fn (self: *Self) usize { return N; };

    // 切片视图：全长借用，元素就地（不拷贝）。
    pub const items = fn (self: *Self) []T { return self.data[0..]; };

    pub const at = fn (self: *Self, i: usize) ?*T {
        if (i >= N) { return null; }
        return &self.data[i];
    };

    pub const get = fn (self: *Self, i: usize) ?T {
        if (i >= N) { return null; }
        return self.data[i];
    };

    pub const set = fn (self: *Self, i: usize, v: T) bool {
        if (i >= N) { return false; }
        self.data[i] = v;
        return true;
    };

    pub const first = fn (self: *Self) T { return self.data[0]; };
    pub const last = fn (self: *Self) T { return self.data[N - 1]; };

    // 逐元素 fill：T 任意。这里不能用 @memset——它是**字节**语义
    //（sema.c：第三参是 byte count、第二参是填充字节值）：v 是元素值
    // 不是字节值，T 比 1 字节宽时每个字节都被写成 v 的低位字节
    //（fill(1) 对 i32 得 0x01010101），且 f32 / 结构体 T 直接编译报错
    //（@memset 要求填充值是整数）。
    pub const fill = fn (self: *Self, v: T) void {
        var i: usize = 0;
        while (i < N) {
            self.data[i] = v;
            i = i + 1;
        }
    };

    // 清零特例：全零字节 = 零值对任意 T 成立（含指针字段 → null），
    // 一次内存原语完成。这才是 @memset 的正确用法。
    pub const zero = fn (self: *Self) void {
        @memset((*u8)(self.data.ptr), 0, N * @type(T).size);
    };

    pub const reverse = fn (self: *Self) void {
        if (N < 2) { return; }
        var i: usize = 0;
        var j: usize = N - 1;
        while (i < j) {
            let t = self.data[i];
            self.data[i] = self.data[j];
            self.data[j] = t;
            i = i + 1;
            j = j - 1;
        }
    };

    pub const swap = fn (self: *Self, i: usize, j: usize) bool {
        if (i >= N or j >= N) { return false; }
        let t = self.data[i];
        self.data[i] = self.data[j];
        self.data[j] = t;
        return true;
    };
};
