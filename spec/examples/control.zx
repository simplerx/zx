// control.zx —— if / while / for / switch / defer / 标签
// 无标签块恒为 {}；带标签的作用域靠收割语句 tag: expr; 交值

const std = @mod("std");

// ---------- 块：值靠收割交出 ----------
const triple = calc: {
    var base = 7;
    calc: base * 3;                // 收割：设值并离开 calc；没有这行，块值就是 {}
};                                 // triple == 21

const voidBlock = {
    let t = 1;                     // 末尾是语句 → 块值 {}
};

// ---------- if：表达式臂给值（糖），块臂靠收割 ----------
const abs = fn (x: i32) i32 {
    return if (x < 0) -x else x;            // 表达式臂，值即 if 的值
};

// 想要块臂也能写，但值仍靠 return
const abs2 = fn (x: i32) i32 {
    if (x < 0) { return -x; }
    return x;
};

// ---------- if 捕获空值联合体（省略竖线） ----------
const twiceOrZero = fn (m: ?i32) i32 {
    return if (m) v * 2 else 0;             // v 是载荷，类型 i32
};

// ---------- if 捕获错误联合体 ----------
const report = fn (res: !i32) void {
    if (res) v {
        std.println("ok: {}", v);
    } else e {                              // e 是错误码，类型 error(u16)
        std.println("error code: {}", (usize)e);
    }
};

// ---------- while：条件形式 ----------
const sumTo = fn (n: i32) i32 {
    var i: i32 = 0;
    var acc: i32 = 0;
    while (i < n) {                         // 没有 : (自增) 子句，自增写在体内
        acc = acc + i;
        i = i + 1;
    }
    return acc;
};

// ---------- while：捕获形式，循环到空为止 ----------
const Iter = struct {
    data: []const i32,
    idx: usize,
};

const next = fn (it: *Iter) ?i32 {
    if (it.idx >= it.data.len) { return null; }
    let v: i32 = it.data[it.idx];           // 运行时下标
    it.idx = it.idx + 1;
    return (?i32)v;
};

const drain = fn (it: *Iter) i32 {
    var total: i32 = 0;
    while (next(it)) v {                    // 每轮重新求值，有值就绑定 v
        total = total + v;
    }
    return total;
};

// ---------- for：切片 / 整数范围 / 多绑定 ----------
const sumAll = fn (xs: []const i32) i32 {
    var total: i32 = 0;
    for (xs) x { total = total + x; }
    return total;
};

// 整数范围：左闭右开，不写 |i|
const zeros = fn (buf: []u8) void {
    for (0..buf.len) i { buf[i] = 0; }
};

// 数组要先用 [0..] 变成切片，零开销
const sumArr = fn (xs: *const [5]i32) i32 {
    var total: i32 = 0;
    for (xs[0..]) x { total = total + x; }
    return total;
};

// 多绑定：值 + 下标；0.. 的上界就是 xs 的长度
const sumWeighted = fn (xs: []const i32) i32 {
    var total: i32 = 0;
    for (xs, 0..) x, i { total = total + x * (i32)i; }
    return total;
};

// 多绑定：两个等长序列（编译期长度不一致会直接报错）
const dot = fn (a: *const [3]i32, b: *const [3]i32) i32 {
    var acc: i32 = 0;
    for (a[0..], b[0..]) x, y { acc = acc + x * y; }
    return acc;
};

const Color = enum { red, green, blue };

// 枚举不是序列，用整数范围 + 显式转换
const enumNames = fn () void {
    for (0..3) i {
        std.println("{}", (usize)i);        // 0 1 2 == 三个变体的值
    }
};

// ---------- 收割带值 + continue ----------
const firstBig = fn (xs: []const i32) i32 {
    // 循环没有 else 分支（E0405）：收割值改用 var 接，命中即停（没有 break）
    var hit: i32 = 0;
    var found = false;
    for (xs) x {
        if (found) { continue; }
        if (x <= 100) { continue; }         // 下一轮
        hit = x;                            // 第一个 >100 的
        found = true;
    }
    return hit;
};

// ---------- 标签：一次跳出多层 ----------
// 扁平存储 + 手算下标（数组没有"二维值类型"，见 §3.2）
const findZero = fn (m: *const [9]i32) ?{usize, usize} {
    // 循环没有 else 分支（E0405）：兜底用 var
    var hit: ?{usize, usize} = null;
    for (0..3) i {
        for (0..3) j {
            if (m[i * 3 + j] == 0) {
                hit = { i, j };            // 找到零：记录下标元组
            }
        }
    }
    return hit;                            // 没找到就是 null
};

// 标签也能给普通块：块算值 + 中途退出
const clamp = fn (v: i32, lo: i32, hi: i32) i32 {
    return body: {
        if (v < lo) { body: lo; }
        if (v > hi) { body: hi; }
        body: v;
    };
};

// ---------- switch：臂是表达式，直接有值 ----------
const colorName = fn (c: Color) []const u8 {
    return switch (c) {
        .red:   "red";
        .green: "green";
        else:   "other";
    };
};

// ---------- 用 while 表达带下标的查找 ----------
const find = fn (xs: []const i32, target: i32) ?usize {
    var i: usize = 0;
    while (i < xs.len) {
        if (xs[i] == target) { return (?usize)i; }
        i = i + 1;
    }
    return null;
};

// ---------- continue：想提前结束循环，就给循环加标签 ----------
const countEven = fn (xs: []const i32) usize {
    var n: usize = 0;
    for (xs) x {
        if (x % 2 != 0) { continue; }       // 下一轮
        n = n + 1;
    }
    return n;
};

// 无标签的循环不能被提前离开；要 break 的语义，就加标签再收割
// （循环没有 else 分支——E0405：兜底值用 var）
const anyNegative = fn (xs: []const i32) bool {
    var neg = false;
    for (xs) x {
        if (x < 0) { neg = true; }          // 有负数
    }
    return neg;
};

// ---------- defer：离开作用域时执行，后进先出 ----------
var g_depth: usize = 0;                     // 模拟一把锁

const enter = fn () void { g_depth = g_depth + 1; };
const leave = fn () void { g_depth = g_depth - 1; };

const withLock = fn () void {
    enter();
    defer leave();                          // 无论怎么离开这个块，都会配对执行

    // 三个 defer 逆序执行：先 "third"，再 "second"，最后 "first"
    defer std.print("first\n");
    defer std.print("second\n");
    defer std.print("third\n");

    if (g_depth == 1) { return; }           // 提前 return 也照样清理
    std.print("unreachable\n");
};

// defer 不改变块的值：块的值仍然只来自收割
const deferred = fn () i32 {
    var x: i32 = 0;
    {
        defer x = x + 100;                  // 块退出时才跑
        x = 1;
    }                                        // 到这里 x == 101
    return x;
};

const main = fn () u8 {
    let xs: *const [5]i32 = &.{1, 250, 3, 400, 5};

    std.println("{}", abs(-9));
    std.println("{}", twiceOrZero(21));
    std.println("{}", twiceOrZero(null));
    std.println("{}", sumTo(10));
    std.println("{}", sumAll(xs[0..]));
    std.println("{}", sumArr(xs));
    std.println("{}", sumWeighted(xs[0..]));
    std.println("{}", firstBig(xs[0..]));
    std.println("{}", clamp(999, 0, 100));

    if (find(xs[0..], 400)) idx { std.println("{}", idx); }
    std.println("{}", countEven(xs[0..]));

    let a: *const [3]i32 = &.{1, 2, 3};
    let b: *const [3]i32 = &.{4, 5, 6};
    std.println("dot = {}", dot(a, b));

    var it = Iter{ .data = xs[0..], .idx = 0 };
    std.println("{}", drain(&it));

    report((error)1);
    report((error)42);

    enumNames();
    std.println("{}", colorName(Color.green));

    withLock();                              // 结束后 g_depth == 0
    std.println("{}", deferred());           // 101

    // R9 起 undefined 不再隐式分配存储（误用会撞空指针）；
    // 要栈内存走 std.stackAlloc（见 decisions §9 / R9）
    var scratch = std.stackAlloc(u8, 4);
    zeros(scratch[0..]);

    return 0;
};

// expect-output
// 9
// 42
// 0
// 45
// 659
// 659
// 1476
// 250
// 100
// 3
// 2
// dot = 32
// 659
// error code: 1
// error code: 42
// 0
// 1
// 2
// green
// third
// second
// first
// 101
