// literals.zx —— {…} 和 &.{…} 的区别，一个例子说清
//
//   {1, 2, 3}      元组：值类型，内联，元素类型可以不同
//   &.{1, 2, 3}    数组：*[N]T，8 字节指针，元素类型必须一致，元素存在别处
//
// 那个多出来的 "." 是给 parser 的：&.{ 明确表示"这个花括号是字面量，不是块"。
//
// 块和元组的判定只看一件事：花括号顶层有没有 ";" 或声明。
//   没有 → 元组（{x} 是一元组）
//   有   → 块（无标签恒为 {}；带标签靠收割交值）

const std = module("std");

// ---------- 元组：整个值在变量里 ----------
const pair: {i32, f64} = {1, 2.5}; // 占 4 + 4 填充 + 8 = 16 字节
const triple = {1, "x", true};     // 元素类型可以不同，这正是元组的能力

// 一元组和"带分号的块"是两回事
const one = {42};                  // {comptime_int}，一元组
const one2 = {42,};                // 同上，尾逗号可写可不写
const empty = {};                  // 零元组 == void

// 块要交出值，加标签再收割
const blk = answer: { answer: 42; };   // 块，值 42，类型 comptime_int
const blk2 = { 42; };              // 块，值 {} —— 42 只是被求值后丢弃

// ---------- 数组：变量里只有一个地址 ----------
const nums: *const [3]i32 = &.{10, 20, 30};
// const bad = &.{1, "x"};         // 编译错误：数组元素类型必须一致

// ---------- .len / .size 两者都有 ----------
const pairLen = pair.len;          // 2，comptime
const pairSize = pair.size;        // 16，comptime（含对齐填充）
const numsLen = nums.len;          // 3，comptime
const numsSize = nums.size;        // 12，comptime

// 内存占用的差别：这是"值"和"指针"的根本区别
const pairBytes = 16;                      // pair: {i32, i32} = 16 字节
const numsBytes = @type(*const [3]i32).size;   // 8 —— 只有一个地址

const main = fn () u8 {
    // ---------- 元素访问：同一套语法 ----------
    let a = pair.0;                // 1
    let b = nums.0;                // 10
    let c = nums.2;                // 30

    // 示例值只看类型推导，不再消费；语言要求"没用就 `_`"，
    // 这里用一个元组把它们一次性丢弃（正式代码里当然会真正用到）。
    _ = { a, b, c };

    // 元组的 .N 只能编译期；数组额外支持运行时下标
    var i: usize = 1;
    let d = nums[i];               // 20，带边界检查
    // let e = pair[i];            // 编译错误：元组没有运行时下标
    _ = d;

    // ---------- 可变性 ----------
    var t = {1, 2};
    t.1 = 20;                      // 元组是值，直接写字段
    var p = &.{1, 2};
    p.0 = 10;                      // 数组是 var 绑定的栈存储，可以写

    let ro = &.{1, 2};             // let 绑定 → *const [2]i32
    // ro.0 = 5;                   // 编译错误：透过 *const 写入
    _ = { t, p, ro };

    // ---------- 只有数组能变切片 ----------
    let s = nums[0..];             // []const i32，ptr + len
    let s2 = nums[1..3];           // []const i32，长度 2
    // let s3 = pair[0..];         // 元组没有切片（没有连续存储可指）

    // 切片带长度后就能离开这个函数、传给别人
    std.println("sum = {}", sum(s));
    _ = s2;

    // ---------- for：切片 / 整数范围 / 多绑定 ----------
    var total: i32 = 0;
    for (nums[0..]) x { total = total + x; }     // 数组先变切片，零开销

    var total2: i32 = 0;
    for (nums[0..], 0..) x, idx {                // 值 + 下标，多绑定
        total2 = total2 + x * (i32)idx;
    }

    for (0..3) i {                               // 整数范围，不写 |i|
        total = total + nums[i];
    }

    // ---------- 数量在类型里：*[3] 和 *[4] 是不同类型 ----------
    let v3: *const [3]f32 = &.{1.0, 2.0, 3.0};
    let d3 = dot(v3, v3);           // ✓ 只收 *const [3]f32
    // let v4: *const [4]f32 = &.{1.0, 2.0, 3.0, 4.0};
    // dot(v4, v4);                 // ✗ *[4]f32 不是 *[3]f32，编译期就报错

    // 真要跨长度传递，显式退到裸指针再断言
    let bare: *const f32 = v3;       // ✓ 隐式丢数量
    let again = (*const [3]f32)bare; // ✓ 显式断言"这里真有 3 个"
    _ = { d3, again };

    // ---------- 标签跳出 ----------
    let found = search: {
        for (nums[0..], 0..) x, idx {
            if (x == 20) { search: idx; }
        }
        search: 99;                  // 正常跑完：没找到
    };                               // found == 1

    std.println("literals ok, found={}", found);
    return 0;
};

// 数量写进签名，比"传指针 + 传长度"少一个参数、少一次出错机会
const dot = fn (a: *const [3]f32, b: *const [3]f32) f32 {
    return a.0 * b.0 + a.1 * b.1 + a.2 * b.2;
};

const sum = fn (xs: []const i32) i32 {
    var acc: i32 = 0;
    for (xs) x { acc = acc + x; }
    return acc;
};

// expect-output
// sum = 60
// literals ok, found=1
