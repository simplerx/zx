// syntax.zx —— 语法自测：每条都是 parser 必须正确区分的那类写法
// 用 zxc syntax.zx --ast 看结构

// 1. {x} 是元组，不是块
const one = {42};
const pair = {1, 2};
const empty = {};

// 2. 块：顶层有 ; 就是块，值来自收割
const blk = answer: { answer: 42; };
const delayed = calc: {
    var base = 7;
    if (base > 5) { calc: base * 3; }
    calc: base;
};

// 3. 标签收割：一次跳出两层
const findZero = fn (m: *const [9]i32) ?{usize, usize} {
    return outer: for (0..3) i {
        for (0..3) j {
            if (m[i * 3 + j] == 0) { outer: {i, j}; }
        }
    } else null;
};

// 4. 表达式臂是糖
const max = fn (a: i32, b: i32) i32 {
    return if (a > b) a else b;
};

// 5. 捕获 + 表达式臂（省略竖线）
const twice = fn (m: ?i32) i32 {
    return if (m) v * 2 else 0;
};

// 6. 数组是 *[N]T，元组是 {}
const nums: *const [3]i32 = &.{10, 20, 30};
const arrSlice = nums[0..];
const idx = nums.0;
const len = nums.len;

// 7. for 多绑定 + 省略上界
const sum2 = fn (xs: []const i32, ys: []const i32) i32 {
    var total: i32 = 0;
    for (xs, ys) x, y { total = total + x * y; }
    for (xs, 0..) x, i { total = total + x * (i32)i; }
    return total;
};

// 8. switch：模式 : 体，臂可带标签
const name = fn (c: Color) []const u8 {
    return switch (c) {
        .red:    "red";
        .green:  "green";
        else:    "other";
    };
};

const Color = enum { red, green, blue };

// 9. defer
const withLock = fn (lock: *i32) void {
    lock.0 = 1;
    defer lock.0 = 0;
};

// 10. 泛型 + 结构体字面量
const Buffer = fn (T: type, n: usize) type {
    return struct {
        data: *[n]T,
        len: usize,
    };
};

const main = fn () u8 {
    var scratch: *[4]u8 = undefined;
    var b: Buffer(u8, 4) = Buffer(u8, 4){ .data = scratch, .len = 0 };
    b.len = 1;
    return 0;
};

// expect-output
