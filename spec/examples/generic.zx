// generic.zx —— 泛型：type 是一等编译期值，泛型就是编译期函数
// 单态化，零运行时开销

const std = module("std");

// ---------- 最简单的泛型类型 ----------
const List = fn (T: type) type {
    return struct {
        data: []T,        // 切片：指针 + 长度，16 字节，可增长
        len: usize,
        cap: usize,
    };
};

// ---------- 带非类型参数 ----------
const Buffer = fn (T: type, n: usize) type {
    return struct {
        data: *[n]T,      // n 进类型：Buffer(u8,4) 与 Buffer(u8,8) 是不同类型
        len: usize,
    };
};

// ---------- 多参数 ----------
const Pair = fn (A: type, B: type) type {
    return struct {
        first: A,
        second: B,
    };
};

// ---------- 泛型函数 ----------
const push = fn (T: type, l: *List(T), v: T) void {
    l.data[l.len] = v;    // 运行时下标
    l.len = l.len + 1;
};

const head = fn (T: type, l: List(T)) ?T {
    if (l.len == 0) { return null; }
    return (?T)l.data.0;  // .0 是编译期下标（第 0 个）
};

const swap = fn (T: type, a: *T, b: *T) void {
    let tmp: T = a.0;
    a.0 = b.0;
    b.0 = tmp;
};

// ---------- 编译期计算：生成查找表 ----------
// 块的值靠收割交出，整体在编译期算完、物化为静态数据
const POW2 = build: {
    var t: *[8]u32 = &.{0, 0, 0, 0, 0, 0, 0, 0};
    var i: usize = 0;
    while (i < 8) {
        t[i] = (u32)1 << (u32)i;
        i = i + 1;
    }
    build: t;              // 收割逃逸：整块物化为静态数组
};

const TABLE_LEN = POW2.len;         // 8，comptime
const TABLE_BYTES = POW2.size;      // 32，comptime

// 同样的东西用标签块写，可以中途退出
const TABLE_SUM = sum: {
    var acc: u32 = 0;
    for (0..TABLE_LEN) i {
        acc = acc + POW2[i];
        if (acc > 1000) { sum: acc; }
    }
    sum: acc;
};

// ---------- 泛型 + 编译期分支：按 T 的大小选实现 ----------
const zero = fn (T: type) T {
    if (@sizeOf(T) > 8) {
        @compileError("zero() 只支持 <= 8 字节的类型");
    }
    return (T)0;
};

fn main() u8 {
    // 栈上后备存储：var + *[N]T 才是"分配 N 个元素"
    var backing: *[4]i32 = &.{0, 0, 0, 0};

    // 实例化 List(i32)；backing 是 *[4]i32，靠 R7 提升成 []i32
    var l: List(i32) = List(i32){
        .data = backing,
        .len = 0,
        .cap = 4,
    };

    push(i32, &l, 11);      // &l 是取地址 → *List(i32)
    push(i32, &l, 22);
    push(i32, &l, 33);

    if (head(i32, l)) h {
        std.println("head = {}", h);
    }

    // 另一个实例：List(u8) 是另一份单态化代码
    var bytes: *[2]u8 = &.{1, 2};
    var bl: List(u8) = List(u8){ .data = bytes, .len = 2, .cap = 2 };

    // 带 n 的泛型：n 直接进类型
    var raw = std.stackAlloc(u8, 64);      // 栈上申请 64 字节（decisions §44）
    var b: Buffer(u8, 64) = Buffer(u8, 64){ .data = raw, .len = 0 };
    b.data.0 = 'z';
    b.len = 1;

    // 多类型参数
    let p: Pair(i32, []const u8) = Pair(i32, []const u8){ .first = 7, .second = "seven" };

    // 泛型函数作用在普通变量上
    var x: i32 = 1;
    var y: i32 = 2;
    swap(i32, &x, &y);

    // 编译期表
    let p3 = POW2.3;                    // 8
    let z = zero(u32);

    std.println("generic ok, p3={}, sum={}", p3, TABLE_SUM);
    return 0;
}

// expect-output
// head = 11
// generic ok, p3=8, sum=255
