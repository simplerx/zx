// errors.zx —— ?T 与 !T 的完整用法
// ?T 的标签是 bool（null == false），!T 的标签是 error(u16)（0 == 无错误）
// 布局：载荷在前、标签在尾部 → &x 就是 &payload，零偏移

const std = module("std");

// 错误码就是整数，用 enum 起名。
// 0 留给"无错误"——命名错误码从 1 起（`(error)0` 是编译错误 E0508）。
const Err = enum(u16) {
    notFound = 1,
    badInput = 2,
    overflow = 3,
};

// ---------- 返回错误联合体 ----------
const parseDigit = fn (c: u8) !u8 {
    if (c < '0') { return (error)Err.badInput; }
    if (c > '9') { return (error)Err.badInput; }
    return (u8)(c - '0');
};

const parseU8 = fn (s: []const u8) !u8 {
    if (s.len == 0) { return (error)Err.badInput; }
    var acc: u8 = 0;
    for (s) c {
        if (parseDigit(c)) d {
            if (acc > 25) { return (error)Err.overflow; }
            acc = acc * 10 + d;
        } else e {
            return e;              // error 直接提升成 !u8（R7）
        }
    }
    return acc;
};

// ---------- 返回空值联合体 ----------
const findChar = fn (s: []const u8, needle: u8) ?usize {
    var i: usize = 0;
    while (i < s.len) {
        if (s[i] == needle) { return (?usize)i; }
        i = i + 1;
    }
    return null;
};

// ---------- 两种联合体串起来：块 + 标签，中途退出 ----------
const parseIndex = fn (s: []const u8, needle: u8) !usize {
    return found: {
        if (findChar(s, needle)) idx {
            found: idx;                             // 收割：?T 成功 → 值
        } else {
            found: (error)Err.notFound;             // 收割：?T 失败 → 错误
        }
    };
};

// ---------- 分发表：错误码 → 文案 ----------
const errName = fn (code: error) []const u8 {
    return switch (code) {
        (error)Err.notFound: "not found";
        (error)Err.badInput: "bad input";
        (error)Err.overflow: "overflow";
        else:                "unknown";
    };
};

// ---------- 载荷在前：取地址零偏移 ----------
const peekPayload = fn (m: *const ?i32) i32 {
    // &m 指向 payload 本身，标签在 sizeof(i32) 之后
    let p: *const i32 = (*const i32)m;
    return p.0;
};

const main = fn () u8 {
    // 成功
    if (parseU8("250")) v {
        std.println("parsed: {}", v);
    } else e {
        std.println("failed: {}", (usize)e);
    }

    // 溢出
    if (parseU8("999")) v {
        std.println("parsed: {}", v);
    } else e {
        std.println("failed: {}", (usize)e);
    }

    // 空值
    if (findChar("hello", 'l')) idx {
        std.println("index: {}", idx);
    } else {
        std.print("no such char\n");
    }

    // 链式：!T 里套 ?T 的结果
    if (parseIndex("hello", 'z')) i {
        std.println("{}", i);
    } else e {
        std.println("{}", errName(e));
    }

    // 布局：?i32 是 4 字节 payload + 1 字节 tag（+3 对齐）
    var m: ?i32 = 42;
    std.println("payload = {}, size = {}", peekPayload(&m), @sizeOf(?i32));

    return 0;
};

// expect-output
// parsed: 250
// failed: 3
// index: 2
// not found
// payload = 42, size = 8
