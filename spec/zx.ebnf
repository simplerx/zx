(* ============================================================
   Zx 0.7 — EBNF 文法
   约定：{ X } 重复 0+ 次；[ X ] 可选；( X ) 分组；
        "x" 终结符；(* * ) 注释
   ============================================================ *)

file        = { top_decl } EOF ;

top_decl    = [ "pub" ] ( const_decl | let_decl | var_decl | fn_decl ) ;
(* pub 只出现在文件作用域：决定这个声明是否对别的模块可见 *)

(* 没有 import："把名字拿进来"就是 const 绑定模块成员——
     const math = module("lib/m.zx");   命名空间
     const sq   = math.square;          函数 / 类型 / 常量，都是别名 *)

const_decl  = "const" pattern "=" expr ";" ;
let_decl    = "let"   pattern "=" expr ";" ;
var_decl    = "var"   pattern [ ":" type ] "=" expr ";" ;

pattern     = IDENT | "{" IDENT { "," IDENT } [ "," ] "}" ;
(* 解构：let {a, b, c} = t;   也可写 .{a, b, c} *)

fn_decl     = "fn" IDENT "(" [ params ] ")" type block ;

params      = param { "," param } ;
param       = [ "var" ] IDENT ":" type ;

(* ---------------- 类型 ---------------- *)

type        = type_prefix ;

type_prefix
    = "*" [ "[" expr "]" ] [ "const" ] type      (* *[N]T 数组 / *T 裸指针 / *const T *)
                                                 (* N 进类型：*[3]i32 ≠ *[4]i32 *)
    | "[" "]" [ "const" ] type                   (* 切片 []T  []const T *)
    | "?" type                                   (* 空值联合体 *)
    | "!" type                                   (* 错误联合体 *)
    | type_primary ;
(* `*[N]T` 与 `*[]T` 只差一个 `]`：前者是指向数组，后者是指向切片（指针的指针） *)

type_primary
    = PRIM_TYPE
    | fn_type
    | tuple_type
    | struct_type
    | union_type
    | enum_type
    | "type"
    | IDENT [ "(" [ expr { "," expr } ] ")" ]     (* 名字，或泛型实例 List(i32) *)
    | "(" type ")" ;

PRIM_TYPE   = "u8" | "u16" | "u32" | "u64" | "u128" | "usize"
            | "i8" | "i16" | "i32" | "i64" | "i128" | "isize"
            | "f16" | "f32" | "f64"
            | "bool" | "void" | "noreturn" | "error" ;

fn_type     = "fn" "(" [ type { "," type } ] ")" type ;

tuple_type  = "{" [ type { "," type } [ "," ] ] "}" ;

struct_type = "struct" [ "(" IDENT ")" ] "{" { member } "}" ;   (* struct(packed) *)
union_type  = "union" [ "(" "enum" [ "(" type ")" ] ")" ] "{" { union_member } "}" ;
            (* union(enum)：变体名即隐式枚举（值 = 声明序号）；
               union(enum(T)) 指定标签底层类型 *)
enum_type   = "enum" [ "(" type ")" ] "{" { enum_member } "}" ;

member       = IDENT ":" type [ "=" expr ] ","?    (* 字段，可带默认值 *)
             | const_decl | let_decl | var_decl | fn_decl ;

union_member = IDENT ":" type ","? ;                    (* 普通成员：载荷类型 *)
            | IDENT ":" "{" expr "," type "}" ","? ;    (* 显式标签：{标签值, 载荷类型} *)
enum_member  = IDENT [ "=" expr ] ","?                 (* 变体，从 0 或上一个+1 *)
             | const_decl | let_decl | var_decl | fn_decl ;
(* 枚举体是完整作用域：变体之外还能放常量/静态变量/方法（§4.3） *)

(* ---------------- 作用域 / 块 ---------------- *)

block       = "{" [ stmt { term stmt } ] "}" ;
term        = ";" ;
(* 块的值：无标签恒为 {}；带标签的块由收割语句 tag: expr; 交值。
   末尾表达式是"表达式语句"，不产生值。
   {x}（顶层无 ";"、无声明）不是块，是一元组，见 brace_expr。 *)

stmt        = const_decl
            | let_decl
            | var_decl
            | fn_decl
            | defer_stmt
            | yield_stmt                              (* tag: expr; 收割 *)
            | expr [ ";" ]
            | ctrl_expr ;

yield_stmt  = IDENT ":" expr ";" ;
(* 收割：给最近一层同名标签作用域设值，并立即离开它（v0.5，break 已删除）。
   特例：IDENT ":" "{" 时先套用 brace 消歧——
     顶层是元组（无 ";" / 声明） → 收割语句，如 done: {i, j};
     顶层是块                    → 标签作用域，如 body: { … };
   规则一句话：`标签名: 值` 是收割，`标签名: 结构` 是打标签。 *)

labeled_expr = IDENT ":" ( block | if_expr | for_expr | while_expr | switch_expr ) ;
(* 标签作用域，语句和表达式位置都能用：
     done: for (0..n) i { … done: v; … }
     let x = body: { … body: 1; };
     let sign = s: if (c) { s: 1; } else { s: 0; };
   只有带标签的作用域能被收割 / 交值；无标签块恒为 {}。 *)

defer_stmt  = "defer" ( expr ";" | block ) ;        (* 离开所在块时执行，LIFO *)

(* ---------------- 表达式 ---------------- *)

expr        = assign_expr ;

assign_expr = logic_or [ assign_op assign_expr ] ;
assign_op   = "=" | "+=" | "-=" | "*=" | "/=" | "%="
            | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

logic_or    = logic_and { "||" logic_and } ;
logic_and   = equality  { "&&" equality  } ;
equality    = relational { ( "==" | "!=" ) relational } ;
relational  = bit_or    { ( "<" | "<=" | ">" | ">=" ) bit_or } ;
bit_or      = bit_xor   { "|" bit_xor } ;
bit_xor     = bit_and   { "^" bit_and } ;
bit_and     = shift     { "&" shift } ;
shift       = additive  { ( "<<" | ">>" ) additive } ;
additive    = multiply  { ( "+" | "-" ) multiply } ;
multiply    = unary     { ( "*" | "/" | "%" ) unary } ;

unary       = "&" unary                                (* 取地址 *)
            | ( "-" | "~" | "!" ) unary
            | cast_expr ;

cast_expr   = "(" type ")" unary                       (* C 风格显式转换 *)
            | postfix ;

postfix     = primary { postfix_op } ;
postfix_op  = "." IDENT                                (* 字段 / tag / len / size *)
            | "." INT                                  (* 编译期下标 / 元组元素 *)
            | "[" expr "]"                             (* 运行时下标 *)
            | "[" [ expr ] ".." [ expr ] "]"           (* 切片 *)
            | "(" [ args ] ")" ;                       (* 调用 *)

args        = expr { "," expr } [ "," ] ;

primary     = INT | FLOAT | CHAR | STRING
            | "null" | "undefined" | "true" | "false"
            | IDENT
            | "(" expr ")"
            | brace_expr                               (* {…}：块 或 元组 *)
            | dot_brace                                (* .{…}：强制字面量 *)
            | typed_lit                                (* Person{ .f = e } *)
            | builtin                                  (* @sizeOf(T) *)
            | module_call                              (* module("std") *)
            | labeled_expr                             (* tag: { … } / tag: for … *)
            | ctrl_expr ;

(* 消歧（全部是 1~2 token 的前瞻，不需要回溯）：
   IDENT "{"                      → typed_lit
   "&" "." "{"                    → 数组字面量
   "(" … ")" "{"                  → 见 cast_expr 与 block 的冲突，按"先试转换"处理 *)

(* ---- { } 的消歧（parser 规则，非语法层级） ----
   从 "{" 扫到匹配的 "}"，只看顶层（跳过嵌套括号）：
     含 ";" 或 const/let/var/fn  →  block         （无标签恒为 {}，带标签靠收割交值）
     否则                        →  tuple_lit     （聚合字面量；{x} 是一元组）
   强制块位置不看这条规则：fn 体、if/while/for 的体、else 体、
   struct/union/enum/switch 的体一律是 block。
   递归下降实现：先按 stmt 列表试解析，若在第一个 "}" 前遇到顶层 ","
   且全程没有声明/分号，则回退重解析为 tuple_lit。          *)

brace_expr  = block | tuple_lit ;

tuple_lit   = "{" [ agg_item { "," agg_item } [ "," ] ] "}" ;

dot_brace   = "." tuple_lit ;                          (* .{…} 永不可能是块 *)

agg_item    = "." IDENT "=" expr                       (* 字段式 → 匿名结构体 *)
            | expr ;                                  (* 元素式 → 元组（同层不可混用）*)

typed_lit   = type "{" [ field_init { "," field_init } [ "," ] ] "}" ;
field_init  = "." IDENT "=" expr ;

(* 数组字面量 &.{1,2,3} 不需要单独产生式：
   "&" 前缀作用在 dot_brace 上，语义要求元素类型一致，结果类型 *T。
   写作 &{1,2,3} 也接受（等价），但规范形式是 &.{…}。 *)

(* ---------------- 控制流（全部是表达式） ---------------- *)

ctrl_expr   = if_expr | while_expr | for_expr | switch_expr
            | continue_expr | return_expr ;
(* 没有 break（v0.5 删除）：离开作用域用收割语句 yield_stmt。
   defer 是语句，不是表达式，见 stmt。 *)

if_expr     = "if" "(" expr ")" [ IDENT ] if_arm
              [ "else" ( if_expr | [ IDENT ] if_arm ) ] ;
if_arm      = expr                                     (* 表达式臂：糖，值即 if 的值 *)
            | [ IDENT ] block                          (* [标签] 块臂：值来自臂内收割 *)
            | [ IDENT ] ( return_expr | continue_expr | defer_stmt )
                                                       (* 单语句臂（v0.13）：不用写花括号 *)
            | [ IDENT ] expr ";" ;                     (* 单语句臂（v0.15）：一条表达式语句。
                                                          分号算臂的，判据是紧跟 else；
                                                          没有 else 时分号归外层语句。 *)
(* 捕获名直接写，不带 | |。
   表达式臂 if (c) a else b 是"匿名标签块 + 收割"的糖。
   块臂里的收割语句穿过 if，命中外面（或 if 自身）的标签作用域。 *)

while_expr  = "while" "(" expr ")" [ IDENT ] block
              [ "else" ( expr | block ) ] ;
(* else 只在正常跑完时执行；else 表达式的值就是循环的值（值形式） *)

for_expr    = [ "inline" ] "for" "(" for_seq { "," for_seq } ")" IDENT { "," IDENT } block
              [ "else" ( expr | block ) ] ;
(* else 只在正常跑完时执行；收割离开时跳过 else。
   inline for（v0.9）：序列必须有编译期长度，循环体按长度克隆展开，
   绑定是编译期常量；没有 else，不参与标签/收割。 *)
for_seq     = expr [ ".." [ expr ] ] ;
(* 序列只有两种：
     "(" expr ")"           切片 []T（数组要写 arr[0..]）
     "(" expr ".." expr ")" 整数范围，左闭右开
     "(" expr ".." ")"      省略上界，只在与别的序列同时出现时合法，
                            上界 = 其他序列的公共长度 → for (xs, 0..) x, i
   序列个数必须等于绑定个数；所有序列必须等长。
   绑定名直接写，不带 | |。 *)

switch_expr = "switch" "(" expr ")" "{"
              [ arm { "," arm } [ "," ] ]
              "}" ;
arm         = pattern_list [ IDENT ] ":" arm_body ;
pattern_list = case_label { "," case_label } | "else" ;
arm_body    = expr                                   (* 表达式臂：值即臂值 *)
            | block ;                                (* 块臂：无值；带标签则由收割交值 *)
(* 模式与臂体之间用 ":" 分隔；模式后可写臂标签（给块臂交值用）。
   没有 |x| 载荷捕获：联合体载荷用 s.成员 访问。 *)
case_label  = "." IDENT                                (* 联合体成员 / 枚举变体 *)
            | INT | CHAR | IDENT ;

continue_expr = "continue" [ ":" IDENT ] ";" ;   (* 进入下一轮；:tag 直接进入外层标签循环 *)
return_expr = "return" [ expr ] ";" ;        (* 函数体不用标签，离开函数只靠 return *)

(* 收割目标（跳到哪里）：
     带标签的块 / if / 循环 / switch —— 写在哪一层嵌套都行，穿过无标签结构
   函数体不用标签；struct / union / enum 的体不能加标签 *)

(* ---------------- 内建 ---------------- *)

builtin     = "@" IDENT [ "(" [ args ] ")" ] ;         (* @sizeOf, @typeInfo … *)
module_call = "module" "(" STRING ")" ;

(* ---------------- 词法 ---------------- *)

INT         = dec_int | hex_int | bin_int | oct_int ;
dec_int     = DIGIT { [ "_" ] DIGIT } ;
hex_int     = "0x" HEXDIGIT { [ "_" ] HEXDIGIT } ;
bin_int     = "0b" ( "0" | "1" ) { [ "_" ] ( "0" | "1" ) } ;
oct_int     = "0o" OCTDIGIT { [ "_" ] OCTDIGIT } ;

FLOAT       = DIGIT { DIGIT } "." DIGIT { DIGIT } [ exponent ]
            | DIGIT { DIGIT } exponent ;
exponent    = ( "e" | "E" ) [ "+" | "-" ] DIGIT { DIGIT } ;

CHAR        = "'" ( escape | %x20-26 | %x28-5B | %x5D-7E ) "'" ;
STRING      = '"' { escape | %x20-21 | %x23-5B | %x5D-7E } '"' ;
escape      = "\" ( "\\" | '"' | "'" | "n" | "r" | "t" | "0" | "x" HEXDIGIT HEXDIGIT | "u{" HEXDIGIT { HEXDIGIT } "}" ) ;

IDENT       = ( LETTER | "_" ) { LETTER | DIGIT | "_" } ;
LETTER      = "A".."Z" | "a".."z" | %x80-10FFFF ;
DIGIT       = "0".."9" ;
HEXDIGIT    = DIGIT | "A".."F" | "a".."f" ;
OCTDIGIT    = "0".."7" ;

(* 词法注意：
   1) 浮点必须带整数部分：0.5 合法，.5 不合法（否则与 .0 下标冲突）。
   2) "." 之后的数字序列永远是"下标"，不参与浮点构成。
      所以 t.0.0 合法：(t.0).0；而 0.0 是浮点。
      实现：lex 出 "." 之后，紧跟的 DIGIT+ 直接产出 INT 记号。
   3) "." "{" 合成一个记号 DOT_LBRACE，避免与前一条规则打架。 *)
