// numkit.zx —— 整数数学小件。
//
// 全是 O(1)/O(log n) 的确定性算法，无分配、无依赖——给 stair.zx /
// lattice.zx 这类扩展库打底，也可以单独 `x.numkit.gcd(a, b)` 拿去用。
//
// 约定：
//   floorLog2(0) == 0（没有第 2^k 层就给 0，调用方自己挡 n==0）；
//   powMod 的模数 m 必须 < 2^32 —— 中间乘积 (m-1)^2 才不会溢 u64；
//   lcm 用 i64，a/gcd*b，结果溢出就是溢出（文档不装神弄鬼）。

// 最大公约数：欧几里得，负数取绝对值（i64 MIN 的 -a 溢出是 UB 级别
// 的坑，这里约定入参别传 i64 MIN——真要算先升 u64）。
pub const gcd = fn (a_in: i64, b_in: i64) i64 {
    var a = a_in;
    var b = b_in;
    if (a < 0) { a = -a; }
    if (b < 0) { b = -b; }
    while (b != 0) {
        let t = a % b;
        a = b;
        b = t;
    }
    return a;
};

// 最小公倍数：a / gcd * b 的顺序先除后乘，能多撑一步才溢。
pub const lcm = fn (a: i64, b: i64) i64 {
    if (a == 0 || b == 0) { return 0; }
    let g = gcd(a, b);
    return (a / g) * b;
};

// 模幂：平方-乘，O(log e)。m < 2^32（见文件头约定）。
pub const powMod = fn (base_in: u64, e: u64, m: u64) u64 {
    if (m == 1) { return 0; }
    var result: u64 = 1;
    var base = base_in % m;
    var exp = e;
    while (exp != 0) {
        if ((exp & 1) != 0) { result = (result * base) % m; }
        base = (base * base) % m;
        exp = exp >> 1;
    }
    return result;
};

// 整数平方根：牛顿迭代，向下取整。isqrt(n)^2 <= n < (isqrt(n)+1)^2。
// 除数过一道 let（xi）——除以 var 会撞编译期除零检查的枪口。
pub const isqrt = fn (n: u64) u64 {
    if (n < 2) { return n; }
    var x = n;
    var y = (x + 1) / 2;
    while (y < x) {
        x = y;
        let xi = x;
        y = (xi + n / xi) / 2;
    }
    return x;
};

// 下取整 log2。floorLog2(0) 约定为 0（见文件头）。
pub const floorLog2 = fn (n: usize) usize {
    var r: usize = 0;
    var v = n;
    while ((v >> 1) != 0) {
        v = v >> 1;
        r = r + 1;
    }
    return r;
};

// 大于等于 n 的最小 2 的幂。nextPow2(0) == 1。
pub const nextPow2 = fn (n: usize) usize {
    if (n <= 1) { return 1; }
    return ((usize)1 << (floorLog2(n - 1) + 1));
};

pub const isPow2 = fn (n: usize) bool {
    return n != 0 && (n & (n - 1)) == 0;
};
